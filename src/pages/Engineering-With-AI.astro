---
import AiCircuitSection from '../components/AiCircuitSection.astro';
import Button from '../components/Button.astro';
import GlassBand from '../components/GlassBand.astro';
import TalkToUsSection from '../components/TalkToUsSection.astro';
import type { StudioColour } from '../config/studio-colour';
import BaseLayout from '../layouts/BaseLayout.astro';

// What ONIXLabs commits to in each area of its AI work, one band each, laid out like the packages on /Products/DotNet.
// Read together they're the pledge the hero opens. `glass` names a glass icon in public/onixlabs/images/icons/glass, and
// `colours` runs the headline's second phrase between two of its colours.
interface Pledge {
    readonly id: string;
    readonly glass: string;
    readonly title: string;
    readonly highlight: string;
    readonly colours: readonly [StudioColour, StudioColour];
    readonly summary: string;
    readonly points: ReadonlyArray<{ readonly title: string; readonly body: string }>;
}

const pledges: ReadonlyArray<Pledge> = [
    {
        id: 'engineering',
        glass: 'code',
        title: 'Engineering',
        highlight: 'Built by professionals, faster with AI',
        colours: ['coral', 'teal'],
        summary:
            'We build with AI from design through to delivery, and it makes us faster. Speed is only worth having if what ships is right, so ' +
            'we hold what AI produces to the same standard as the code we write by hand: clean, efficient and ready to scale with your team.',
        points: [
            { title: 'Reviewed like any other code', body: 'We review what AI writes the way we review any code: an engineer reads it, understands it and stands behind it before it is merged.' },
            { title: 'Tested, not trusted', body: 'We test generated code with the same unit, integration and end-to-end tests as the rest, so its correctness is shown rather than assumed.' },
            { title: 'Built to be maintained', body: "We judge code by how easily your team can read and change it years from now, not by how quickly it was produced." },
        ],
    },
    {
        id: 'consulting',
        glass: 'user-group',
        title: 'Consulting',
        highlight: 'Deciding where AI earns its place',
        colours: ['cyan', 'green'],
        summary:
            "AI isn't the answer to every problem, and adopting it for its own sake is expensive. We help you decide where it belongs in your " +
            'product and your process, and how to adopt it in a way that serves your business goals rather than the hype around them.',
        points: [
            { title: 'The problem comes first', body: "We start from what you're trying to achieve, and recommend AI where it moves that forward." },
            { title: 'Honest about the trade-offs', body: "We're open about what AI does well, where it falls short and what it costs to run and maintain, so you can decide with your eyes open." },
            { title: 'A plan you can act on', body: 'We help you shape a practical path to adoption, sized to your team, your budget and your timeline.' },
        ],
    },
    {
        id: 'integration',
        glass: 'git-merge',
        title: 'Integration',
        highlight: 'Part of your business, not bolted on',
        colours: ['violet', 'blue'],
        summary:
            "AI delivers the most when it's part of the systems you already run. We bring it into your existing platforms, working with your " +
            "team, your tools and your tech stack, so it strengthens what you've built instead of sitting beside it.",
        points: [
            { title: 'Fits your stack', body: 'We work with the languages, platforms and pipelines you already use, rather than asking you to start again.' },
            { title: 'Alongside your team', body: "We work with your engineers, not in place of them, and hand over what we've built together so they can run and extend it." },
            { title: 'Shipped like everything else', body: 'We ship AI features through your existing review, testing and release process, alongside anything else you deploy.' },
        ],
    },
];
---
<BaseLayout
    title="Engineering with AI"
    description="How ONIXLabs uses AI across engineering, consulting and integration work, and the engineering discipline it holds that work to."
    path="/Engineering-With-AI"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Engineering with AI', path: '/Engineering-With-AI' }]}
>
    <AiCircuitSection level={1}>
        <Fragment slot="lead">
            We've embraced AI across our engineering, consulting and integration work, because it changes how much a good team can get
            done. It doesn't change what good software is, so we pair it with the engineering discipline we've always worked to.
        </Fragment>
        <Fragment slot="actions">
            <Button href="/Contact?reason=consulting" variant="primary" size="large">Talk to us about AI</Button>
        </Fragment>
    </AiCircuitSection>

    {pledges.map((pledge: Pledge, index: number) => (
        <GlassBand
            id={pledge.id}
            glass={pledge.glass}
            title={pledge.title}
            highlight={pledge.highlight}
            highlightColours={pledge.colours}
            summary={pledge.summary}
            points={pledge.points}
            alternate={index % 2 === 0}
            reversed={index % 2 === 1}
        />
    ))}

    <TalkToUsSection contactHref="/Contact?reason=consulting" />
</BaseLayout>
