---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPathsResult } from 'astro';

import { loadProducts } from '../../../collections/load-products';
import type { ProductFeature } from '../../../collections/product-feature';
import type { ProductSection } from '../../../collections/product-section';
import Button from '../../../components/Button.astro';
import CtaBand from '../../../components/CtaBand.astro';
import FeatureCard from '../../../components/FeatureCard.astro';
import PageHero from '../../../components/PageHero.astro';
import type { AuroraPalette } from '../../../components/aurora-palette';
import ProductCard from '../../../components/ProductCard.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import { site } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { buildSoftwareSourceCode } from '../../../seo/build-software-source-code';

interface Props {
    readonly product: CollectionEntry<'products'>;
    readonly siblings: ReadonlyArray<CollectionEntry<'products'>>;
}

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
    const products: ReadonlyArray<CollectionEntry<'products'>> = await loadProducts();

    return products.map((product: CollectionEntry<'products'>) => {
        const [, , family, slug]: ReadonlyArray<string | undefined> = product.data.path.split('/');
        const siblings: ReadonlyArray<CollectionEntry<'products'>> = products.filter(
            (candidate: CollectionEntry<'products'>): boolean => candidate.data.family.id === product.data.family.id && candidate.id !== product.id,
        );
        return { params: { family, product: slug }, props: { product, siblings } };
    });
}

const { product, siblings }: Props = Astro.props;
const family: CollectionEntry<'productFamilies'> = await getEntry(product.data.family);
const palettes: ReadonlyMap<string, AuroraPalette> = new Map<string, AuroraPalette>([['dotnet', 'dotnet'], ['corda', 'corda'], ['kotlin', 'kotlin']]);
const palette: AuroraPalette = palettes.get(family.id) ?? 'brand';
let featureNumber: number = 0;

function nextFeatureNumber(): number {
    featureNumber += 1;
    return featureNumber;
}
---
<BaseLayout
    title={product.data.pageTitle}
    description={product.data.description}
    path={product.data.path}
    breadcrumbs={[
        { name: 'Home', path: '/' },
        { name: 'Products', path: '/Products' },
        { name: product.data.title, path: product.data.path },
    ]}
    structuredData={[
        buildSoftwareSourceCode({
            name: product.data.title,
            description: product.data.summary,
            path: product.data.path,
            repositoryUrl: product.data.repositoryUrl,
            programmingLanguage: family.data.packageRegistry.programmingLanguage,
            image: product.data.icon,
        }, site),
    ]}
>
    <div class={`family-${family.id}`}>
        <PageHero eyebrow={`${family.data.name} · Open source`} title={product.data.title} palette={palette}>
            <p class="callout">{product.data.callout}</p>
            <p>{product.data.summary}</p>
            <Fragment slot="actions">
                <Button href={product.data.repositoryUrl} variant="primary" icon="github" external>View on GitHub</Button>
                <Button href={product.data.packagesUrl} icon="box-open" external>{product.data.packagesLabel.replace(/^View /, '')}</Button>
            </Fragment>
            <div slot="media" class="product-emblem">
                <div class="orb-ring emblem-ring" aria-hidden="true"></div>
                <div class="emblem-tile">
                    <img src={product.data.icon} alt={product.data.iconAlt} width={400} height={400} loading="eager" fetchpriority="high" decoding="async" />
                </div>
            </div>
        </PageHero>

        <section class="section" aria-labelledby="capabilities">
            <div class="container">
                <SectionHeader eyebrow="APIs at a glance" title="What's inside" id="capabilities">
                    {family.data.capabilitiesCallout}.
                </SectionHeader>

                {product.data.sections.map((section: ProductSection) => (
                    <div class="product-section">
                        {section.heading !== undefined && (
                            <div class="section-intro reveal">
                                <h3>{section.heading}</h3>
                                {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                                {section.bullets.length > 0 && (
                                    <ul class="checklist" role="list">{section.bullets.map((bullet: string) => <li>{bullet}</li>)}</ul>
                                )}
                                {section.closingParagraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                            </div>
                        )}
                        <div class="grid grid-2">
                            {section.features.map((feature: ProductFeature) => (
                                <FeatureCard title={feature.title} body={feature.body} index={nextFeatureNumber()} headingLevel={section.heading === undefined ? 'h3' : 'h4'} />
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {siblings.length > 0 && (
            <section class="section-tight" aria-labelledby="other-products">
                <div class="container">
                    <SectionHeader eyebrow={`More for ${family.data.name}`} title={family.data.otherProductsHeadline} id="other-products" />
                    <div class="grid grid-2">
                        {siblings.map((sibling: CollectionEntry<'products'>) => <ProductCard product={sibling} showOverview />)}
                    </div>
                </div>
            </section>
        )}

        <CtaBand title={`Building with ${family.data.name}?`} primaryText="Talk to the team">
            We built these libraries for our own enterprise work. If you need help adopting them, extending them, or building on top of
            them, we'd love to hear from you.
        </CtaBand>
    </div>
</BaseLayout>

<style>
    .family-dotnet { --family-from: var(--family-dotnet-from); --family-to: var(--family-dotnet-to); }
    .family-corda { --family-from: var(--family-corda-from); --family-to: var(--family-corda-to); }
    .family-kotlin { --family-from: var(--family-kotlin-from); --family-to: var(--family-kotlin-to); }

    .callout {
        color: var(--heading);
        font-family: var(--font-display);
        font-size: var(--text-2xl);
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.3;
    }

    .callout + p {
        margin-top: 1rem;
        font-size: var(--text-lg);
    }

    .product-emblem {
        position: relative;
        display: grid;
        place-items: center;
        width: min(100%, 24rem);
        aspect-ratio: 1;
    }

    .emblem-ring {
        inset: 0;
        width: 100%;
    }

    .emblem-tile {
        display: grid;
        place-items: center;
        width: 62%;
        aspect-ratio: 1;
        border-radius: 28%;
        background: linear-gradient(135deg, var(--family-from), var(--family-to));
        box-shadow:
            0 0 0 1px rgba(255, 255, 255, 0.12) inset,
            0 40px 80px -30px color-mix(in srgb, var(--family-from) 80%, transparent);
        transform: rotate(-6deg);
    }

    .emblem-tile img {
        width: 62%;
        transform: rotate(6deg);
    }

    .product-section + .product-section {
        margin-top: clamp(3rem, 2.5rem + 3vw, 5rem);
    }

    .section-intro {
        display: grid;
        gap: 1rem;
        max-width: 48rem;
        margin-bottom: 2rem;
        color: var(--text-muted);
    }

    .section-intro h3 {
        font-size: var(--text-3xl);
        letter-spacing: -0.035em;
    }

    .checklist {
        display: grid;
        gap: 0.6rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    }

    .checklist li {
        position: relative;
        padding-left: 1.6rem;
        color: var(--text);
    }

    .checklist li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--family-from), var(--family-to));
    }
</style>
