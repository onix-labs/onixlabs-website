---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPathsResult } from 'astro';

import { loadProducts } from '../../../collections/load-products';
import { splitParagraphs } from '../../../collections/split-paragraphs';
import type { ProductFeature } from '../../../collections/product-feature';
import type { ProductSection } from '../../../collections/product-section';
import Button from '../../../components/Button.astro';
import LibraryHero from '../../../components/LibraryHero.astro';
import ProductTile from '../../../components/ProductTile.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import { site } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { buildSoftwareSourceCode } from '../../../seo/build-software-source-code';

// A product in a family of libraries (/Products/DotNet/Core): a hero blooming in the family's colours, what it offers as
// an editorial list (title beside text, rows between rules), grouped where its content groups them, then the family's
// other products, with the glass icons their bands use on the family's root page.
interface Props {
    readonly product: CollectionEntry<'products'>;
    readonly siblings: ReadonlyArray<CollectionEntry<'products'>>;
}

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
    const products: ReadonlyArray<CollectionEntry<'products'>> = await loadProducts();

    return products.map((product: CollectionEntry<'products'>) => {
        const [, , family, slug]: ReadonlyArray<string | undefined> = product.data.path.split('/');
        const siblings: ReadonlyArray<CollectionEntry<'products'>> = products.filter(
            (candidate: CollectionEntry<'products'>): boolean => candidate.data.family.id === product.data.family.id && candidate.id !== product.id,
        );
        return { params: { family, product: slug }, props: { product, siblings } };
    });
}

const { product, siblings }: Props = Astro.props;
const family: CollectionEntry<'productFamilies'> = await getEntry(product.data.family);
const familyPage: CollectionEntry<'libraryPages'> | undefined = await getEntry('libraryPages', family.id);
// The family's own headline colours where it has a root page; otherwise the brand gradient.
const highlightClass: string = familyPage === undefined ? '' : `text-pair from-${familyPage.data.colours[0]} to-${familyPage.data.colours[1]}`;
type LibraryPackage = CollectionEntry<'libraryPages'>['data']['packages'][number];
let featureNumber: number = 0;

function glassFor(sibling: CollectionEntry<'products'>): string | undefined {
    return familyPage?.data.packages.find((pkg: LibraryPackage): boolean => pkg.pagePath === sibling.data.path)?.glass;
}

function nextFeatureNumber(): number {
    featureNumber += 1;
    return featureNumber;
}
---
<BaseLayout
    title={product.data.pageTitle}
    description={product.data.description}
    path={product.data.path}
    breadcrumbs={[
        { name: 'Home', path: '/' },
        { name: 'Products', path: '/Products' },
        ...(familyPage === undefined ? [] : [{ name: family.data.name, path: familyPage.data.path }]),
        { name: product.data.title, path: product.data.path },
    ]}
    structuredData={[
        buildSoftwareSourceCode({
            name: product.data.title,
            description: product.data.summary,
            path: product.data.path,
            repositoryUrl: product.data.repositoryUrl,
            programmingLanguage: family.data.packageRegistry.programmingLanguage,
            image: product.data.icon,
        }, site),
    ]}
>
    <div class={`family-${family.id}`}>
        <LibraryHero title={product.data.shortTitle} highlight={`for ${family.data.name}`} highlightClass={highlightClass} lead={product.data.lead}>
            <Fragment slot="actions">
                <Button href={product.data.repositoryUrl} variant="primary" size="large" icon="github-logo" external>View on GitHub</Button>
                <Button href={product.data.packagesUrl} variant="ghost" size="large" trailingIcon="arrow-right-bold" external>
                    Browse on {family.data.packageRegistry.name}
                </Button>
            </Fragment>
        </LibraryHero>

        <section class="section tone-alt" aria-labelledby="capabilities">
            <div class="container-wide">
                <SectionHeader title="What's" highlight="inside" id="capabilities" centered>
                    {family.data.capabilitiesCallout}.
                </SectionHeader>

                {product.data.sections.map((section: ProductSection) => (
                    <div class="product-section">
                        {section.heading !== undefined && (
                            <div class="section-intro reveal">
                                <h3>{section.heading}</h3>
                                <div class="section-intro-body">
                                    {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                                    {section.bullets.length > 0 && (
                                        <ul class="checklist" role="list">{section.bullets.map((bullet: string) => <li>{bullet}</li>)}</ul>
                                    )}
                                    {section.closingParagraphs.map((paragraph: string) => <p>{paragraph}</p>)}
                                </div>
                            </div>
                        )}
                        <div class="feature-list">
                            {section.features.map((feature: ProductFeature) => {
                                const Heading: 'h3' | 'h4' = section.heading === undefined ? 'h3' : 'h4';
                                return (
                                    <article class="feature-row reveal">
                                        <div class="feature-name">
                                            <span class="feature-index" aria-hidden="true">{String(nextFeatureNumber()).padStart(2, '0')}</span>
                                            <Heading>{feature.title}</Heading>
                                        </div>
                                        <div class="feature-body">{splitParagraphs(feature.body).map((paragraph: string) => <p>{paragraph}</p>)}</div>
                                    </article>
                                );
                            })}
                        </div>
                    </div>
                ))}
            </div>
        </section>

        {siblings.length > 0 && (
            <section class="section" aria-labelledby="other-products">
                <div class="container-wide">
                    <SectionHeader title="More for" highlight={family.data.name} highlightStyle="gradient" highlightClass={highlightClass} id="other-products" centered />
                    <div class="grid sibling-tiles">
                        {siblings.map((sibling: CollectionEntry<'products'>) => (
                            <ProductTile href={sibling.data.path} name={sibling.data.shortTitle} pitch={sibling.data.callout} icon={sibling.data.icon} glass={glassFor(sibling)} family={family.id} />
                        ))}
                    </div>
                    {familyPage !== undefined && (
                        <div class="sibling-more">
                            <Button href={familyPage.data.path} variant="ghost" trailingIcon="arrow-right-bold">All {family.data.name} libraries</Button>
                        </div>
                    )}
                </div>
            </section>
        )}
    </div>
</BaseLayout>

<style>
    .product-section + .product-section {
        margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    }

    .feature-list {
        border-bottom: 1px solid var(--border);
    }

    .feature-row {
        display: grid;
        gap: 0.75rem 4rem;
        padding-block: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
        border-top: 1px solid var(--border);
    }

    @media (min-width: 56rem) {
        .feature-row {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
        }
    }

    .feature-name {
        display: grid;
        align-content: start;
        gap: 0.4rem;
    }

    .feature-index {
        color: var(--label);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.12em;
    }

    .feature-name :is(h3, h4) {
        font-size: var(--text-2xl);
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .feature-body {
        display: grid;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: var(--text-lg);
        line-height: 1.6;
    }

    .section-intro {
        display: grid;
        gap: 1.5rem 4rem;
        margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    }

    @media (min-width: 56rem) {
        .section-intro {
            grid-template-columns: 1fr 1.4fr;
        }

        .section-intro h3 {
            position: sticky;
            top: calc(var(--header-height) + 2rem);
            align-self: start;
        }
    }

    .section-intro h3 {
        font-size: var(--text-4xl);
        letter-spacing: -0.03em;
        line-height: 1.08;
    }

    .section-intro-body {
        display: grid;
        gap: 1rem;
        color: var(--text-muted);
        font-size: var(--text-lg);
        line-height: 1.55;
    }

    .checklist {
        display: grid;
        gap: 0.6rem;
        margin-block: 0.5rem;
    }

    .checklist li {
        position: relative;
        padding-left: 1.6rem;
        color: var(--text);
    }

    .checklist li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.45em;
        width: 0.65rem;
        height: 0.65rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--family-from), var(--family-to));
    }

    .sibling-tiles {
        margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    }

    @media (min-width: 48rem) {
        .sibling-tiles {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .sibling-more {
        display: flex;
        justify-content: center;
        margin-top: 2rem;
    }
</style>
