---
import { getCollection, getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPathsResult } from 'astro';

import Button from '../../components/Button.astro';
import FamilyTile from '../../components/FamilyTile.astro';
import LibraryHero from '../../components/LibraryHero.astro';
import LibrarySection from '../../components/LibrarySection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { loadProductFamilies } from '../../collections/load-product-families';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

// The root page of a family of libraries (/Products/DotNet): a hero blooming in the family's colours, a band for each
// package and what it offers, then the other families. One page for each entry in
// src/content/library-pages.yaml.
type LibraryPage = CollectionEntry<'libraryPages'>['data'];
type Package = LibraryPage['packages'][number];

interface Props {
    readonly page: LibraryPage;
}

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
    const pages: ReadonlyArray<CollectionEntry<'libraryPages'>> = await getCollection('libraryPages');

    return pages.map((entry: CollectionEntry<'libraryPages'>) => ({
        params: { family: entry.data.path.split('/')[2] },
        props: { page: entry.data },
    }));
}

const { page }: Props = Astro.props;
const family: CollectionEntry<'productFamilies'> = await getEntry(page.family);
const otherFamilies: ReadonlyArray<CollectionEntry<'productFamilies'>> = (await loadProductFamilies())
    .filter((other: CollectionEntry<'productFamilies'>): boolean => other.id !== family.id);
const [highlightFrom, highlightTo]: readonly [string, string] = page.colours;

function docsUrlFor(pkg: Package): string {
    return pkg.docsUrl ?? `${page.docsUrl}/${pkg.docsPage ?? ''}`;
}

function registryUrlFor(pkg: Package): string {
    return pkg.registryUrl ?? page.packageUrl.replace('{package}', pkg.name);
}
---
<BaseLayout
    title={page.pageTitle}
    description={page.description}
    path={page.path}
    breadcrumbs={[
        { name: 'Home', path: '/' },
        { name: 'Products', path: '/Products' },
        { name: family.data.name, path: page.path },
    ]}
    structuredData={[
        {
            '@type': 'SoftwareSourceCode',
            '@id': `${site.url}${page.path}#software`,
            name: `ONIXLabs ${page.title}`,
            description: page.lead,
            codeRepository: page.repositoryUrl,
            programmingLanguage: family.data.packageRegistry.programmingLanguage,
            license: 'https://www.apache.org/licenses/LICENSE-2.0',
            url: `${site.url}${page.path}`,
            publisher: { '@id': `${site.url}/#organization` },
        },
    ]}
>
    <div class={`family-${family.id}`}>
        <LibraryHero title={page.title} highlight={page.highlight} highlightClass={`text-pair from-${highlightFrom} to-${highlightTo}`} lead={page.lead}>
            <Button slot="actions" href={page.packagesUrl} variant="primary" size="large" icon="package" external>Browse on {page.packageRegistry}</Button>
        </LibraryHero>

        {page.packages.map((pkg: Package, index: number) => (
            <LibrarySection
                name={pkg.name}
                glass={pkg.glass}
                title={pkg.title}
                highlight={pkg.highlight}
                summary={pkg.summary}
                details={pkg.details}
                points={pkg.points}
                pagePath={pkg.pagePath}
                docsUrl={docsUrlFor(pkg)}
                registryUrl={registryUrlFor(pkg)}
                registry={page.packageRegistry}
                alternate={index % 2 === 1}
                reversed={index % 2 === 1}
            />
        ))}

        <section class:list={['section', { 'tone-alt': page.packages.length % 2 === 1 }]} aria-labelledby="other-families">
            <div class="container-wide">
                <SectionHeader title="Libraries for" highlight="other platforms" id="other-families" centered />
                <div class="grid family-tiles">
                    {otherFamilies.map((other: CollectionEntry<'productFamilies'>) => <FamilyTile family={other} />)}
                </div>
            </div>
        </section>
    </div>
</BaseLayout>

<style>
    .family-tiles {
        margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    }

    @media (min-width: 48rem) {
        .family-tiles {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
