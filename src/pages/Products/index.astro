---
import type { CollectionEntry } from 'astro:content';

import { loadProductFamilies } from '../../collections/load-product-families';
import { loadProducts } from '../../collections/load-products';
import AeroShowcase from '../../components/AeroShowcase.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import ProductCard from '../../components/ProductCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const families: ReadonlyArray<CollectionEntry<'productFamilies'>> = await loadProductFamilies();
const products: ReadonlyArray<CollectionEntry<'products'>> = await loadProducts();

function productsIn(family: CollectionEntry<'productFamilies'>): ReadonlyArray<CollectionEntry<'products'>> {
    return products.filter((product: CollectionEntry<'products'>): boolean => product.data.family.id === family.id);
}
---
<BaseLayout
    title="Products"
    description="Platforms, libraries and frameworks from ONIXLabs: the Aero .NET suite plus open-source libraries for .NET, Corda and Kotlin."
    path="/Products"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Products', path: '/Products' }]}
>
    <PageHero eyebrow="Products" title="Software," highlight="supercharged." centered>
        We build powerful platforms, libraries, and frameworks that accelerate development and elevate engineering workflows.
        Whether you're prototyping quickly, building complex systems, or scaling cleanly, our tools help you write better code with
        confidence.
        <Fragment slot="actions">
            <Button href="#aero" variant="primary" arrow>Aero platform</Button>
            <Button href="#dotnet">Open-source libraries</Button>
        </Fragment>
    </PageHero>

    <section class="section-tight" id="aero" aria-labelledby="aero-title">
        <div class="container">
            <div class="aero-feature gradient-border reveal">
                <div class="aero-feature-copy">
                    <p class="eyebrow">Platform</p>
                    <h2 id="aero-title">Introducing <span class="gradient-text">Aero</span></h2>
                    <p class="lead">
                        <strong>A modular suite of .NET APIs designed for fast, scalable, enterprise engineering.</strong>{' '}
                        It helps teams ship quickly, scale confidently, and modernize everything from cloud-native apps to legacy systems.
                    </p>
                    <div class="cluster">
                        <Button href="/Products/Aero" variant="primary" arrow>Find out more</Button>
                        <Button href="/Contact?reason=aero-demo">Request a demo</Button>
                    </div>
                </div>
                <AeroShowcase eager />
            </div>
        </div>
    </section>

    {families.map((family: CollectionEntry<'productFamilies'>) => (
        <section class="section-tight family" id={family.id} aria-labelledby={`family-${family.id}`}>
            <div class="container">
                <SectionHeader eyebrow={`Products for ${family.data.name}`} title={family.data.callout} id={`family-${family.id}`}>
                    {family.data.introduction}
                </SectionHeader>
                <div class="grid grid-3">
                    {productsIn(family).map((product: CollectionEntry<'products'>) => <ProductCard product={product} showOverview />)}
                </div>
            </div>
        </section>
    ))}

    <CtaBand title="Not sure which product fits?" primaryText="Ask us">
        Tell us what you're building and we'll point you to the right platform or library, or help you build it.
    </CtaBand>
</BaseLayout>

<style>
    .aero-feature {
        display: grid;
        gap: clamp(2rem, 1.5rem + 3vw, 4rem);
        align-items: center;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
        padding: clamp(1.75rem, 1.25rem + 3vw, 4rem);
        border-radius: var(--radius-xl);
        background:
            radial-gradient(ellipse 70% 90% at 90% 40%, color-mix(in srgb, var(--brand-rose) calc(var(--glow-strength) * 22%), transparent), transparent),
            var(--surface);
        overflow: hidden;
    }

    .aero-feature-copy {
        display: grid;
        gap: 1.4rem;
        justify-items: start;
    }

    .family {
        scroll-margin-top: var(--header-height);
    }
</style>
