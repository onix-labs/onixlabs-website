---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import AeroShowcase from '../../components/AeroShowcase.astro';
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

type AeroData = CollectionEntry<'aero'>['data'];

const entry: CollectionEntry<'aero'> | undefined = await getEntry('aero', 'aero');

if (entry === undefined) {
    throw new Error('src/content/aero.yaml must define an `aero` entry.');
}

const aero: AeroData = entry.data;
---
<BaseLayout
    title="Aero: The Modular .NET Suite for Enterprise Engineering"
    description="Aero is a modular suite of .NET APIs for fast, scalable enterprise engineering: logging, configuration, data access, secrets, signing and ledgers."
    path="/Products/Aero"
    breadcrumbs={[
        { name: 'Home', path: '/' },
        { name: 'Products', path: '/Products' },
        { name: 'Aero', path: '/Products/Aero' },
    ]}
    structuredData={[
        {
            '@type': 'SoftwareApplication',
            '@id': `${site.url}/Products/Aero#software`,
            name: 'Aero',
            applicationCategory: 'DeveloperApplication',
            operatingSystem: '.NET',
            description: 'A modular suite of .NET APIs designed for fast, scalable, enterprise engineering.',
            url: `${site.url}/Products/Aero`,
            publisher: { '@id': `${site.url}/#organization` },
        },
    ]}
>
    <PageHero eyebrow="Aero platform" title="The modular .NET suite for" highlight="enterprise engineering." palette="aero">
        <strong>Aero is a modular suite of .NET APIs designed for fast, scalable, enterprise engineering.</strong>{' '}
        It helps teams ship quickly, scale confidently, and modernize everything from cloud-native apps to legacy systems.
        <Fragment slot="actions">
            <Button href="/Contact?reason=aero-demo" variant="primary" size="large" arrow>Request a demo</Button>
            <Button href="#aero-architecture" size="large">Explore the architecture</Button>
        </Fragment>
        <div slot="media" class="aero-media">
            <img class="aero-wordmark aero-wordmark-light" src="/onixlabs/images/logo/aero-dark.webp" alt="" width={1280} height={640} loading="eager" />
            <img class="aero-wordmark aero-wordmark-dark" src="/onixlabs/images/logo/aero-light.webp" alt="" width={1280} height={640} loading="eager" />
            <AeroShowcase eager />
        </div>
    </PageHero>

    <section class="section" aria-labelledby="founding-principles">
        <div class="container">
            <SectionHeader eyebrow="Founding principles" title="Why build .NET applications" highlight="with Aero." id="founding-principles">
                Aero provides a rock-solid foundation for building modern .NET applications. Designed with flexibility and scalability in
                mind, it helps teams move faster, adopt best practices by default, and build applications that are robust, maintainable,
                and ready for growth.
            </SectionHeader>
            <div class="grid grid-3">
                {aero.principles.map((principle: AeroData['principles'][number]) => (
                    <FeatureCard title={principle.title} icon={principle.icon} body={principle.body} />
                ))}
            </div>
        </div>
    </section>

    <section class="section architecture" id="aero-architecture" aria-labelledby="aero-architecture-title">
        <div class="container">
            <SectionHeader eyebrow="Aero architecture" title="The building blocks for enterprise-grade" highlight=".NET applications." id="aero-architecture-title">
                Aero isn’t just another framework—it's your project's backbone. From APIs to infrastructure, each module is crafted to
                solve real-world engineering challenges with clarity, performance, and security in mind.
            </SectionHeader>
            <div class="grid grid-2">
                {aero.architecture.map((module: AeroData['architecture'][number], index: number) => (
                    <FeatureCard title={module.title} body={module.body} index={index + 1} />
                ))}
            </div>
            <p class="lead closing reveal">
                Aero gives you more than just utilities—it gives you architecture. With thoughtfully designed APIs, production-ready
                integrations, and deep flexibility across every layer of the stack, Aero equips .NET teams to deliver faster, scale
                confidently, and stay maintainable from day one. <strong>This is modern enterprise development, without the drag.</strong>
            </p>
        </div>
    </section>

    <CtaBand title="See Aero in action." primaryText="Request a demo" primaryHref="/Contact?reason=aero-demo">
        Whether you're evaluating it for your next project or just want a deeper look under the hood, book a product or technical demo
        for a guided tour, real-world use cases, and answers tailored to your team’s needs.
    </CtaBand>
</BaseLayout>

<style>
    .aero-media {
        display: grid;
        gap: 1.5rem;
        justify-items: center;
        width: 100%;
    }

    .aero-wordmark {
        width: min(60%, 18rem);
        height: auto;
    }

    :global([data-theme='light']) .aero-wordmark-dark,
    :global([data-theme='dark']) .aero-wordmark-light {
        display: none;
    }

    .architecture {
        border-top: 1px solid var(--border);
        background: var(--bg-elevated);
    }

    .closing {
        max-width: 52rem;
        margin: clamp(3rem, 2.5rem + 2vw, 4.5rem) auto 0;
        text-align: center;
    }
</style>
