---
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import { splitParagraphs } from '../../collections/split-paragraphs';
import Button from '../../components/Button.astro';
import GlassAura from '../../components/GlassAura.astro';
import LibraryHero from '../../components/LibraryHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TalkToUsSection from '../../components/TalkToUsSection.astro';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Aero: a hero blooming in the whole brand spectrum, what Aero is with its wordmark and the principles behind it as glowing
// glass icons (like the services on /Consulting), its architecture as an editorial list (title beside text, rows between rules), then an invitation to talk.
type AeroData = CollectionEntry<'aero'>['data'];
type Principle = AeroData['principles'][number];
type Module = AeroData['architecture'][number];

const entry: CollectionEntry<'aero'> | undefined = await getEntry('aero', 'aero');

if (entry === undefined) {
    throw new Error('src/content/aero.yaml must define an `aero` entry.');
}

const aero: AeroData = entry.data;
---
<BaseLayout
    title="Aero: The Modular .NET Suite for Enterprise Engineering"
    description="Aero is a modular suite of .NET APIs for fast, scalable enterprise engineering: logging, configuration, data access, secrets, signing and ledgers."
    path="/Products/Aero"
    breadcrumbs={[
        { name: 'Home', path: '/' },
        { name: 'Products', path: '/Products' },
        { name: 'Aero', path: '/Products/Aero' },
    ]}
    structuredData={[
        {
            '@type': 'SoftwareApplication',
            '@id': `${site.url}/Products/Aero#software`,
            name: 'Aero',
            applicationCategory: 'DeveloperApplication',
            operatingSystem: '.NET',
            description: 'A modular suite of .NET APIs designed for fast, scalable, enterprise engineering.',
            url: `${site.url}/Products/Aero`,
            publisher: { '@id': `${site.url}/#organization` },
        },
    ]}
>
    <div class="family-aero">
        <LibraryHero
            title="ONIXLabs Aero"
            highlight="Enterprise stack for .NET"
            spectrum
            lead="A modular suite of .NET APIs designed for fast, scalable, enterprise engineering. It helps teams ship quickly, scale confidently, and modernise existing .NET systems or build new cloud-native ones."
        >
            <Fragment slot="actions">
                <Button href="/Contact?reason=aero-demo" variant="primary" size="large">Request a demo</Button>
                <Button href="#aero-architecture" variant="ghost" size="large" trailingIcon="arrow-right-bold">Explore the architecture</Button>
            </Fragment>
        </LibraryHero>
    </div>

    <section class="section tone-alt" aria-labelledby="enterprise-engineering">
        <div class="container-wide">
            <SectionHeader title="Enterprise engineering" highlight="without the drag" highlightStyle="gradient" id="enterprise-engineering" centered>
                Aero is the backbone of your project: thoughtfully designed modules, from APIs to infrastructure, that let .NET teams move
                faster and build software that's robust, maintainable and ready to grow.
            </SectionHeader>
            <div class="aero-logo zoom-arrive">
                <img class="aero-wordmark aero-wordmark-light" src="/onixlabs/images/logo/aero-dark.webp" alt="Aero" width={1280} height={640} />
                <img class="aero-wordmark aero-wordmark-dark" src="/onixlabs/images/logo/aero-light.webp" alt="Aero" width={1280} height={640} />
            </div>
            <ul class="grid principles" role="list">
                {aero.principles.map((principle: Principle) => (
                    <li class="principle reveal-scale">
                        <GlassAura name={principle.glass} class="principle-icon" />
                        <h3>{principle.title}</h3>
                        <p>{principle.body}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section" id="aero-architecture" aria-labelledby="aero-architecture-title">
        <div class="container-wide">
            <SectionHeader
                eyebrow="Aero architecture"
                title="What's"
                highlight="inside"
                id="aero-architecture-title"
                centered
            >
                Discover the modules that give .NET applications an enterprise-grade foundation.
            </SectionHeader>
            <div class="module-list">
                {aero.architecture.map((module: Module, index: number) => (
                    <article class="module-row reveal">
                        <div class="module-name">
                            <span class="module-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                            <h3>{module.title}</h3>
                        </div>
                        <div class="module-body">{splitParagraphs(module.body).map((paragraph: string) => <p>{paragraph}</p>)}</div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <TalkToUsSection contactHref="/Contact?reason=aero-demo" alternate />
</BaseLayout>

<style>
    /* The wordmark sits centred under the standfirst, introducing the principles below it. */
    .aero-logo {
        display: grid;
        place-items: center;
        margin-bottom: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    }

    /* Its file names describe the lettering: aero-dark has dark lettering for the light theme, aero-light light
       lettering for the dark. */
    .aero-wordmark {
        width: min(100%, 26rem);
        height: auto;
    }

    :global([data-theme='light']) .aero-wordmark-dark,
    :global([data-theme='dark']) .aero-wordmark-light {
        display: none;
    }

    /* No tiles: like the services on /Consulting, each principle is a large glass icon with its own colour blurred behind
       it. One stacking context for the list keeps the glows behind all the text. */
    .principles {
        row-gap: clamp(3rem, 2.5rem + 2vw, 4.5rem);
        isolation: isolate;
    }

    @media (min-width: 48rem) {
        .principles {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 72rem) {
        .principles {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    .principle {
        display: grid;
        align-content: start;
        justify-items: center;
        gap: 0.75rem;
        text-align: center;
    }

    .principle :global(.principle-icon) {
        --aura-scale: 1.4;
        width: 11rem;
        margin-bottom: 1rem;
    }

    .principle h3 {
        font-size: var(--text-xl);
    }

    /* The full text colour rather than the muted one: this sits close to the colour spilling from the icon. */
    .principle p {
        max-width: 24rem;
        margin: 0;
        color: var(--text);
    }

    .module-row {
        display: grid;
        gap: 0.75rem 4rem;
        padding-block: clamp(1.5rem, 1.2rem + 1vw, 2.25rem);
    }

    /* Rules between the rows only, not above the first or below the last. */
    .module-row + .module-row {
        border-top: 1px solid var(--border);
    }

    @media (min-width: 56rem) {
        .module-row {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
        }
    }

    .module-name {
        display: grid;
        align-content: start;
        gap: 0.4rem;
    }

    .module-index {
        color: var(--label);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.12em;
    }

    .module-name h3 {
        font-size: var(--text-2xl);
        letter-spacing: -0.02em;
        line-height: 1.2;
    }

    .module-body {
        display: grid;
        gap: 0.75rem;
        color: var(--text-muted);
        font-size: var(--text-lg);
        line-height: 1.6;
    }
</style>
