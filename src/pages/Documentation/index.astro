---
import type { CollectionEntry } from 'astro:content';

import { loadArticles } from '../../collections/load-articles';
import Icon from '../../components/Icon.astro';
import { documentationCategories } from '../../config/documentation-categories';
import type { DocumentationCategory } from '../../config/documentation-category';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';

const articles: ReadonlyArray<CollectionEntry<'articles'>> = await loadArticles();

function articlesIn(category: DocumentationCategory): ReadonlyArray<CollectionEntry<'articles'>> {
    return articles.filter((article: CollectionEntry<'articles'>): boolean => article.data.category === category.id);
}
---
<DocumentationLayout
    title="Documentation"
    description="Technical articles, product blogs and API references from ONIXLabs, covering Aero, C#, Corda and number theory for enterprise software engineers."
    path="/Documentation"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Documentation', path: '/Documentation' }]}
>
    <header class="docs-intro">
        <p class="eyebrow-small">Articles · API docs · Blog posts</p>
        <h1>Documentation</h1>
        <p class="lead">
            Explore our official documentation. From technical articles and product blogs to in-depth API references, everything's
            written, organized, and maintained to give you clear, consistent answers, fast.
        </p>
    </header>

    {documentationCategories.map((category: DocumentationCategory) => (
        <section class="docs-group" aria-labelledby={`category-${category.id}`}>
            <h2 id={`category-${category.id}`}>{category.name}</h2>
            <div class="grid grid-2">
                {articlesIn(category).map((article: CollectionEntry<'articles'>) => (
                    <a class="tile article-card reveal-scale" href={article.data.path}>
                        <h3>{article.data.title}</h3>
                        <p>{article.data.description}</p>
                        <span class="link-cta article-link">Read article <Icon name="chevron-right" /></span>
                    </a>
                ))}
            </div>
        </section>
    ))}
</DocumentationLayout>

<style>
    .docs-intro {
        display: grid;
        gap: 1rem;
        max-width: 44rem;
        margin-bottom: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    }

    .docs-intro h1 {
        font-size: var(--text-hero);
        letter-spacing: -0.038em;
        line-height: 1;
    }

    .docs-group + .docs-group {
        margin-top: clamp(3rem, 2.5rem + 2vw, 4.5rem);
    }

    .docs-group h2 {
        margin-bottom: 1.25rem;
        font-size: var(--text-3xl);
    }

    .article-card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        height: 100%;
        padding: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    }

    .article-card h3 {
        font-size: var(--text-xl);
    }

    .article-card p {
        color: var(--text-muted);
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    .article-link {
        margin-top: auto;
        padding-top: 0.5rem;
        font-size: var(--text-base);
    }
</style>
