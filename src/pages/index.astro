---
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// A blank canvas: the new home page will be designed here from the design language (/design in the dev server).
// The previous site lives under /archive. Not indexed while it's empty.
---
<BaseLayout title={site.name} description={site.description} path="/" noindex>
    <h1 class="visually-hidden">{site.name}</h1>
</BaseLayout>
