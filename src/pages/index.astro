---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import { loadContributors } from '../collections/load-contributors';
import { loadProductFamilies } from '../collections/load-product-families';
import { loadProducts } from '../collections/load-products';
import AeroShowcase from '../components/AeroShowcase.astro';
import Aurora from '../components/Aurora.astro';
import Button from '../components/Button.astro';
import ContributorCard from '../components/ContributorCard.astro';
import CtaBand from '../components/CtaBand.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TechnologyMarquee from '../components/TechnologyMarquee.astro';
import type { Principle } from '../config/principle';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const principles: ReadonlyArray<Principle> = [
    { title: 'Craftsmanship', icon: 'pen-ruler', body: 'We treat code as a craft, writing software with precision, care, and pride in every detail.' },
    { title: 'Integrity', icon: 'shield-halved', body: 'We uphold transparency, honesty, and reliability in every decision, from code to client collaboration.' },
    { title: 'Performance', icon: 'gauge-high', body: 'We engineer solutions that are not only functional but fast, efficient, and built to scale.' },
    { title: 'Enterprise', icon: 'building', body: 'Our platforms are designed for the complexity and demands of modern enterprises. Secure, scalable, and future-ready.' },
    { title: 'Community', icon: 'users', body: 'We thrive on collaboration, contributing to open-source and growing together with the global developer community.' },
    { title: 'Simplicity', icon: 'leaf', body: 'We believe the best solutions are intuitive, removing complexity to let clarity and function shine.' },
    { title: 'Education', icon: 'graduation-cap', body: 'We foster a culture of continuous learning, sharing knowledge, mentoring talent, and staying ahead of the curve.' },
    { title: 'Support', icon: 'life-ring', body: 'We stand by our software and our users, delivering responsive, reliable support that builds long-term trust.' },
];

const technologies: ReadonlyArray<CollectionEntry<'technologies'>> = (await getCollection('technologies')).toSorted(
    (left: CollectionEntry<'technologies'>, right: CollectionEntry<'technologies'>): number => left.id.localeCompare(right.id),
);
const contributors: ReadonlyArray<CollectionEntry<'contributors'>> = await loadContributors();
const families: ReadonlyArray<CollectionEntry<'productFamilies'>> = await loadProductFamilies();
const products: ReadonlyArray<CollectionEntry<'products'>> = await loadProducts();

function productsIn(family: CollectionEntry<'productFamilies'>): ReadonlyArray<CollectionEntry<'products'>> {
    return products.filter((product: CollectionEntry<'products'>): boolean => product.data.family.id === family.id);
}
---
<BaseLayout title="ONIXLabs | Enterprise Software Engineering for .NET, Kotlin & Corda" description={site.description} path="/">
    <section class="hero">
        <Aurora />
        <div class="orb-ring hero-ring" aria-hidden="true"></div>
        <div class="container hero-inner">
            <a class="pill rise" href="/Products/Aero">
                <span class="pill-tag">New</span>
                Introducing Aero<span class="pill-detail">, the modular .NET suite</span>
                <Icon name="arrow-right" />
            </a>
            <h1 class="hero-title rise rise-2">
                Code that connects.
                <span class="gradient-text">Software that scales.</span>
            </h1>
            <p class="lead hero-lead rise rise-3">
                At ONIXLabs, we enhance the software development journey through a relentless focus on quality, crafting robust and
                scalable enterprise solutions that empower innovation and growth.
            </p>
            <div class="cluster hero-actions rise rise-4">
                <Button href="/Products/" variant="primary" size="large" arrow>Explore our products</Button>
                <Button href="/Consulting" size="large">Work with us</Button>
            </div>
            <ul class="hero-platforms rise rise-4" role="list" aria-label="Platforms we specialise in">
                <li>C#</li>
                <li>.NET</li>
                <li>Kotlin</li>
                <li>Java &amp; the JVM</li>
                <li>Corda</li>
            </ul>
        </div>
    </section>

    <section class="section aero" aria-labelledby="introducing-aero">
        <div class="container aero-grid">
            <div class="aero-copy reveal">
                <p class="eyebrow">Aero platform</p>
                <h2 id="introducing-aero">Introducing <span class="gradient-text">Aero</span></h2>
                <p class="lead">
                    <strong>A modular suite of .NET APIs designed for fast, scalable, enterprise engineering.</strong>{' '}
                    It helps teams ship quickly, scale confidently, and modernize everything from cloud-native apps to legacy systems.
                </p>
                <ul class="aero-points" role="list">
                    <li><Icon name="rocket" /> Blazing fast</li>
                    <li><Icon name="layer-group" /> Infinitely scalable</li>
                    <li><Icon name="building" /> Built for enterprise</li>
                </ul>
                <div class="cluster">
                    <Button href="/Products/Aero" variant="primary" arrow>Discover Aero</Button>
                    <Button href="/Contact?reason=aero-demo">Request a demo</Button>
                </div>
            </div>
            <div class="reveal">
                <AeroShowcase />
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="principles">
        <div class="container">
            <SectionHeader eyebrow="Powering possibility" title="Principles behind" highlight="every line we ship." id="principles">
                We enhance the software development journey through a relentless focus on quality, crafting robust and scalable
                enterprise solutions.
            </SectionHeader>
            <div class="grid grid-4">
                {principles.map((principle: Principle) => <FeatureCard title={principle.title} icon={principle.icon} body={principle.body} />)}
            </div>
        </div>
    </section>

    <section class="section families" aria-labelledby="open-source">
        <div class="container">
            <SectionHeader eyebrow="Open source" title="Libraries for the platforms" highlight="you build on." id="open-source">
                Focused, well-engineered libraries that extend .NET, Corda and Kotlin, developed in the open on GitHub.
            </SectionHeader>
            <div class="grid grid-3">
                {families.map((family: CollectionEntry<'productFamilies'>) => (
                    <a class={`card family-card family-${family.id} reveal`} href={`/Products/#${family.id}`}>
                        <p class="family-name">{family.data.name}</p>
                        <h3>{family.data.callout}</h3>
                        <ul class="family-products" role="list">
                            {productsIn(family).map((product: CollectionEntry<'products'>) => (
                                <li>
                                    <img src={product.data.icon} alt="" width={24} height={24} loading="lazy" decoding="async" />
                                    {product.data.shortTitle}
                                </li>
                            ))}
                        </ul>
                        <span class="family-link">View {family.data.name} libraries <Icon name="arrow-right" /></span>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="section technologies" aria-labelledby="tools-that-fit">
        <div class="container">
            <SectionHeader eyebrow="Purpose over preference" title="Tools that fit," highlight="built to last." id="tools-that-fit" centered>
                We don't believe that one size fits all. We choose the right tools for the job, not just the ones we know. If we're not the
                best fit, we'll learn fast or help connect you with those who are.
            </SectionHeader>
        </div>
        <TechnologyMarquee technologies={technologies} />
    </section>

    <section class="section" aria-labelledby="champions-of-contribution">
        <div class="container">
            <SectionHeader eyebrow="Our people" title="Champions of" highlight="contribution." id="champions-of-contribution">
                We believe great software is a shared effort. We contribute to the tools we use, collaborate with the community, and
                champion open-source innovation wherever we can.
            </SectionHeader>
            <div class="grid grid-4">
                {contributors.map((contributor: CollectionEntry<'contributors'>) => <ContributorCard contributor={contributor} />)}
            </div>
        </div>
    </section>

    <CtaBand />
</BaseLayout>

<style>
    .hero {
        position: relative;
        isolation: isolate;
        display: grid;
        align-items: center;
        min-height: min(56rem, 100svh);
        padding-block: calc(var(--header-height) + 4rem) 5rem;
        overflow: hidden;
        text-align: center;
    }

    .hero-ring {
        top: 50%;
        left: 50%;
        z-index: -1;
        width: min(92vw, 52rem);
        opacity: 0.22;
        translate: -50% -42%;
    }

    .hero-inner {
        display: grid;
        justify-items: center;
        gap: 1.75rem;
    }

    @media (max-width: 30rem) {
        .pill-detail {
            display: none;
        }
    }

    .hero-title {
        max-width: 20ch;
        font-size: clamp(3rem, 1.6rem + 6.4vw, 6.25rem);
    }

    .hero-title .gradient-text {
        display: block;
        padding-bottom: 0.08em;
    }

    .hero-lead {
        max-width: 42rem;
    }

    .hero-actions {
        justify-content: center;
    }

    .hero-platforms {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        row-gap: 0.5rem;
        margin-top: 2.5rem;
        color: var(--text-subtle);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .hero-platforms li {
        display: flex;
        align-items: center;
    }

    .hero-platforms li + li::before {
        content: '';
        width: 4px;
        height: 4px;
        margin-inline: 1.1rem;
        border-radius: 50%;
        background: var(--brand-gradient);
    }

    .aero {
        border-block: 1px solid var(--border);
        background:
            radial-gradient(ellipse 60% 80% at 85% 50%, color-mix(in srgb, var(--brand-rose) calc(var(--glow-strength) * 18%), transparent), transparent),
            var(--bg-elevated);
    }

    .aero-grid {
        display: grid;
        gap: clamp(3rem, 2rem + 4vw, 5rem);
        align-items: center;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    }

    .aero-copy {
        display: grid;
        gap: 1.5rem;
        justify-items: start;
    }

    .aero-points {
        display: grid;
        gap: 0.75rem;
    }

    .aero-points li {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--heading);
        font-weight: 500;
    }

    .aero-points :global(.icon) {
        color: var(--brand-rose);
    }

    .family-card {
        --family-from: var(--brand-violet);
        --family-to: var(--brand-blue);
        --spot-color: var(--family-from);
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-height: 22rem;
        padding: 2rem;
        color: inherit;
        text-decoration: none;
        background:
            radial-gradient(ellipse 120% 70% at 100% 0%, color-mix(in srgb, var(--family-from) calc(var(--glow-strength) * 32%), transparent), transparent 70%),
            var(--surface);
    }

    .family-dotnet { --family-from: var(--family-dotnet-from); --family-to: var(--family-dotnet-to); }
    .family-corda { --family-from: var(--family-corda-from); --family-to: var(--family-corda-to); }
    .family-kotlin { --family-from: var(--family-kotlin-from); --family-to: var(--family-kotlin-to); }

    .family-name {
        font-family: var(--font-display);
        font-size: var(--text-4xl);
        font-weight: 600;
        letter-spacing: -0.05em;
        line-height: 1;
        background: linear-gradient(90deg, var(--family-from), var(--family-to));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        justify-self: start;
    }

    .family-card h3 {
        font-size: var(--text-lg);
    }

    .family-products {
        display: grid;
        gap: 0.6rem;
        margin-top: 0.5rem;
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    .family-products li {
        display: flex;
        align-items: center;
        gap: 0.7rem;
    }

    .family-products img {
        width: 1.6rem;
        height: 1.6rem;
        padding: 0.25rem;
        border-radius: 0.45rem;
        background: linear-gradient(135deg, var(--family-from), var(--family-to));
    }

    .family-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: auto;
        color: var(--heading);
        font-size: var(--text-sm);
        font-weight: 600;
    }

    .family-link :global(.icon) {
        transition: transform var(--duration) var(--ease-out);
    }

    .family-card:hover .family-link :global(.icon) {
        transform: translateX(4px);
    }

    .technologies {
        overflow: hidden;
    }
</style>
