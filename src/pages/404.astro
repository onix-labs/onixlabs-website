---
import Aurora from '../components/Aurora.astro';
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found" description="The page you were looking for doesn't exist on the ONIXLabs website. Head back to the home page to keep exploring." path="/404" noindex>
    <section class="not-found">
        <Aurora />
        <div class="container not-found-inner">
            <p class="code gradient-text rise" aria-hidden="true">404</p>
            <h1 class="rise rise-2">Yikes! Pretend you didn't see this.</h1>
            <p class="lead rise rise-3">
                You’ve reached a page that doesn’t exist. It’s kind of like Narnia, but with fewer talking animals and more disappointment.
                Unless of course, you were looking for a whole lot of nothing, in which case… jackpot!
            </p>
            <div class="cluster rise rise-4">
                <Button href="/" variant="primary" size="large" arrow>Begin a new adventure</Button>
                <Button href="/Documentation/" size="large">Browse the docs</Button>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .not-found {
        position: relative;
        isolation: isolate;
        display: grid;
        align-items: center;
        min-height: 85svh;
        padding-block: calc(var(--header-height) + 3rem) 5rem;
        overflow: hidden;
        text-align: center;
    }

    .not-found-inner {
        display: grid;
        justify-items: center;
        gap: 1.5rem;
    }

    .code {
        font-family: var(--font-display);
        font-size: clamp(7rem, 4rem + 14vw, 14rem);
        font-weight: 600;
        letter-spacing: -0.07em;
        line-height: 0.9;
    }

    h1 {
        max-width: 18ch;
        font-size: var(--text-4xl);
    }

    .lead {
        max-width: 40rem;
    }

    .cluster {
        justify-content: center;
        margin-top: 0.5rem;
    }
</style>
