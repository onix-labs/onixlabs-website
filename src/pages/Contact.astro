---
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import LibraryHero from '../components/LibraryHero.astro';
import { site } from '../config/site';
import type { SocialLink } from '../config/social-link';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contactReasons } from '../scripts/contact-reasons';

// Contact: a hero blooming in the whole brand spectrum, then the form in a raised tile beside the other ways to reach us,
// as rows between rules. Links across the site prefill the form with ?reason= (src/scripts/contact-reasons.ts); the
// form works without JavaScript and posts to Formspree.
// The first reason is selected until a visitor, or a ?reason= link, chooses another.
const reasons: ReadonlyArray<string> = [
    'General enquiry',
    'Consultation',
    'ONIXLabs Studio',
    'ONIXLabs Aero',
    '.NET Libraries',
    'Kotlin Libraries',
    'Corda Libraries',
    'Something else',
];
const followLinks: ReadonlyArray<SocialLink> = site.socialLinks.filter((link: SocialLink): boolean => link.isInFooter);

for (const prefill of contactReasons.values()) {
    if (!reasons.includes(prefill.reason)) {
        throw new Error(`Contact prefill reason "${prefill.reason}" isn't one of the form's options.`);
    }
}
---
<BaseLayout
    title="Contact"
    description="Contact ONIXLabs about Aero, ONIXLabs Studio, our open-source libraries or consulting. Send a message, email us or book a meeting."
    path="/Contact"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/Contact' }]}
    structuredData={[{ '@type': 'ContactPage', name: 'Contact ONIXLabs', url: `${site.url}/Contact`, about: { '@id': `${site.url}/#organization` } }]}
>
    <LibraryHero
        title="Start the conversation"
        highlight="We'll take it from there"
        spectrum
        lead="Whether you're exploring our products, thinking about consulting, or just want to talk through an idea, we'd be glad to help you find the right solution."
    >
        <Fragment slot="actions">
            <Button href="#contact-form" variant="primary" size="large">Send a message</Button>
            <Button href={site.calendlyUrl} variant="ghost" size="large" trailingIcon="arrow-right-bold" external>Book a meeting</Button>
        </Fragment>
    </LibraryHero>

    <section class="section tone-alt" aria-label="Ways to get in touch">
        <div class="container-wide contact-layout">
            <div class="tile form-card reveal-scale" id="contact-form">
                <h2 id="contact-form-title">Send us a message</h2>
                <form action={site.contactFormEndpoint} method="post" aria-labelledby="contact-form-title">
                    <div class="form-row">
                        <div class="field">
                            <label for="name">Name</label>
                            <input class="input" type="text" name="name" id="name" autocomplete="name" required />
                        </div>
                        <div class="field">
                            <label for="email">Email address</label>
                            <input class="input" type="email" name="email" id="email" autocomplete="email" required />
                        </div>
                    </div>

                    <div class="field">
                        <label for="reason">Reason</label>
                        <select class="input" name="reason" id="reason" required>
                            {reasons.map((reason: string, index: number) => <option selected={index === 0}>{reason}</option>)}
                        </select>
                    </div>

                    <div class="field">
                        <label for="message">Message</label>
                        <textarea class="input" name="message" id="message" rows="7" required></textarea>
                    </div>

                    <!-- Formspree's honeypot: real visitors never see or fill this field. -->
                    <div class="honeypot" aria-hidden="true">
                        <label for="gotcha">Leave this field empty</label>
                        <input type="text" name="_gotcha" id="gotcha" tabindex="-1" autocomplete="off" />
                    </div>

                    <button type="submit" class="button button-primary button-large">
                        <span>Send message</span>
                    </button>
                </form>
            </div>

            <ul class="channels" role="list">
                <li class="channel reveal">
                    <h2 class="channel-title"><span class="icon-chip"><Icon name="calendar-blank" /></span>Book a meeting</h2>
                    <p>Pick a time that suits you, with no back-and-forth. Whether it's a quick chat or a deep dive, we're here when you're ready.</p>
                    <Button href={site.calendlyUrl} external>Book a Meeting</Button>
                </li>
                <li class="channel reveal">
                    <h2 class="channel-title"><span class="icon-chip"><Icon name="envelope-simple" /></span>Email us</h2>
                    <p>Prefer to write? Email us directly, and we'll get back to you.</p>
                    <a class="link-cta" href={`mailto:${site.company.email}`}>{site.company.email}</a>
                </li>
                <li class="channel reveal">
                    <h2 class="channel-title"><span class="icon-chip"><Icon name="users-three" /></span>Follow along</h2>
                    <p>News, product updates and insights from the team.</p>
                    <ul class="socials" role="list">
                        {followLinks.map((link: SocialLink) => (
                            <li>
                                <a href={link.url} target="_blank" rel="noopener noreferrer">
                                    <Icon name={link.icon} />
                                    <span>{link.name}</span>
                                    <span class="visually-hidden"> (opens in a new tab)</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </li>
            </ul>
        </div>
    </section>
</BaseLayout>

<script>
    import '../scripts/contact';
</script>

<style>
    /* The form beside the other ways to reach us, 60/40; they stack below 62rem, form first. */
    .contact-layout {
        display: grid;
        gap: 3rem 5rem;
        align-items: start;
    }

    @media (min-width: 62rem) {
        .contact-layout {
            grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
        }
    }

    #contact-form {
        scroll-margin-top: calc(var(--header-height) + 1.5rem);
    }

    .form-card {
        display: grid;
        gap: 2rem;
        padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
        box-shadow: var(--shadow-tile);
    }

    .form-card h2 {
        font-size: var(--text-4xl);
    }

    form {
        display: grid;
        gap: 1.25rem;
    }

    .form-row {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    }

    form .button {
        justify-self: end;
        margin-top: 0.5rem;
    }

    .honeypot {
        display: none;
    }

    /* The other ways to reach us: rows with rules between them, like the areas on /About. */
    .channel {
        display: grid;
        gap: 0.75rem;
        justify-items: start;
        padding-block: 2rem;
    }

    .channel:first-child {
        padding-top: 0;
    }

    .channel + .channel {
        border-top: 1px solid var(--border);
    }

    /* The icon sits on the title's line. */
    .channel-title {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        font-size: var(--text-2xl);
        letter-spacing: -0.022em;
    }

    .channel p {
        color: var(--text-muted);
        line-height: 1.55;
    }

    /* Each network as a pill, like the email address in the footer. */
    .socials {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .socials a {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.45rem 1rem;
        border-radius: 999px;
        corner-shape: round;
        background: color-mix(in srgb, var(--heading) 8%, transparent);
        color: var(--heading);
        font-size: var(--text-sm);
        font-weight: 500;
        text-decoration: none;
        transition: background-color var(--duration);
    }

    .socials a:hover {
        background: color-mix(in srgb, var(--heading) 14%, transparent);
        text-decoration: none;
    }
</style>
