---
import type { CollectionEntry } from 'astro:content';

import { loadContributors } from '../collections/load-contributors';
import Icon from '../components/Icon.astro';
import PrinciplesBento from '../components/PrinciplesBento.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TalkToUsSection from '../components/TalkToUsSection.astro';
import TeamTile from '../components/TeamTile.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// About ONIXLabs: who we are, where we began, our mission, what we do (each linking to where it's covered), what our
// name means, what we stand for, and the people behind it.
interface Area {
    readonly title: string;
    readonly summary: string;
    readonly href: string;
}

interface Commitment {
    readonly title: string;
    readonly summary: string;
}

const contributors: ReadonlyArray<CollectionEntry<'contributors'>> = await loadContributors();
const commitments: ReadonlyArray<Commitment> = [
    {
        title: 'Communities through open source',
        summary: 'We publish the code others can use, and build communities around improving and maintaining it together.',
    },
    {
        title: 'Tools that help developers',
        summary: 'From open-source libraries to ONIXLabs Studio, we build tools that help developers work more effectively.',
    },
    {
        title: 'The right tool for the job',
        summary: "We build and choose tools for the problem in front of us, not for the sake of what's new.",
    },
    {
        title: 'AI where it fits',
        summary: 'We apply AI through our consulting and engineering, and help businesses understand what it can do and where it belongs.',
    },
];
const areas: ReadonlyArray<Area> = [
    {
        title: 'Products',
        summary: 'ONIXLabs Studio, the agentic development environment; Aero, the modular .NET suite; ONIXPlayer; and open-source libraries for .NET, Kotlin and Corda.',
        href: '/Products',
    },
    {
        title: 'Consulting',
        summary: 'Engineering-first consulting, from strategy and development to testing, integration, documentation and cloud delivery.',
        href: '/Consulting',
    },
    {
        title: 'Engineering with AI',
        summary: 'How we use AI across our engineering, consulting and integration work, and the tools we build for it.',
        href: '/Engineering-With-AI',
    },
    {
        title: 'Documentation',
        summary: 'Why we built our products, the ideas our libraries are built on, and the standards we hold our own code to.',
        href: '/Documentation',
    },
];
---
<BaseLayout
    title="About"
    description="About ONIXLabs: enterprise software engineering for .NET, Kotlin, the JVM and Corda since 2020, the principles we work by, and the team."
    path="/About"
    breadcrumbs={[{ name: 'Home', path: '/' }, { name: 'About', path: '/About' }]}
>
    <section class="hero-bloom about-hero" aria-labelledby="about-title">
        <div class="about-hero-copy">
            <h1 id="about-title" class="display rise">
                Think beyond code{' '}
                <span class="gradient-text">Build beyond limits</span>
            </h1>
            <p class="lead rise rise-2">
                Since {site.foundingYear}, we've been building software that lasts: the products we ship, the open-source libraries we share,
                and the systems we build alongside our clients. AI makes us faster; engineers make sure it's right.
            </p>
        </div>
    </section>

    <section class="section" aria-labelledby="where-we-began">
        <div class="container-wide split-layout">
            <SectionHeader eyebrow="Our story" title="Where we began" highlight="From a monolith to open source" id="where-we-began" />
            <div class="story reveal">
                <p>
                    Before ONIXLabs was founded, we were building a monolith. Alongside the code that made the application unique sat a
                    great deal that didn't: utilities, patterns and building blocks that any developer could use, and that gave nothing
                    away about the business they served.
                </p>
                <p>
                    So we took it apart. We broke the application down into reusable libraries, kept what belonged to the business, and
                    published the rest as open source, where the community could use it, improve it and help maintain it. ONIXLabs began
                    with that work, and those libraries are the foundations of our .NET, Kotlin and Corda libraries
                    today.
                </p>
                <p>
                    That decision became a philosophy we've held on to ever since. Building a business and giving back aren't at odds:
                    even as entrepreneurs, we can share what we've built with the community that helped us build it.
                </p>
            </div>
        </div>
    </section>

    <section class="section tone-alt" aria-labelledby="our-mission">
        <div class="container-wide split-layout">
            <SectionHeader eyebrow="Mission statement" title="Build the right tools" highlight="and share them" id="our-mission">
                We're dedicated to building cohesive communities through open source, and to building the tools that help developers
                work more effectively. As AI changes how software is made, we apply it through our consulting and engineering, and help
                businesses understand where it fits.
            </SectionHeader>
            <ul class="areas" role="list">
                {commitments.map((commitment: Commitment) => (
                    <li class="reveal">
                        <div class="area">
                            <span class="area-title">{commitment.title}</span>
                            <span class="area-summary">{commitment.summary}</span>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section" aria-labelledby="what-we-do">
        <div class="container-wide split-layout">
            <SectionHeader eyebrow="What we do" title="Software that scales" highlight="from tools to delivery" id="what-we-do">
                We build products, maintain open-source libraries and work with teams on their own systems, with the same standards
                throughout.
            </SectionHeader>
            <ul class="areas" role="list">
                {areas.map((area: Area) => (
                    <li class="reveal">
                        <a class="area" href={area.href}>
                            <span class="area-title">{area.title}</span>
                            <span class="area-summary">{area.summary}</span>
                            <span class="area-arrow" aria-hidden="true"><Icon name="arrow-right-bold" /></span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section tone-alt" aria-labelledby="our-name">
        <div class="container-wide split-layout">
            <SectionHeader eyebrow="What's in a name" title="Why it's ONIXLabs" highlight="and not OnyxLabs" id="our-name" />
            <div class="story reveal">
                <p>
                    Almost everyone gets our name wrong, and we can't really blame them: onyx, the stone, is spelled with a y. We've been
                    OnyxLabs in more emails, invoices and introductions than we can count.
                </p>
                <p>
                    But ONIX isn't a misspelling. It's an acronym for Open Networks of Information eXchange, and those networks can be
                    digital ones or networks of people. We care about both.
                </p>
                <p>
                    The O in our logo has a story of its own. We call it the Orb, and its outer ring is an everlasting rainbow of colour.
                    That's deliberate: just as God established a covenant with Noah, we've established one with the developer community.
                    What we release for free stays free, forever.
                </p>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="what-we-stand-for">
        <div class="container-wide">
            <SectionHeader title="What we" highlight="stand for" id="what-we-stand-for" centered>
                The principles behind everything we build, from a single library to a client's production system.
            </SectionHeader>
            <PrinciplesBento />
        </div>
    </section>

    <section class="section tone-alt" aria-labelledby="the-team">
        <div class="container-wide">
            <SectionHeader title="The people" highlight="behind the code" id="the-team" centered>
                We believe great software is a shared effort. We contribute to the tools we use, collaborate with the community, and
                champion open-source wherever we can.
            </SectionHeader>
            <div class="grid grid-4 shelf-mobile">
                {contributors.map((contributor: CollectionEntry<'contributors'>) => (
                    <TeamTile
                        name={contributor.data.name}
                        jobTitle={contributor.data.jobTitle}
                        accent={contributor.data.accent}
                        photo={contributor.data.photo}
                        href={contributor.data.path}
                        teaser={contributor.data.teaser}
                        gitHubUrl={contributor.data.gitHubUrl}
                        linkedInUrl={contributor.data.linkedInUrl}
                    />
                ))}
            </div>
        </div>
    </section>

    <TalkToUsSection />
</BaseLayout>

<style>
    .about-hero {
        padding-block: clamp(4rem, 3rem + 5vw, 7.5rem) clamp(5rem, 3.5rem + 7vw, 10rem);
        overflow: clip;
    }

    .about-hero-copy {
        display: grid;
        gap: 1.4rem;
        justify-items: center;
        width: min(100% - 2 * var(--gutter), 76rem);
        margin-inline: auto;
        text-align: center;
    }

    .about-hero h1 {
        color: var(--heading);
        font-family: var(--font-display);
        font-weight: 600;
    }

    .about-hero h1 .gradient-text {
        display: block;
    }

    /* The full text colour rather than the muted one: the bloom reaches up behind this. */
    .about-hero .lead {
        max-width: var(--lead-width);
        color: var(--text);
        text-wrap: balance;
    }

    .areas {
        display: grid;
    }

    .areas li + li {
        border-top: 1px solid var(--border);
    }

    .area {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.4rem 1.5rem;
        align-items: center;
        padding-block: 1.75rem;
        color: inherit;
        text-decoration: none;
    }

    .areas li:first-child .area {
        padding-top: 0;
    }

    .area:hover {
        text-decoration: none;
    }

    .area-title {
        color: var(--heading);
        font-size: var(--text-2xl);
        font-weight: 600;
        letter-spacing: -0.022em;
    }

    .area-summary {
        grid-column: 1;
        color: var(--text-muted);
        line-height: 1.55;
    }

    .area-arrow {
        grid-column: 2;
        grid-row: 1 / span 2;
        display: inline-flex;
        color: var(--heading);
        font-size: 1.4rem;
        transition: transform var(--duration) var(--ease-out);
    }

    .area:hover .area-arrow {
        transform: translateX(4px);
    }
</style>
