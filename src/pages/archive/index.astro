---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import { loadContributors } from '../../collections/load-contributors';
import { loadProductFamilies } from '../../collections/load-product-families';
import { loadProducts } from '../../collections/load-products';
import AeroShowcase from '../../components/AeroShowcase.astro';
import Button from '../../components/Button.astro';
import ContributorCard from '../../components/ContributorCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import Icon from '../../components/Icon.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import TechnologyGrid from '../../components/TechnologyGrid.astro';
import type { Principle } from '../../config/principle';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const principles: ReadonlyArray<Principle> = [
    { title: 'Craftsmanship', icon: 'pen-ruler', body: 'We treat code as a craft, writing software with precision, care, and pride in every detail.' },
    { title: 'Integrity', icon: 'shield-halved', body: 'We uphold transparency, honesty, and reliability in every decision, from code to client collaboration.' },
    { title: 'Performance', icon: 'gauge-high', body: 'We engineer solutions that are not only functional but fast, efficient, and built to scale.' },
    { title: 'Enterprise', icon: 'building', body: 'Our platforms are designed for the complexity and demands of modern enterprises. Secure, scalable, and future-ready.' },
    { title: 'Community', icon: 'users', body: 'We thrive on collaboration, contributing to open-source and growing together with the global developer community.' },
    { title: 'Simplicity', icon: 'leaf', body: 'We believe the best solutions are intuitive, removing complexity to let clarity and function shine.' },
    { title: 'Education', icon: 'graduation-cap', body: 'We foster a culture of continuous learning, sharing knowledge, mentoring talent, and staying ahead of the curve.' },
    { title: 'Support', icon: 'life-ring', body: 'We stand by our software and our users, delivering responsive, reliable support that builds long-term trust.' },
];

const technologies: ReadonlyArray<CollectionEntry<'technologies'>> = (await getCollection('technologies')).toSorted(
    (left: CollectionEntry<'technologies'>, right: CollectionEntry<'technologies'>): number => left.id.localeCompare(right.id),
);
const contributors: ReadonlyArray<CollectionEntry<'contributors'>> = await loadContributors();
const families: ReadonlyArray<CollectionEntry<'productFamilies'>> = await loadProductFamilies();
const products: ReadonlyArray<CollectionEntry<'products'>> = await loadProducts();

function productsIn(family: CollectionEntry<'productFamilies'>): ReadonlyArray<CollectionEntry<'products'>> {
    return products.filter((product: CollectionEntry<'products'>): boolean => product.data.family.id === family.id);
}
---
<BaseLayout title="ONIXLabs | Enterprise Software Engineering for .NET, Kotlin & Corda" description={site.description} path="/archive">
    <section class="hero">
        <div class="container hero-inner recede">
            <a class="hero-news rise" href="/archive/Products/Aero">
                <span class="hero-news-tag">New</span>
                <span>Introducing Aero<span class="hero-news-detail">, the modular .NET suite</span></span>
                <Icon name="chevron-right" />
            </a>
            <h1 class="hero-title rise rise-2">
                Code that connects.
                <span class="headline-muted">Software that scales.</span>
            </h1>
            <p class="lead hero-lead rise rise-3">
                At ONIXLabs, we enhance the software development journey through a relentless focus on quality, crafting robust and
                scalable enterprise solutions that empower innovation and growth.
            </p>
            <div class="cluster is-centered hero-actions rise rise-4">
                <Button href="/archive/Products/" variant="primary" size="large">Explore our products</Button>
                <Button href="/archive/Consulting" variant="link">Work with us</Button>
            </div>
            <ul class="hero-platforms rise rise-4" role="list" aria-label="Platforms we specialise in">
                <li>C#</li>
                <li>.NET</li>
                <li>Kotlin</li>
                <li>Java &amp; the JVM</li>
                <li>Corda</li>
            </ul>
        </div>
    </section>

    <section class="section tone-dark aero" aria-labelledby="introducing-aero">
        <div class="container aero-copy reveal">
            <h2 id="introducing-aero">Introducing <span class="gradient-text">Aero</span></h2>
            <p class="lead">
                <strong>A modular suite of .NET APIs designed for fast, scalable, enterprise engineering.</strong>{' '}
                It helps teams ship quickly, scale confidently, and modernize everything from cloud-native apps to legacy systems.
            </p>
            <div class="cluster is-centered">
                <Button href="/archive/Products/Aero" variant="link">Learn more<span class="visually-hidden"> about Aero</span></Button>
                <Button href="/archive/Contact?reason=aero-demo" variant="link">Request a demo</Button>
            </div>
        </div>
        <div class="zoom-stage">
            <div class="zoom-sticky">
                <div class="container-wide aero-shot settle">
                    <AeroShowcase tone="dark" class="zoom-target" />
                </div>
            </div>
        </div>
        <ul class="container aero-points" role="list">
            <li class="highlight"><Icon name="rocket" /> Blazing fast.</li>
            <li class="highlight"><Icon name="layer-group" /> Infinitely scalable.</li>
            <li class="highlight"><Icon name="building" /> Built for enterprise.</li>
        </ul>
    </section>

    <section class="section tone-alt" aria-labelledby="principles">
        <div class="container-wide">
            <SectionHeader eyebrow="Powering possibility" title="Principles behind" highlight="every line we ship." id="principles" centered>
                We enhance the software development journey through a relentless focus on quality, crafting robust and scalable
                enterprise solutions.
            </SectionHeader>
            <div class="grid grid-4 principles">
                {principles.map((principle: Principle) => <FeatureCard title={principle.title} icon={principle.icon} body={principle.body} />)}
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="open-source">
        <div class="container-wide">
            <SectionHeader eyebrow="Open source" title="Libraries for the platforms" highlight="you build on." id="open-source" centered>
                Focused, well-engineered libraries that extend .NET, Corda and Kotlin, developed in the open on GitHub.
            </SectionHeader>
            <div class="grid grid-3 shelf-mobile">
                {families.map((family: CollectionEntry<'productFamilies'>) => (
                    <a class={`tile family-tile family-${family.id} reveal-scale`} href={`/archive/Products/#${family.id}`}>
                        <span class="family-emblems" aria-hidden="true">
                            {productsIn(family).map((product: CollectionEntry<'products'>) => (
                                <span class="emblem"><img src={product.data.icon} alt="" width={48} height={48} loading="lazy" decoding="async" /></span>
                            ))}
                        </span>
                        <p class="family-name">{family.data.name}</p>
                        <h3>{family.data.callout}</h3>
                        <ul class="family-products" role="list">
                            {productsIn(family).map((product: CollectionEntry<'products'>) => <li>{product.data.shortTitle}</li>)}
                        </ul>
                        <span class="link-cta family-link">View {family.data.name} libraries <Icon name="chevron-right" /></span>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="section tone-dark" aria-labelledby="tools-that-fit">
        <div class="container-wide">
            <SectionHeader eyebrow="Purpose over preference" title="Tools that fit," highlight="built to last." id="tools-that-fit" centered>
                We don't believe that one size fits all. We choose the right tools for the job, not just the ones we know. If we're not the
                best fit, we'll learn fast or help connect you with those who are.
            </SectionHeader>
            <TechnologyGrid technologies={technologies} />
        </div>
    </section>

    <section class="section tone-alt" aria-labelledby="champions-of-contribution">
        <div class="container-wide">
            <SectionHeader eyebrow="Our people" title="Champions of" highlight="contribution." id="champions-of-contribution" centered>
                We believe great software is a shared effort. We contribute to the tools we use, collaborate with the community, and
                champion open-source innovation wherever we can.
            </SectionHeader>
            <div class="grid grid-4 shelf-mobile">
                {contributors.map((contributor: CollectionEntry<'contributors'>) => <ContributorCard contributor={contributor} />)}
            </div>
        </div>
    </section>

    <CtaBand tone="default" />
</BaseLayout>

<style>
    .hero {
        padding-block: clamp(4.5rem, 3rem + 7vw, 10rem) clamp(4.5rem, 3rem + 6vw, 9rem);
        background: var(--bg);
        text-align: center;
        overflow: clip;
    }

    .hero-inner {
        display: grid;
        justify-items: center;
        gap: 1.5rem;
    }

    .hero-news {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--link);
        font-size: var(--text-base);
    }

    .hero-news :global(.icon) {
        width: 0.6em;
        height: 0.6em;
    }

    .hero-news-tag {
        color: var(--heading);
        font-weight: 600;
    }

    .hero-news-tag::before {
        content: '';
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        margin-right: 0.5rem;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--brand-amber), var(--brand-rose));
        vertical-align: 0.1em;
    }

    @media (max-width: 30rem) {
        .hero-news-detail {
            display: none;
        }
    }

    .hero-title {
        max-width: 14ch;
        font-size: var(--text-hero);
        letter-spacing: -0.038em;
        line-height: 1;
    }

    .hero-title .headline-muted {
        display: block;
    }

    .hero-lead {
        max-width: 40rem;
    }

    .hero-actions {
        margin-top: 0.75rem;
    }

    .hero-platforms {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        row-gap: 0.4rem;
        margin-top: 2.5rem;
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    .hero-platforms li {
        display: flex;
        align-items: center;
    }

    .hero-platforms li + li::before {
        content: '';
        width: 3px;
        height: 3px;
        margin-inline: 0.9rem;
        border-radius: 50%;
        background: currentColor;
    }

    .aero {
        padding-bottom: clamp(5rem, 3rem + 6vw, 9rem);
        overflow: clip;
    }

    .aero-copy {
        display: grid;
        justify-items: center;
        gap: 1.25rem;
        text-align: center;
    }

    .aero-copy h2 {
        font-size: var(--text-hero);
        letter-spacing: -0.038em;
        line-height: 1;
    }

    .aero-copy .lead {
        max-width: 44rem;
    }

    .aero-shot {
        max-width: 68rem;
        margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    }

    .aero-points {
        display: grid;
        gap: 0.5rem;
        margin-top: clamp(3rem, 2rem + 4vw, 6rem);
        text-align: center;
    }

    .aero-points li {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem 0.9rem;
        color: var(--heading);
        font-size: var(--text-5xl);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1.15;
    }

    @media (min-width: 48rem) {
        .aero-points li {
            flex-direction: row;
        }
    }

    .aero-points :global(.icon) {
        width: 0.6em;
        height: 0.6em;
        color: var(--brand-rose);
    }

    .aero-points li:nth-child(2) :global(.icon) {
        color: var(--brand-violet);
    }

    .aero-points li:nth-child(3) :global(.icon) {
        color: var(--brand-cyan);
    }

    .family-tile {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        min-height: 30rem;
        padding: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    }

    .family-emblems {
        display: flex;
        gap: 0.6rem;
        margin-bottom: auto;
        padding-bottom: 2.5rem;
    }

    .family-emblems .emblem {
        --emblem-size: 3.75rem;
    }

    .family-name {
        color: var(--heading);
        font-size: var(--text-4xl);
        font-weight: 600;
        letter-spacing: -0.035em;
        line-height: 1;
    }

    .family-tile h3 {
        color: var(--text-muted);
        font-size: var(--text-xl);
        font-weight: 500;
    }

    .family-products {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1rem;
        margin-top: 0.5rem;
        color: var(--text);
        font-size: var(--text-sm);
    }

    .family-link {
        margin-top: 1rem;
        font-size: var(--text-base);
    }
</style>
