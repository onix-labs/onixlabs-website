---
import Button from '../../components/Button.astro';
import CtaBand from '../../components/CtaBand.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import type { Principle } from '../../config/principle';
import BaseLayout from '../../layouts/BaseLayout.astro';

const services: ReadonlyArray<Principle> = [
    { title: 'Strategy', icon: 'strategy', body: 'We help define your product roadmap, identify market fit, and architect scalable solutions aligned with your business goals.' },
    { title: 'Development', icon: 'code', body: 'We design and build robust, maintainable software using modern best practices, delivering clean, efficient code that scales with your team.' },
    { title: 'Testing', icon: 'flask', body: 'We implement robust testing strategies across unit, integration, and end-to-end levels to ensure quality and confidence at every stage.' },
    { title: 'Integration', icon: 'git-merge', body: 'We implement CI/CD workflows that automate testing, deployment, and release, accelerating feedback and ensuring smooth, reliable delivery.' },
    { title: 'Documentation', icon: 'book-open', body: 'We produce comprehensive, developer-friendly documentation, from code docs to full technical guides.' },
    { title: 'Delivery', icon: 'cloud-arrow-up', body: 'We handle production-ready cloud deployments, service monitoring, and uptime strategies to keep your software running smoothly.' },
];
---
<BaseLayout
    title="Software Engineering Consulting"
    description="Engineering-first consulting from ONIXLabs: strategy, development, testing, CI/CD integration, documentation and cloud delivery for startups and enterprises."
    path="/archive/Consulting"
    breadcrumbs={[{ name: 'Home', path: '/archive' }, { name: 'Consulting', path: '/archive/Consulting' }]}
>
    <PageHero eyebrow="Consulting" title="Seamless integration with your team, tools, and" highlight="tech stack.">
        We help startups and enterprises build robust, scalable software, faster. Whether you're launching a product, scaling a system, or
        untangling legacy code, our engineering-first consulting cuts through the noise to deliver real solutions.
        <Fragment slot="actions">
            <Button href="/archive/Contact?reason=consulting" variant="primary" size="large">Send a message</Button>
            <Button href="https://calendly.com/matthew-layton/30min" variant="link" external>Book a meeting</Button>
        </Fragment>
    </PageHero>

    <section class="section tone-alt" aria-labelledby="services">
        <div class="container-wide">
            <SectionHeader eyebrow="What we do" title="From architecture" highlight="to implementation." id="services" centered>
                We partner with your team across the whole lifecycle to ship software that works.
            </SectionHeader>
            <ol class="grid grid-3 services" role="list">
                {services.map((service: Principle) => (
                    <li><FeatureCard title={service.title} icon={service.icon} body={service.body} /></li>
                ))}
            </ol>
        </div>
    </section>

    <CtaBand tone="dark" title="We're here to help your business thrive." primaryText="Send a message" primaryHref="/archive/Contact?reason=consulting">
        Whether you have a question, need a custom solution, or just want to explore what’s possible, we're just a message away. Let's
        start the conversation and see how we can support your goals.
    </CtaBand>
</BaseLayout>

<style>
    .services > li {
        display: grid;
    }

    .services :global(.icon-chip) {
        width: 3.25rem;
        height: 3.25rem;
        font-size: 1.3rem;
    }
</style>
