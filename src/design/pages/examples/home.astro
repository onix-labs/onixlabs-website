---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import { loadArticles } from '../../../collections/load-articles';
import { loadProducts } from '../../../collections/load-products';
import ArticleTile from '../../../components/ArticleTile.astro';
import Button from '../../../components/Button.astro';
import CapstoneTile from '../../../components/CapstoneTile.astro';
import FeatureTile from '../../../components/FeatureTile.astro';
import Hero from '../../../components/Hero.astro';
import Icon from '../../../components/Icon.astro';
import ProductStage from '../../../components/ProductStage.astro';
import ProductTile from '../../../components/ProductTile.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import TalkToUsSection from '../../../components/TalkToUsSection.astro';
import TechnologyMarquee from '../../../components/TechnologyMarquee.astro';
import type { StageStatement } from '../../../components/stage-statement';
import type { Principle } from '../../../config/principle';
import { documentationCategories } from '../../../config/documentation-categories';
import type { DocumentationCategory } from '../../../config/documentation-category';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ExampleFrame from '../../ExampleFrame.astro';

// Example home page: capstone products first, company second, built only from design-language components.
const principles: ReadonlyArray<Principle> = [
    { title: 'Craftsmanship', icon: 'design', body: 'We treat code as a craft, writing software with precision, care, and pride in every detail.' },
    { title: 'Integrity', icon: 'shield', body: 'We uphold transparency, honesty, and reliability in every decision, from code to client collaboration.' },
    { title: 'Performance', icon: 'gauge', body: 'We engineer solutions that are not only functional but fast, efficient, and built to scale.' },
    { title: 'Enterprise', icon: 'buildings', body: 'Our platforms are designed for the complexity and demands of modern enterprises. Secure, scalable, and future-ready.' },
    { title: 'Community', icon: 'user-group', body: 'We thrive on collaboration, contributing to open-source and growing together with the global developer community.' },
    { title: 'Simplicity', icon: 'leaf', body: 'We believe the best solutions are intuitive, removing complexity to let clarity and function shine.' },
    { title: 'Education', icon: 'documents', body: 'We foster a culture of continuous learning, sharing knowledge, mentoring talent, and staying ahead of the curve.' },
    { title: 'Support', icon: 'support', body: 'We stand by our software and our users, delivering responsive, reliable support that builds long-term trust.' },
];
const statements: ReadonlyArray<StageStatement> = [
    { icon: 'rocket-launch', text: 'Blazing fast.' },
    { icon: 'stack', text: 'Infinitely scalable.' },
    { icon: 'building-office', text: 'Built for enterprise.' },
];
const technologies: ReadonlyArray<CollectionEntry<'technologies'>> = (await getCollection('technologies')).toSorted(
    (left: CollectionEntry<'technologies'>, right: CollectionEntry<'technologies'>): number => left.id.localeCompare(right.id),
);
const libraries: ReadonlyArray<CollectionEntry<'products'>> = (await loadProducts()).filter(
    (product: CollectionEntry<'products'>): boolean => product.data.family.id !== 'corda',
);
const articles: ReadonlyArray<CollectionEntry<'articles'>> = (await loadArticles()).slice(0, 3);
const familyLabels: ReadonlyMap<string, string> = new Map<string, string>([['dotnet', '.NET'], ['kotlin', 'Kotlin'], ['corda', 'Corda']]);

function categoryName(id: string): string {
    return documentationCategories.find((category: DocumentationCategory): boolean => category.id === id)?.name ?? id;
}
---
<BaseLayout title="Example: Home · Design language" description="An example home page assembled from the ONIXLabs design language components." path="/design/examples/home" noindex>
    <Hero label="ONIXLabs" title="Code that connects." highlight="Software that scales." align="center">
        Capstone products and open-source libraries for enterprise engineering in .NET, Kotlin and the JVM.
        <Fragment slot="actions">
            <a class="pill" href="#products"><span class="badge badge-pill badge-brand">New</span> Introducing Aero, the modular .NET suite <Icon name="caret-right" /></a>
        </Fragment>
    </Hero>

    <section class="section-tight" id="products" aria-label="Products">
        <div class="container-wide stack-tiles">
            <CapstoneTile label="Aero platform" title="Introducing" highlight="Aero." palette="aero">
                <strong>A modular suite of .NET APIs designed for fast, scalable, enterprise engineering.</strong>{' '}
                It helps teams ship quickly, scale confidently, and modernize everything from cloud-native apps to legacy systems.
                <Fragment slot="actions">
                    <Button href="#aero-stage" variant="primary">Discover Aero</Button>
                    <Button href="#products" variant="link">Request a demo</Button>
                </Fragment>
                <img slot="media" class="shot" src="/onixlabs/images/marketing/macbook-pro-dark.webp" alt="The Aero platform on a laptop" width={1400} height={834} />
            </CapstoneTile>
            <div class="grid grid-2">
                <CapstoneTile label="Capstone · placeholder" title="ONIXLabs" highlight="Studio." palette="studio" layout="stacked">
                    Placeholder: a one-line pitch for ONIXLabs Studio.
                    <Fragment slot="actions"><Button href="#products" variant="link">Learn more</Button></Fragment>
                </CapstoneTile>
                <CapstoneTile label="Capstone · placeholder" title="ONIX" highlight="Player." palette="player" layout="stacked">
                    Placeholder: a one-line pitch for ONIXPlayer.
                    <Fragment slot="actions"><Button href="#products" variant="link">Learn more</Button></Fragment>
                </CapstoneTile>
            </div>
        </div>
    </section>

    <section class="section tone-dark" id="aero-stage" aria-labelledby="aero-stage-title">
        <div class="container">
            <SectionHeader eyebrow="Aero platform" title="The modular .NET suite for" highlight="enterprise engineering." highlightStyle="gradient" id="aero-stage-title" centered>
                From APIs to infrastructure, each module is crafted to solve real-world engineering challenges with clarity, performance, and security in mind.
            </SectionHeader>
        </div>
        <ProductStage statements={statements}>
            <img class="shot" src="/onixlabs/images/marketing/macbook-pro-dark.webp" alt="" width={1400} height={834} />
        </ProductStage>
    </section>

    <section class="section tone-alt" aria-labelledby="principles">
        <div class="container-wide">
            <SectionHeader eyebrow="Powering possibility" title="Craft in every line." highlight="Built to last." id="principles">
                We enhance the software development journey through a relentless focus on quality, crafting robust and scalable enterprise solutions that empower innovation and growth.
            </SectionHeader>
            <div class="grid grid-4">
                {principles.map((principle: Principle) => <FeatureTile title={principle.title} glass={principle.icon} body={principle.body} />)}
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="open-source">
        <div class="container-wide">
            <SectionHeader eyebrow="Open source" title="Libraries for the platforms" highlight="you build on." id="open-source">
                Focused, well-engineered libraries that extend .NET and Kotlin, developed in the open on GitHub.
            </SectionHeader>
            <div class="grid grid-3 shelf-mobile">
                {libraries.map((product: CollectionEntry<'products'>) => (
                    <ProductTile href="#open-source" label={familyLabels.get(product.data.family.id) ?? 'Library'} name={product.data.shortTitle} pitch={product.data.hook} icon={product.data.icon} family={product.data.family.id} />
                ))}
            </div>
            <div class="cluster section-more"><Button href="#open-source" variant="link">All libraries, including Corda</Button></div>
        </div>
    </section>

    <section class="section tone-alt technologies" aria-labelledby="tools-that-fit">
        <div class="container">
            <SectionHeader eyebrow="Purpose over preference" title="Tools that fit," highlight="built to last." id="tools-that-fit" centered>
                We choose the right tools for the job, not just the ones we know. If we're not the best fit, we'll learn fast or help connect you with those who are.
            </SectionHeader>
        </div>
        <TechnologyMarquee technologies={technologies} />
    </section>

    <section class="section" aria-labelledby="writing">
        <div class="container-wide">
            <SectionHeader eyebrow="Writing" title="Notes from" highlight="the workshop." id="writing">
                Technical articles on C#, number theory and the platforms we build.
            </SectionHeader>
            <div class="grid grid-3 shelf-mobile">
                {articles.map((article: CollectionEntry<'articles'>) => (
                    <ArticleTile href="#writing" category={categoryName(article.data.category)} title={article.data.title} summary={article.data.description} />
                ))}
            </div>
        </div>
    </section>

    <TalkToUsSection alternate />
    <ExampleFrame />
</BaseLayout>

<style>
    .stack-tiles {
        display: grid;
        gap: var(--tile-gap);
    }

    .shot {
        width: 100%;
        filter: drop-shadow(var(--shadow-product));
    }

    .section-more {
        margin-top: 2rem;
    }

    .technologies {
        overflow: hidden;
    }
</style>
