---
import Specimen from '../Specimen.astro';
import type { TypeStep } from '../type-step';

const scale: ReadonlyArray<TypeStep> = [
    { token: '--text-hero', use: 'Display: one per page, the hero headline' },
    { token: '--text-5xl', use: 'Heading 1 and section headlines' },
    { token: '--text-4xl', use: 'Heading 2' },
    { token: '--text-3xl', use: 'Large tile headings' },
    { token: '--text-2xl', use: 'Sub-section headings' },
    { token: '--text-xl', use: 'Heading 3, standfirst (Stride xl, 1.375rem)' },
    { token: '--text-lg', use: 'Large body, link-style calls to action (Stride lg)' },
    { token: '--text-base', use: 'Body copy (Stride md, 16px)' },
    { token: '--text-sm', use: 'Secondary text, captions' },
    { token: '--text-xs', use: 'Labels' },
];
---
<Specimen title="Typefaces" code={'--font-display, --font-body: Poppins (400, 500, 600, 700)\n--font-mono: JetBrains Mono Variable'}>
    <Fragment slot="notes"><p>Stride sets every word in Poppins: headlines, body, buttons and navigation. A monospace carries code and small technical labels. Both are self-hosted.</p></Fragment>
    <div class="faces">
        <div><p class="label label-muted">Everything</p><p class="face face-display">Poppins</p><p class="muted">Regular 400 for reading, Medium 500 for controls, Semibold 600 and Bold 700 for headings.</p></div>
        <div><p class="label label-muted">Weights</p><p class="weights"><span class="w4">Regular</span> <span class="w5">Medium</span> <span class="w6">Semibold</span> <span class="w7">Bold</span></p></div>
        <div><p class="label label-muted">Mono</p><p class="face face-mono">JetBrains Mono</p><p class="muted">Labels, code, and technical detail.</p></div>
    </div>
</Specimen>

<Specimen title="Type scale" surface="none">
    <Fragment slot="notes"><p>Fluid sizes that grow with the viewport. Headings use the display face; everything from <code>--text-xl</code> down is usually Inter.</p></Fragment>
    <ul class="scale" role="list">
        {scale.map((step: TypeStep) => (
            <li>
                <code>{step.token}</code>
                <span class={`scale-sample sample${step.token}`}>Aa</span>
                <span class="muted">{step.use}</span>
            </li>
        ))}
    </ul>
</Specimen>

<Specimen title="Display headline" code={'<h1 class="display">\n  <span class="mask-line"><span>Line one,</span></span>\n  <span class="mask-line"><span class="gradient-text">line two.</span></span>\n</h1>'}>
    <Fragment slot="notes"><p>The largest type on the site, used once, in the hero. Each line slides up out of its own mask when the page loads.</p></Fragment>
    <p class="display" role="presentation">
        <span class="mask-line"><span>Code that connects.</span></span>
        <span class="mask-line"><span class="gradient-text">Software that scales.</span></span>
    </p>
</Specimen>

<Specimen title="Two-tone headline" code={'<h2>Code that connects. <span class="headline-muted">Software that scales.</span></h2>'}>
    <Fragment slot="notes"><p>The statement in full colour, its continuation in grey. The default for section headlines.</p></Fragment>
    <p class="h-sample h-1">Code that connects. <span class="headline-muted">Software that scales.</span></p>
</Specimen>

<Specimen title="Gradient phrase" code={'<h2>Built for the <span class="gradient-text">enterprise.</span></h2>'}>
    <Fragment slot="notes"><p>One phrase per headline at most, and only where it carries the point. On light, the gradient runs rose to cyan so every stop keeps enough contrast; on dark it uses the full spectrum.</p></Fragment>
    <p class="h-sample h-1">Built for the <span class="gradient-text">enterprise.</span></p>
</Specimen>

<Specimen title="Headings" code={'<h1>…</h1>  <h2>…</h2>  <h3>…</h3>  <h4>…</h4>'}>
    <div class="stack-lg">
        <p class="h-sample h-1">Heading 1</p>
        <p class="h-sample h-2">Heading 2</p>
        <p class="h-sample h-3">Heading 3</p>
        <p class="h-sample h-4">Heading 4</p>
    </div>
</Specimen>

<Specimen title="Standfirst" code={'<p class="lead">…</p>'}>
    <Fragment slot="notes"><p>The paragraph that follows a headline and sets up the section: larger and quieter than body copy.</p></Fragment>
    <p class="lead measure">A modular suite of .NET APIs designed for fast, scalable, enterprise engineering. It helps teams ship quickly, scale confidently, and modernize everything from cloud-native apps to legacy systems.</p>
</Specimen>

<Specimen title="Body copy" code={'<p>…</p>'}>
    <div class="measure stack-sm">
        <p>Body copy is Poppins at 16px with a 1.5 line height, set to a comfortable measure of about 70 characters. It supports <a href="#body-copy">inline links</a>, <strong>strong emphasis</strong>, <em>emphasis</em> and <code>inline code</code>.</p>
        <p class="muted small">Secondary text uses the muted colour at a smaller size, for captions and supporting detail.</p>
    </div>
</Specimen>

<Specimen title="Label" code={'<p class="label">Section label</p>\n<p class="label label-muted">Muted label</p>'}>
    <Fragment slot="notes"><p>A small monospace capital label names what follows: a section, a product, a category. Coral by default, deepened in light mode so it clears 4.5:1.</p></Fragment>
    <div class="stack-sm">
        <p class="label">Aero platform</p>
        <p class="label label-muted">Muted label</p>
    </div>
</Specimen>

<style>
    .faces {
        display: grid;
        gap: 2rem;
    }

    @media (min-width: 48rem) {
        .faces {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .faces > div {
        display: grid;
        gap: 0.5rem;
        align-content: start;
    }

    .face {
        color: var(--heading);
        font-size: var(--text-4xl);
        line-height: 1.1;
    }

    .face-display { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.04em; }
    .weights { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; color: var(--heading); font-size: var(--text-2xl); }
    .w4 { font-weight: 400; }
    .w5 { font-weight: 500; }
    .w6 { font-weight: 600; }
    .w7 { font-weight: 700; }
    .face-mono { font-family: var(--font-mono); font-size: var(--text-3xl); font-weight: 500; letter-spacing: -0.02em; }

    .faces .muted {
        font-size: var(--text-sm);
    }

    .scale {
        display: grid;
        border-top: 1px solid var(--border);
    }

    .scale li {
        display: grid;
        grid-template-columns: 8rem 9rem 1fr;
        gap: 1rem;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--border);
        font-size: var(--text-sm);
    }

    .scale code {
        color: var(--text-muted);
    }

    .scale-sample {
        color: var(--heading);
        font-family: var(--font-display);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1;
    }

    .sample--text-hero { font-size: var(--text-hero); }
    .sample--text-5xl { font-size: var(--text-5xl); }
    .sample--text-4xl { font-size: var(--text-4xl); }
    .sample--text-3xl { font-size: var(--text-3xl); }
    .sample--text-2xl { font-size: var(--text-2xl); }
    .sample--text-xl { font-size: var(--text-xl); }
    .sample--text-lg { font-size: var(--text-lg); }
    .sample--text-base { font-size: var(--text-base); }
    .sample--text-sm { font-size: var(--text-sm); }
    .sample--text-xs { font-size: var(--text-xs); }

    .h-sample {
        color: var(--heading);
        font-family: var(--font-display);
        font-weight: 600;
        text-wrap: balance;
    }

    .h-1 { font-size: var(--text-5xl); letter-spacing: -0.04em; line-height: 1.04; }
    .h-2 { font-size: var(--text-4xl); letter-spacing: -0.035em; line-height: 1.06; }
    .h-3 { font-size: var(--text-xl); font-weight: 500; letter-spacing: -0.02em; }
    .h-4 { font-size: var(--text-lg); letter-spacing: -0.01em; }

    .stack-lg {
        display: grid;
        gap: 1.25rem;
    }

    .stack-sm {
        display: grid;
        gap: 0.75rem;
    }

    .measure {
        max-width: 42rem;
    }

    .small {
        font-size: var(--text-sm);
    }
</style>
