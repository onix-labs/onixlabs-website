---
import Button from '../../components/Button.astro';
import Specimen from '../Specimen.astro';
---
<Specimen title="Inline links" code={'<a href="…">inline link</a>'}>
    <Fragment slot="notes"><p>Links in running text keep the text colour with a soft underline that darkens on hover, so they're distinguishable without relying on colour.</p></Fragment>
    <p class="measure">Aero integrates with <a href="#inline-links">HashiCorp Vault</a> for secrets management and digital signing, and builds on the <a href="#inline-links">Microsoft Logging APIs</a>.</p>
</Specimen>

<Specimen title="Link-style call to action" code={'<Button href="…" variant="link">Learn more</Button>'}>
    <Fragment slot="notes"><p>"Learn more ›" sits at the foot of a tile or under a section. The chevron is brand coral and nudges right on hover.</p></Fragment>
    <div class="cluster">
        <Button href="#link-style-call-to-action" variant="link">Learn more</Button>
        <Button href="#link-style-call-to-action" variant="link">Request a demo</Button>
        <Button href="https://github.com/onix-labs" variant="link" external>GitHub</Button>
    </div>
</Specimen>

<Specimen title="On a dark band" surface="dark">
    <p class="measure">An <a href="#on-a-dark-band">inline link</a> on near-black.</p>
    <div class="cluster spaced">
        <Button href="#on-a-dark-band" variant="link">Learn more</Button>
    </div>
</Specimen>

<style>
    .measure {
        max-width: 42rem;
    }

    .spaced {
        margin-top: 1rem;
    }
</style>
