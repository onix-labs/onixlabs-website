---
import BaseLayout from '../layouts/BaseLayout.astro';
import { designNavigation } from './design-navigation';
import type { DesignGroup } from './design-group';
import type { DesignPage } from './design-page';

// The design language's frame: a left-hand table of contents and the page's title and summary.
interface Props {
    readonly page: DesignPage | undefined;
}

const { page }: Props = Astro.props;
const currentSlug: string | undefined = page?.slug;
const title: string = page?.title ?? 'Design language';
---
<BaseLayout title={`${title} · Design language`} description="The ONIXLabs design language, shown without content." path={`/design/${currentSlug ?? ''}`} noindex>
    <div class="design">
        <nav class="design-nav" aria-label="Design language">
            <a class="design-home" href="/design/" aria-current={currentSlug === undefined ? 'page' : undefined}>
                <span class="label">ONIXLabs</span>
                <span class="design-home-title">Design language</span>
            </a>
            {designNavigation.map((group: DesignGroup) => (
                <details class="design-group" open>
                    <summary>{group.title}</summary>
                    <ul role="list">
                        {group.pages.map((item: DesignPage) => (
                            <li>
                                <a href={`/design/${item.slug}`} aria-current={item.slug === currentSlug ? 'page' : undefined}>{item.title}</a>
                            </li>
                        ))}
                    </ul>
                </details>
            ))}
        </nav>
        <div class="design-content">
            {page !== undefined && (
                <header class="design-header">
                    <p class="label">{designNavigation.find((group: DesignGroup): boolean => group.pages.includes(page))?.title}</p>
                    <h1>{page.title}</h1>
                    <p class="lead">{page.summary}</p>
                </header>
            )}
            <slot />
        </div>
    </div>
</BaseLayout>

<style>
    .design {
        display: grid;
        gap: 2rem;
        width: min(100% - 2 * var(--gutter), 84rem);
        margin: 0 auto;
        padding-block: 2.5rem 6rem;
    }

    @media (min-width: 60rem) {
        .design {
            grid-template-columns: 15rem minmax(0, 1fr);
            gap: 4rem;
        }

        .design-nav {
            position: sticky;
            top: calc(var(--header-height) + 1.5rem);
            align-self: start;
            max-height: calc(100dvh - var(--header-height) - 3rem);
            overflow-y: auto;
        }
    }

    .design-nav {
        display: grid;
        gap: 0.75rem;
        align-content: start;
        font-size: var(--text-sm);
    }

    .design-home {
        display: grid;
        gap: 0.2rem;
        padding: 0.75rem 0.85rem 1rem;
        border-bottom: 1px solid var(--border);
        text-decoration: none;
    }

    .design-home-title {
        color: var(--heading);
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: 600;
        letter-spacing: -0.03em;
    }

    .design-group summary {
        padding: 0.35rem 0.85rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        cursor: pointer;
        list-style: none;
    }

    .design-group summary::-webkit-details-marker {
        display: none;
    }

    .design-group ul {
        display: grid;
        gap: 0.1rem;
        margin-top: 0.25rem;
    }

    .design-group a {
        position: relative;
        display: block;
        padding: 0.4rem 0.85rem;
        border-radius: var(--radius-sm);
        color: var(--text);
        text-decoration: none;
    }

    .design-group a:hover {
        background: color-mix(in srgb, var(--heading) 6%, transparent);
    }

    .design-group a[aria-current='page'] {
        background: color-mix(in srgb, var(--heading) 8%, transparent);
        color: var(--heading);
        font-weight: 600;
    }

    .design-group a[aria-current='page']::before {
        content: '';
        position: absolute;
        inset: 0.45rem auto 0.45rem 0;
        width: 3px;
        border-radius: 3px;
        background: var(--brand-gradient);
    }

    .design-header {
        display: grid;
        gap: 0.75rem;
        max-width: 44rem;
        padding-bottom: 2.5rem;
        margin-bottom: 3rem;
        border-bottom: 1px solid var(--border);
    }

    .design-header h1 {
        font-size: var(--text-5xl);
    }

    .design-content {
        min-width: 0;
    }
</style>
