---
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import 'bootstrap/dist/css/bootstrap.min.css';
import 'animate.css/animate.min.css';
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeInitialiser from '../components/ThemeInitialiser.astro';
import { PageType } from '../seo/page-type';
import type { Breadcrumb } from '../seo/breadcrumb';
import type { JsonLdObject } from '../seo/json-ld-object';

interface Props {
    readonly title: string;
    readonly description: string;
    readonly path: string;
    readonly type?: PageType;
    readonly image?: string;
    readonly imageAlt?: string;
    readonly noindex?: boolean;
    readonly breadcrumbs?: ReadonlyArray<Breadcrumb>;
    readonly structuredData?: ReadonlyArray<JsonLdObject>;
}

const props: Props = Astro.props;
---
<!doctype html>
<html lang="en" data-bs-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <ThemeInitialiser />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#e9ecef" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#212529" media="(prefers-color-scheme: dark)" />
        <meta name="generator" content={Astro.generator} />

        <link rel="icon" sizes="48x48" type="image/png" href="/onixlabs/images/logo/logo-orb-48.png" />
        <link rel="icon" sizes="96x96" type="image/png" href="/onixlabs/images/logo/logo-orb-96.png" />
        <link rel="icon" sizes="any" type="image/svg+xml" href="/onixlabs/images/logo/logo-orb.svg" />
        <link rel="apple-touch-icon" href="/onixlabs/images/logo/logo-orb-180.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <Seo {...props} />
    </head>
    <body class="min-vh-100 d-flex flex-column">
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <SiteHeader />
        <main id="main-content" class="flex-grow-1" tabindex="-1">
            <slot />
        </main>
        <SiteFooter />
        <script>
            import '../scripts/main';
        </script>
    </body>
</html>
