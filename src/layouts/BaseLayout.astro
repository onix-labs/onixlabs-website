---
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-400-italic.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/effects.css';
import '../styles/prose.css';

import poppinsRegular from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppinsSemiBold from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';

import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeInitialiser from '../components/ThemeInitialiser.astro';
import { PageType } from '../seo/page-type';
import type { Breadcrumb } from '../seo/breadcrumb';
import type { JsonLdObject } from '../seo/json-ld-object';

interface Props {
    readonly title: string;
    readonly description: string;
    readonly path: string;
    readonly type?: PageType;
    readonly image?: string;
    readonly imageAlt?: string;
    readonly noindex?: boolean;
    readonly breadcrumbs?: ReadonlyArray<Breadcrumb>;
    readonly structuredData?: ReadonlyArray<JsonLdObject>;
}

const props: Props = Astro.props;
---
<!doctype html>
<html lang="en-GB" data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <ThemeInitialiser />
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
        <meta name="generator" content={Astro.generator} />

        <link rel="icon" sizes="48x48" type="image/png" href="/onixlabs/images/logo/logo-orb-48.png" />
        <link rel="icon" sizes="96x96" type="image/png" href="/onixlabs/images/logo/logo-orb-96.png" />
        <link rel="icon" sizes="any" type="image/svg+xml" href="/onixlabs/images/logo/logo-orb.svg" />
        <link rel="apple-touch-icon" href="/onixlabs/images/logo/logo-orb-180.png" />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- The body and headline weights, fetched with the page rather than once the stylesheet asks for them, so a first
             visit's hero isn't laid out again in Poppins halfway through its entrance. -->
        <link rel="preload" href={poppinsRegular} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={poppinsSemiBold} as="font" type="font/woff2" crossorigin />

        <Seo {...props} />
    </head>
    <body>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <SiteHeader />
        <main id="main-content" tabindex="-1">
            <slot />
        </main>
        <SiteFooter />
        <script>
            import '../scripts/main';
        </script>
    </body>
</html>
