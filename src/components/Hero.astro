---
import Aurora from './Aurora.astro';
import type { AuroraPalette } from './aurora-palette';
import type { HeroVariant } from './hero-variant';

// The opening of a page. Capstone: aurora light, display headline that slides up, product shot. Family: the
// product's colour block. Simple: a quiet heading for utility pages. The headline is the page's only <h1>.
interface Props {
    readonly variant?: HeroVariant;
    readonly label?: string;
    readonly title: string;
    readonly highlight?: string;
    readonly highlightStyle?: 'muted' | 'gradient';
    readonly palette?: AuroraPalette;
    readonly family?: string;
    readonly align?: 'start' | 'center';
    readonly headingLevel?: 'h1' | 'p';
}

const {
    variant = 'capstone',
    label,
    title,
    highlight,
    highlightStyle = 'gradient',
    palette = 'brand',
    family,
    align = 'start',
    headingLevel = 'h1',
}: Props = Astro.props;
const Heading: 'h1' | 'p' = headingLevel;
const hasMedia: boolean = Astro.slots.has('media');
---
<section class:list={['hero', `hero-${variant}`, `align-${align}`, { 'has-media': hasMedia, 'family-block': variant === 'family' }, family === undefined ? '' : `family-${family}`]}>
    {variant === 'capstone' && <Aurora palette={palette} />}
    <div class="hero-inner">
        <div class="hero-copy">
            {label !== undefined && <p class="label rise">{label}</p>}
            <Heading class:list={['hero-title', { display: variant === 'capstone' }]}>
                <span class="mask-line"><span>{title}</span></span>
                {highlight !== undefined && (
                    <span class="mask-line"><span class={highlightStyle === 'gradient' ? 'gradient-text' : 'headline-muted'}>{highlight}</span></span>
                )}
            </Heading>
            {Astro.slots.has('default') && <div class="lead rise rise-2"><slot /></div>}
            {Astro.slots.has('actions') && <div class="cluster hero-actions rise rise-3"><slot name="actions" /></div>}
        </div>
        {hasMedia && <div class="hero-media settle"><slot name="media" /></div>}
    </div>
</section>

<style>
    .hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding-block: clamp(4rem, 3rem + 6vw, 9rem) clamp(3.5rem, 2.5rem + 4vw, 6.5rem);
    }

    .hero-inner {
        display: grid;
        gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
        align-items: center;
        width: min(100% - 2 * var(--gutter), var(--container-wide));
        margin-inline: auto;
    }

    .hero.has-media.align-start .hero-inner {
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    }

    .hero-copy {
        display: grid;
        gap: 1.5rem;
        justify-items: start;
        max-width: 50rem;
    }

    .align-center .hero-copy {
        max-width: 72rem;
        justify-items: center;
        margin-inline: auto;
        text-align: center;
    }

    .align-center .hero-actions {
        justify-content: center;
    }

    .hero-title {
        color: var(--heading);
        font-family: var(--font-display);
        font-size: var(--text-5xl);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.04;
        text-wrap: balance;
    }

    .hero-title.display {
        font-size: var(--text-hero);
        letter-spacing: -0.05em;
        line-height: 0.98;
    }

    .hero-actions {
        margin-top: 0.5rem;
    }

    .hero-media {
        position: relative;
        display: grid;
        place-items: center;
    }

    .align-center .hero-media {
        margin-top: 1rem;
    }

    .hero-simple {
        padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) clamp(2rem, 1.5rem + 2vw, 3.5rem);
        border-bottom: 1px solid var(--border);
    }

    .hero-family {
        border-radius: 0;
    }
</style>
