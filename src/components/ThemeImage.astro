---
// Renders the light and dark variants of an image; CSS shows the one matching [data-bs-theme].
// Pass alt="" for decorative images. The hidden variant is also hidden from assistive technology.
interface Props {
    readonly light: string;
    readonly dark: string;
    readonly alt: string;
    readonly class?: string;
    readonly height?: number;
    readonly width?: number;
    readonly loading?: 'eager' | 'lazy';
    readonly fetchpriority?: 'high' | 'low' | 'auto';
}

const { light, dark, alt, class: className = '', height, width, loading = 'lazy', fetchpriority = 'auto' }: Props = Astro.props;
---
<img class:list={[className, 'theme-image-light']} src={light} alt={alt} height={height} width={width} loading={loading} decoding="async" fetchpriority={fetchpriority} />
<img class:list={[className, 'theme-image-dark']} src={dark} alt={alt} height={height} width={width} loading={loading} decoding="async" fetchpriority={fetchpriority} />
