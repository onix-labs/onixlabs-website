---
// A subtitle under a Headline. It's styled like the old <h2> but isn't a heading, so it stays out of the outline.
interface Props {
    readonly class?: string;
    readonly centered?: boolean;
}

const { class: className = '', centered = false }: Props = Astro.props;
---
<p class:list={['callout h2 fw-light', className, { 'text-center': centered }]}><slot /></p>

<style>
    .callout {
        color: var(--site-callout);
    }

    .callout.text-white-50 {
        color: rgba(var(--bs-white-rgb), 0.75);
    }
</style>
