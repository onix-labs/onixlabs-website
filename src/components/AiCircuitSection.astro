---
import { buildCircuitTracks } from './build-circuit-tracks';
import Button from './Button.astro';
import type { CircuitTrack } from './circuit-track';
import SectionHeader from './SectionHeader.astro';

// How ONIXLabs uses AI, beside a circuit board whose tracks run in from every side to an AI chip, carrying electrons.
// The board is two SVGs: the masked tracks and chip are static, and only the electrons repaint, because redrawing that
// mask every frame would be expensive. The electrons animate with SMIL, not CSS, because each one's keyframes depend on
// its track and passing those to CSS inline is ruled out by the Content Security Policy. Each is a head following the
// track and a tail that is a dash of the track itself, so it bends with the corners. Under reduced motion they're hidden
// and the board stands still. Colours are set as attributes, not in the CSS, because url(#id) in a stylesheet resolves
// against the stylesheet. /Engineering-With-AI opens with it, as level 1, with its own lead and actions.
interface Props {
    readonly level?: 1 | 2;
}

const { level = 2 }: Props = Astro.props;
const size: number = 1000;
const centre: number = size / 2;
const chipEdge: number = 112;
const tracks: ReadonlyArray<CircuitTrack> = buildCircuitTracks(centre, chipEdge);
const pins: ReadonlyArray<number> = [-75, -50, -25, 0, 25, 50, 75];
const turns: ReadonlyArray<number> = [0, 90, 180, 270];
const electrons: ReadonlyArray<CircuitTrack> = tracks.filter((track: CircuitTrack): boolean => track.electron);

// The glow behind the chip falls away exponentially, like a soft shadow, because a linear ramp shows a visible edge where
// it ends, especially in dark mode. SVG gradients have no easing, so the curve is sampled.
const glowRadius: number = 340;
const glowStrength: number = 0.85;
const glowFalloff: number = 3.4;
const glowStops: ReadonlyArray<{ readonly offset: string; readonly opacity: string }> = Array.from({ length: 19 }, (_: unknown, index: number) => {
    const distance: number = index / 18;
    const strength: number = (Math.exp(-glowFalloff * distance) - Math.exp(-glowFalloff)) / (1 - Math.exp(-glowFalloff));

    return { offset: round(distance), opacity: round(glowStrength * strength) };
});

// An electron crawls away from the far end and accelerates hard into the chip, its tail stretching with its speed. There
// it stops: its tail draws in behind it as it fades, and it rests out of sight for the rest of its cycle. Distance is
// sampled against time, because the head and tail must share the same keyframes to stay together.
const travelShare: number = 0.76;
const fadeShare: number = 0.14;
const acceleration: number = 7;
const longestTail: number = 0.2;
const sampleCount: number = 24;

// Sampled more finely towards the end, where the distance covered per step is greatest.
const samples: ReadonlyArray<number> = Array.from({ length: sampleCount + 1 }, (_: unknown, index: number): number => 1 - (1 - index / sampleCount) ** 2);

function round(value: number): string {
    return String(Math.round(value * 10000) / 10000);
}

function timeAt(distance: number): number {
    return distance ** (1 / acceleration) * travelShare;
}

function tailLength(sample: number): number {
    return 0.008 + longestTail * sample ** 5;
}

const arrived: number = travelShare + fadeShare;
const collapsed: number = tailLength(0);
const motionTimes: string = [...samples.map((sample: number): string => round(sample * travelShare)), round(arrived), '1'].join(';');
const motionPoints: string = [...samples.map((sample: number): string => round(sample ** acceleration)), '1', '1'].join(';');
const tailDash: string = [...samples.map(tailLength), collapsed, collapsed].map((length: number): string => `${round(length)} 3`).join(';');
const tailOffset: string = [...samples.map((sample: number): number => tailLength(sample) - sample ** acceleration), collapsed - 1, collapsed - 1].map(round).join(';');
const glowTimes: string = ['0', round(timeAt(0.5)), round(travelShare), round(arrived), '1'].join(';');
---
<section class="section ai-circuit" aria-labelledby="ai-title">
    <div class="container-wide ai-circuit-layout">
        <div class="board-slot">
    <div class="board" aria-hidden="true">
        <svg viewBox={`0 0 ${String(size)} ${String(size)}`} focusable="false">
            <defs>
                <linearGradient id="circuit-brand" gradientUnits="userSpaceOnUse" x1={String(centre)} y1="300" x2={String(centre)} y2="700">
                    <stop offset="0" class="stop-blue" />
                    <stop offset="0.5" class="stop-violet" />
                    <stop offset="1" class="stop-rose" />
                </linearGradient>
                <radialGradient id="circuit-fade" gradientUnits="userSpaceOnUse" cx={String(centre)} cy={String(centre)} r="425">
                    <stop offset="0.3" stop-color="#fff" />
                    <stop offset="1" stop-color="#000" />
                </radialGradient>
                <radialGradient id="circuit-glow" gradientUnits="userSpaceOnUse" cx={String(centre)} cy={String(centre)} r={String(glowRadius)}>
                    {glowStops.map((stop: { readonly offset: string; readonly opacity: string }) => (
                        <stop class="stop-violet" offset={stop.offset} stop-opacity={stop.opacity} />
                    ))}
                </radialGradient>
                <mask id="circuit-mask" maskUnits="userSpaceOnUse" x="0" y="0" width={String(size)} height={String(size)}>
                    <rect width={String(size)} height={String(size)} fill="url(#circuit-fade)" />
                </mask>
            </defs>

            <circle cx={String(centre)} cy={String(centre)} r={String(glowRadius)} fill="url(#circuit-glow)" />

            <g mask="url(#circuit-mask)">
                {tracks.map((track: CircuitTrack) => (
                    <path id={track.id} class="track" d={track.path} stroke="url(#circuit-brand)" />
                ))}
            </g>

            {turns.map((angle: number) => (
                <g transform={`rotate(${String(angle)} ${String(centre)} ${String(centre)})`}>
                    {pins.map((pin: number) => (
                        <rect x={String(centre + pin - 6)} y={String(centre - chipEdge - 2)} width="12" height="20" rx="3" fill="url(#circuit-brand)" />
                    ))}
                </g>
            ))}

            <g class="tone-dark">
                <rect class="chip" x={String(centre - 98)} y={String(centre - 98)} width="196" height="196" rx="26" stroke="url(#circuit-brand)" />
                <text class="chip-label" x={String(centre)} y={String(centre + 38)} text-anchor="middle">AI</text>
            </g>
        </svg>

        <svg class="electrons" viewBox={`0 0 ${String(size)} ${String(size)}`} focusable="false">
            <defs>
                <filter id="electron-bloom" filterUnits="userSpaceOnUse" x="0" y="0" width={String(size)} height={String(size)} color-interpolation-filters="sRGB">
                    <feGaussianBlur stdDeviation="8" result="bloom" />
                    <feMerge>
                        <feMergeNode in="bloom" />
                        <feMergeNode in="bloom" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>
            </defs>
            <g filter="url(#electron-bloom)">
                {electrons.map((track: CircuitTrack) => {
                    const timing: Record<string, string> = { dur: `${String(track.duration)}s`, begin: `${String(track.begin)}s`, repeatCount: 'indefinite' };

                    return (
                        <g class={`electron-${track.tone}`}>
                            <animate attributeName="opacity" {...timing} calcMode="spline" keyTimes={glowTimes} keySplines="0.7 0 0.9 0.5;0 0 1 1;0.3 0 0.7 1;0 0 1 1" values="0;1;1;0;0" />
                            <path class="electron-tail" d={track.path} pathLength="1">
                                <animate attributeName="stroke-dasharray" {...timing} keyTimes={motionTimes} values={tailDash} />
                                <animate attributeName="stroke-dashoffset" {...timing} keyTimes={motionTimes} values={tailOffset} />
                            </path>
                            <circle class="electron-head" r="6">
                                <animateMotion path={track.path} {...timing} keyTimes={motionTimes} keyPoints={motionPoints} />
                            </circle>
                        </g>
                    );
                })}
            </g>
        </svg>
    </div>
        </div>

        <div class="ai-circuit-content">
            <SectionHeader title="Engineering with AI" highlight="Proven in practice" highlightStyle="gradient" id="ai-title" level={level}>
                <slot name="lead">
                    We've embraced AI across our engineering, consulting and integration work, with a proven track record of turning it into
                    software that ships. ONIXLabs Studio, our agentic development environment, is that work in your hands.
                </slot>
            </SectionHeader>
            <div class="button-pair">
                <slot name="actions">
                    <Button href="/Engineering-With-AI" variant="primary" size="large" icon="info">Find out more</Button>
                    <Button href="/Contact?reason=consulting" variant="ghost" size="large" trailingIcon="arrow-right-bold">Talk to us about AI</Button>
                </slot>
            </div>
        </div>
    </div>
</section>

<style>
    .ai-circuit {
        isolation: isolate;
        overflow: hidden;
    }

    .ai-circuit-layout {
        display: grid;
        gap: 1rem;
    }

    .board-slot {
        position: relative;
        height: 24rem;
    }

    /* Just wider than its slot: the tracks fade out at 85% of the board, so they end at the slot's edges. */
    .board {
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: -1;
        width: min(30rem, 115vw);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
    }

    .board svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    /* The same fade as the tracks, so an electron emerges from nothing. */
    .electrons {
        -webkit-mask-image: radial-gradient(circle closest-side, #000 58%, transparent 85%);
        mask-image: radial-gradient(circle closest-side, #000 58%, transparent 85%);
    }

    .ai-circuit-content {
        display: grid;
        gap: 2rem;
    }

    .ai-circuit-content :global(.section-header) {
        max-width: none;
        margin-bottom: 0;
    }

    .ai-circuit-content :global(.gradient-text) {
        display: block;
    }

    /* Stacked, the pitch leads, centred, with the board beneath it. */
    @media (max-width: 59.99rem) {
        .ai-circuit-content {
            order: -1;
            justify-items: center;
            text-align: center;
        }
    }

    @media (min-width: 60rem) {
        .ai-circuit-layout {
            grid-template-columns: 2fr 3fr;
            gap: 4rem;
            align-items: center;
        }

        .board-slot {
            height: auto;
            aspect-ratio: 1;
        }

        .board {
            width: calc(100% / 0.85);
        }

        /* Keeps each phrase of the headline on one line in the narrower column. */
        .ai-circuit-content :global(h1),
        .ai-circuit-content :global(h2) {
            font-size: min(4.875rem, 5.4vw);
        }
    }

    .track {
        fill: none;
        stroke-width: 3;
        stroke-linecap: round;
    }

    .chip {
        fill: var(--bg-alt);
        stroke-width: 6;
    }

    .chip-label {
        fill: #fff;
        font-family: var(--font-display);
        font-size: 108px;
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .stop-blue { stop-color: var(--brand-blue); }
    .stop-violet { stop-color: var(--brand-violet); }
    .stop-rose { stop-color: var(--brand-rose); }

    .electron-blue { --electron: var(--brand-blue); }
    .electron-violet { --electron: var(--brand-violet); }
    .electron-rose { --electron: var(--brand-rose); }

    .electron-tail {
        fill: none;
        stroke: var(--electron);
        stroke-linecap: round;
        stroke-width: 4;
    }

    .electron-head {
        fill: #fff;
    }

    @media (prefers-reduced-motion: reduce) {
        .electrons {
            display: none;
        }
    }
</style>
