---
import type { CollectionEntry } from 'astro:content';

interface Props {
    readonly technologies: ReadonlyArray<CollectionEntry<'technologies'>>;
}

const { technologies }: Props = Astro.props;
const copies: ReadonlyArray<boolean> = [false, true];
---
<div class="marquee" role="region" aria-label="Technologies we work with">
    {copies.map((isCopy: boolean) => (
        <ul class="marquee-track" role="list" aria-hidden={isCopy ? 'true' : undefined}>
            {technologies.map((technology: CollectionEntry<'technologies'>) => (
                <li>
                    <a class="technology" href={technology.data.url} target="_blank" rel="noopener noreferrer" tabindex={isCopy ? -1 : undefined}>
                        <img src={technology.data.image} alt="" width={40} height={40} loading="lazy" decoding="async" />
                        <span>{technology.data.title}</span>
                        <span class="visually-hidden"> (opens in a new tab)</span>
                    </a>
                </li>
            ))}
        </ul>
    ))}
</div>

<style>
    .technology {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        color: var(--text-muted);
        font-family: var(--font-display);
        font-size: var(--text-lg);
        font-weight: 500;
        letter-spacing: -0.02em;
        text-decoration: none;
        white-space: nowrap;
        transition: color var(--duration);
    }

    .technology img {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 0.55rem;
        filter: grayscale(1);
        opacity: 0.7;
        transition: filter 400ms, opacity 400ms, transform 400ms var(--ease-out);
    }

    .technology:hover,
    .technology:focus-visible {
        color: var(--heading);
    }

    .technology:hover img,
    .technology:focus-visible img {
        filter: none;
        opacity: 1;
        transform: scale(1.1) rotate(-4deg);
    }
</style>
