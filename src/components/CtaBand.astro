---
import Button from './Button.astro';

// The closing call to action on most pages: the logo orb, one headline and two actions, centred on a quiet band.
interface Props {
    readonly title?: string;
    readonly primaryText?: string;
    readonly primaryHref?: string;
    readonly tone?: 'default' | 'alt' | 'dark';
}

const {
    title = 'Let’s build something that lasts.',
    primaryText = 'Send a message',
    primaryHref = '/Contact',
    tone = 'alt',
}: Props = Astro.props;
const calendlyUrl: string = 'https://calendly.com/matthew-layton/30min';
---
<section class:list={['section cta', `tone-${tone}`]} aria-labelledby="cta-title">
    <div class="container cta-inner reveal">
        <img class="cta-orb" src="/onixlabs/images/logo/logo-orb.svg" alt="" width={56} height={56} loading="lazy" decoding="async" />
        <h2 id="cta-title">{title}</h2>
        <p class="lead"><slot>Whether you have a question, need a custom solution, or just want to explore what’s possible, we’re just a message away.</slot></p>
        <div class="cluster is-centered cta-actions">
            <Button href={primaryHref} variant="primary" size="large">{primaryText}</Button>
            <Button href={calendlyUrl} variant="link" external>Book a meeting</Button>
        </div>
    </div>
</section>

<style>
    .cta-inner {
        display: grid;
        justify-items: center;
        gap: 1.25rem;
        text-align: center;
    }

    .cta-orb {
        width: 3.5rem;
        height: 3.5rem;
        margin-bottom: 0.5rem;
    }

    .cta h2 {
        font-size: var(--text-5xl);
    }

    .cta .lead {
        max-width: 40rem;
    }

    .cta-actions {
        margin-top: 1rem;
    }
</style>
