---
import Button from './Button.astro';
import PlatformDownload from './PlatformDownload.astro';
import { loadStudioRelease } from '../collections/load-studio-release';
import type { StudioRelease } from '../collections/studio-release';
import { studioScreens } from '../config/studio-screens';
import type { StudioScreen } from './studio-screen';

// The ONIXLabs Studio hero. On load the front window of a showcase drops into place while the headline and standfirst
// sharpen and rise out from behind it, then the windows waiting behind it fly out to either side. The showcase has one
// screen front and centre, with two waiting behind it on each side. On each beat the showcase scales up, blurs and
// fades away while the next screen takes its place, from the left and then from the right, and those behind move up.
// All CSS, apart from hold-first-showcase-turn.ts: under reduced motion (or without animation support) it holds its first arrangement. The background is grey
// at the top, melting into the header, and blooms into the full brand spectrum at the bottom.
//
// Every screenshot is lazy, so the other theme's variant never downloads; the first is fetched at high priority and the
// rest at low.
const releasesUrl: string = 'https://github.com/onix-labs/onixlabs-studio/releases';
const release: StudioRelease | undefined = await loadStudioRelease();
---
<section class="hero-bloom studio-hero" aria-labelledby="studio-title">
    <div class="studio-copy">
        <h1 id="studio-title" class="display studio-title blur-in">
            Every tool you need{' '}
            <span class="gradient-text">In one window</span>
        </h1>
        <p class="lead blur-in">
            An agentic development environment, where you and your AI agents work in the same project, the same terminals and
            the same editor. One window replaces an editor, a terminal, a git client and a handful of separate AI chats.
        </p>
    </div>

    <div class="showcase" role="group" aria-label="ONIXLabs Studio screens">
        {studioScreens.map((screen: StudioScreen, index: number) => (
            <figure class={`shot shot-${String(index)}`}>
                <img
                    class="shot-light"
                    src={`/onixlabs/images/studio/${screen.id}-l.webp`}
                    alt={screen.alt}
                    width={1712}
                    height={1112}
                    loading="lazy"
                    fetchpriority={index === 0 ? 'high' : 'low'}
                    decoding="async"
                />
                <img
                    class="shot-dark"
                    src={`/onixlabs/images/studio/${screen.id}-d.webp`}
                    alt={screen.alt}
                    width={1712}
                    height={1112}
                    loading="lazy"
                    fetchpriority={index === 0 ? 'high' : 'low'}
                    decoding="async"
                />
            </figure>
        ))}
    </div>

    <div class="button-pair studio-actions">
        <PlatformDownload release={release} releasesUrl={releasesUrl} />
        <Button href="/Products/Studio" variant="ghost" size="large" trailingIcon="arrow-right-bold">Find out more</Button>
    </div>
</section>

<style>
    .studio-hero {
        padding-block: clamp(3.5rem, 2.5rem + 5vw, 7rem) clamp(3rem, 2rem + 4vw, 5.5rem);
        overflow: clip;
    }

    /* Above the showcase, so a screen scaling away passes behind the text. */
    .studio-copy {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 1.4rem;
        justify-items: center;
        width: min(100% - 2 * var(--gutter), 76rem);
        margin-inline: auto;
        text-align: center;
    }

    .studio-title {
        --blur-delay: 250ms;
        --blur-rise: 9rem;
        color: var(--heading);
        font-family: var(--font-display);
        font-weight: 600;
    }

    .studio-title .gradient-text {
        display: block;
    }

    /* The full text colour rather than the muted one: the bloom reaches up behind this. */
    .studio-copy .lead {
        --blur-delay: 500ms;
        --blur-rise: 7.5rem;
        max-width: var(--lead-width);
        color: var(--text);
    }

    .showcase {
        display: grid;
        justify-items: center;
        align-items: center;
        margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
        perspective: 2000px;
        perspective-origin: 50% 50%;
    }

    /* --side is the side it waits on: -1 left, 1 right. */
    .shot {
        --side: 1;
        grid-area: 1 / 1;
        width: min(66%, 56rem);
        margin: 0;
        transform-origin: 50% 50%;
        opacity: 0;
    }

    .shot:nth-child(even) {
        --side: -1;
    }

    .shot img {
        width: 100%;
        height: auto;
    }

    :global([data-theme='light']) .shot-dark,
    :global([data-theme='dark']) .shot-light {
        display: none;
    }

    /* The first arrangement, which is also the static fallback. */
    .shot-0 { z-index: 4; transform: translate(0%, 0%) scale(1) rotateY(0deg); opacity: 1; }
    .shot-1, .shot-2 { z-index: 2; transform: translate(calc(var(--side) * 38%), 0%) scale(0.76) rotateY(calc(var(--side) * -14deg)); opacity: 1; filter: brightness(0.92); }
    .shot-3, .shot-4 { z-index: 1; transform: translate(calc(var(--side) * 55%), 0%) scale(0.62) rotateY(calc(var(--side) * -14deg)); opacity: 0.8; filter: brightness(0.8); }

    .studio-actions {
        position: relative;
        z-index: 1;
        margin: clamp(2rem, 1.5rem + 2vw, 3rem) auto 0;
    }

    /* Bare text on the strongest part of the bloom. */
    .studio-actions :global(.button-ghost) {
        --button-text: var(--text-on-bloom);
    }

    @media (max-width: 40rem) {
        .shot {
            width: 78%;
        }
    }

    /* Three equal buttons need more room than two. */
    @media (max-width: 68rem) {
        .studio-actions:has(:global(.platform-download-alternate:not([hidden]))) {
            grid-auto-flow: row;
        }
    }

    /*
     * Each of the ten screens runs the same fifty-second sequence of ten five-second beats, offset by its place in the
     * queue: waiting at the back for two beats, at the front for two, showcased for one, then gone for five. Because
     * screens alternate sides, a side only moves up every other beat. The z-index rises through the showcase beat so
     * the leaving screen stays above the one arriving.
     */
    /*
     * The entrance: the showcase fades in and pops down into place, then the copy rises out from behind it. The copy
     * only sits behind the showcase for the entrance, and moves back above it once it has landed. Filled backwards only,
     * so nothing stays in effect at rest to soften the text.
     */
    @media (prefers-reduced-motion: no-preference) {
        .studio-hero {
            --entrance-ease: cubic-bezier(0.85, 0, 0.15, 1);        /* A crawl, a rush, then a crawl. */
        }

        .studio-copy {
            --blur-duration: 1s;
            --blur-easing: var(--entrance-ease);
            animation: copy-behind 1.5s step-end backwards;
        }

        .showcase {
            animation: showcase-arrive 1s 250ms var(--entrance-ease) backwards;
        }

        .studio-actions {
            animation: actions-arrive 700ms 750ms var(--entrance-ease) backwards;
        }

        /* The waiting windows fly out from behind the front one once it has landed; `translate` leaves their turn's
           `transform` alone, and starting at their distance from the middle puts them directly behind it. */
        .shot {
            animation: showcase 50s cubic-bezier(0.65, 0, 0.35, 1) infinite both, shot-fly 1.6s var(--entrance-ease) backwards;
            animation-delay: var(--turn-delay), 1250ms;
        }

        .shot-0,
        .shot:nth-child(n + 6) { animation-name: showcase, none; }
        .shot-1, .shot-2 { --fly-from: -38%; }
        .shot-3, .shot-4 { --fly-from: -55%; }

        .shot-0 { --turn-delay: -25s; }
        .shot-1 { --turn-delay: -20s; }
        .shot-2 { --turn-delay: -15s; }
        .shot-3 { --turn-delay: -10s; }
        .shot-4 { --turn-delay: -5s; }
        .shot-5 { --turn-delay: 0s; }
        .shot-6 { --turn-delay: -45s; }
        .shot-7 { --turn-delay: -40s; }
        .shot-8 { --turn-delay: -35s; }
        .shot-9 { --turn-delay: -30s; }
    }

    @keyframes copy-behind {
        from { z-index: -1; }
    }

    @keyframes showcase-arrive {
        from { opacity: 0; transform: translateY(-6rem) scale(1.03); }
    }

    @keyframes shot-fly {
        from { translate: calc(var(--side) * var(--fly-from)) 0; visibility: hidden; }
    }

    @keyframes actions-arrive {
        from { opacity: 0; }
    }

    @keyframes showcase {
        0%, 7.2% { z-index: 1; transform: translate(calc(var(--side) * 64%), 0%) scale(0.5) rotateY(calc(var(--side) * -14deg)); opacity: 0; filter: blur(0px) brightness(0.8); }
        10%, 27.2% { z-index: 1; transform: translate(calc(var(--side) * 55%), 0%) scale(0.62) rotateY(calc(var(--side) * -14deg)); opacity: 0.8; filter: blur(0px) brightness(0.8); }
        30%, 47.2% { z-index: 2; transform: translate(calc(var(--side) * 38%), 0%) scale(0.76) rotateY(calc(var(--side) * -14deg)); opacity: 1; filter: blur(0px) brightness(0.92); }
        50% { z-index: 4; transform: translate(0%, 0%) scale(1) rotateY(0deg); opacity: 1; filter: blur(0px) brightness(1); }
        57.2% { z-index: 6; transform: translate(0%, 0%) scale(1) rotateY(0deg); opacity: 1; filter: blur(0px) brightness(1); }
        60% { z-index: 6; transform: translate(0%, 0%) scale(1.24) rotateY(0deg); opacity: 0; filter: blur(18px) brightness(1); }
        60.1%, 100% { z-index: 1; transform: translate(calc(var(--side) * 64%), 0%) scale(0.5) rotateY(calc(var(--side) * -14deg)); opacity: 0; filter: blur(0px) brightness(0.8); }
    }
</style>
