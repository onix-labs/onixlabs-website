---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { loadStudioRelease } from '../collections/load-studio-release';
import type { StudioRelease } from '../collections/studio-release';
import type { StudioScreen } from './studio-screen';

// The ONIXLabs Studio hero, after the Blazor site's Aero hero: grey at the top, melting into the header, blooming
// into the full brand spectrum at the bottom. The headline sharpens into place; below it Studio's screens turn in a
// cover-flow carousel, the current screen in front and its neighbours receding into depth on either side; the
// actions sit beneath. All CSS: under reduced motion (or without animation support) the carousel holds its first
// arrangement.
//
// The carousel's order and count are mirrored in the generated CSS (.shot-N, the coverflow keyframes); regenerate
// both together. Every screenshot is lazy, so the other theme's variant never downloads; the front screen is fetched
// at high priority and the rest at low.
//
// The download button links to the latest release's page; initialise-studio-download.ts swaps in the installer for
// the visitor's platform from the data-download-* attributes, which are looked up from GitHub at build time.
const screens: ReadonlyArray<StudioScreen> = [
    { id: 'mission-control', label: 'Mission Control', icon: 'rocket-launch', alt: 'Mission Control: two agents side by side, one waiting for permission to run a command' },
    { id: 'agent', label: 'Agents', icon: 'sparkle', alt: 'An agent tab answering a question, with its reasoning shown' },
    { id: 'workspace-split', label: 'Workbench', icon: 'layout', alt: 'The workbench split into panels: a project explorer, code side by side, and an agent' },
    { id: 'code', label: 'Code editor', icon: 'code', alt: 'The code editor with a terminal beneath it and an agent alongside' },
    { id: 'terminal', label: 'Terminals', icon: 'terminal-window', alt: 'A terminal session with an agent working in the same window' },
    { id: 'version-control', label: 'Source control', icon: 'git-branch', alt: 'Source control: branches, a commit graph and pending changes' },
    { id: 'history', label: 'History', icon: 'clock-counter-clockwise', alt: 'A file’s history with a side-by-side diff' },
    { id: 'docker', label: 'Containers', icon: 'shipping-container', alt: 'The container panel listing running containers and images' },
    { id: 'dbexplorer', label: 'Databases', icon: 'database', alt: 'The database explorer running a query against a table' },
    { id: 'binedit', label: 'Binary editor', icon: 'binary', alt: 'The binary editor showing a file byte by byte' },
    { id: 'markdown', label: 'Markdown', icon: 'markdown-logo', alt: 'The Markdown editor previewing a README' },
    { id: 'workspace', label: 'Workspace', icon: 'squares-four', alt: 'A workspace with the project explorer, editors and an agent' },
];
const releasesUrl: string = 'https://github.com/onix-labs/onixlabs-studio/releases';
const release: StudioRelease | undefined = await loadStudioRelease();
const repositoryUrl: string = 'https://github.com/onix-labs/onixlabs-studio';
---
<section class="studio-hero" aria-labelledby="studio-title">
    <div class="studio-copy">
        <h1 id="studio-title" class="display studio-title blur-in">
            Every tool you need
            <span class="gradient-text">In one studio</span>
        </h1>
        <p class="lead blur-in blur-in-2">
            An agentic development environment, where you and your AI agents work in the same project, the same terminals and
            the same editor. One window replaces an editor, a terminal, a git client and a handful of separate AI chats.
        </p>
    </div>

    <div class="carousel" aria-label="ONIXLabs Studio screens" role="group">
        <div class="carousel-track">
            {screens.map((screen: StudioScreen, index: number) => (
                <figure class={`shot shot-${String(index)}`}>
                    <img
                        class="shot-light"
                        src={`/onixlabs/images/studio/${screen.id}-light-1600.webp`}
                        srcset={`/onixlabs/images/studio/${screen.id}-light-960.webp 960w, /onixlabs/images/studio/${screen.id}-light-1600.webp 1600w`}
                        sizes="(min-width: 80rem) 52rem, 70vw"
                        alt={screen.alt}
                        width={1600}
                        height={1039}
                        loading="lazy"
                        fetchpriority={index === 0 ? 'high' : 'low'}
                        decoding="async"
                    />
                    <img
                        class="shot-dark"
                        src={`/onixlabs/images/studio/${screen.id}-dark-1600.webp`}
                        srcset={`/onixlabs/images/studio/${screen.id}-dark-960.webp 960w, /onixlabs/images/studio/${screen.id}-dark-1600.webp 1600w`}
                        sizes="(min-width: 80rem) 52rem, 70vw"
                        alt={screen.alt}
                        width={1600}
                        height={1039}
                        loading="lazy"
                        fetchpriority={index === 0 ? 'high' : 'low'}
                        decoding="async"
                    />
                </figure>
            ))}
        </div>
    </div>

    <div class="cluster is-centered studio-actions">
        <a
            class="button button-primary button-large"
            href={release?.pageUrl ?? releasesUrl}
            data-studio-download
            data-download-macos={release?.macOSAppleSilicon}
            data-download-windows={release?.windows}
            data-download-linux={release?.linux}
        >
            <Icon name="download-simple" />
            <span data-download-label>Download the beta</span>
        </a>
        <Button href={repositoryUrl} size="large" icon="github-logo" external>View on GitHub</Button>
    </div>
</section>

<style>
    /*
     * The bloom: the page grey holds solid behind the headline, then gives way to the full brand spectrum, which is
     * at full strength along the bottom edge.
     */
    .studio-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding-block: clamp(3.5rem, 2.5rem + 5vw, 7rem) clamp(3rem, 2rem + 4vw, 5.5rem);
        background:
            linear-gradient(to bottom, var(--bg) 0%, var(--bg) 34%, color-mix(in srgb, var(--bg) 0%, transparent) 100%),
            var(--brand-gradient);
    }

    .studio-copy {
        display: grid;
        gap: 1.4rem;
        justify-items: center;
        width: min(100% - 2 * var(--gutter), 76rem);
        margin-inline: auto;
        text-align: center;
    }

    .studio-title {
        color: var(--heading);
        font-family: var(--font-display);
        font-weight: 600;
    }

    .studio-title .gradient-text {
        display: block;
        padding-bottom: 0.06em;
    }

    .studio-copy .lead {
        max-width: 54rem;
    }

    /* The carousel: a 3D stage; each screen moves through the same sequence of positions, offset in time. */
    .carousel {
        position: relative;
        margin: clamp(2.5rem, 2rem + 3vw, 4.5rem) auto 0;
        width: min(100%, 84rem);
        perspective: 1800px;
        perspective-origin: 50% 100%;
    }

    .carousel-track {
        display: grid;
        justify-items: center;
        align-items: end;
        transform-style: preserve-3d;
    }

    .shot {
        grid-area: 1 / 1;
        width: min(68%, 54rem);
        margin: 0;
        transform-origin: 50% 100%;
        transform-style: preserve-3d;
        will-change: transform, opacity, filter;
    }

    .shot img {
        width: 100%;
        height: auto;
    }

    :global([data-theme='light']) .shot-dark,
    :global([data-theme='dark']) .shot-light {
        display: none;
    }

    /* The first arrangement, which is also the static fallback. */
    .shot-0 { transform: translateX(0%) translateZ(0px) rotateY(0deg); opacity: 1; filter: blur(0px) brightness(1); }
    .shot-1 { transform: translateX(44%) translateZ(-280px) rotateY(-20deg); opacity: 0.9; filter: blur(0.4px) brightness(0.92); }
    .shot-2 { transform: translateX(74%) translateZ(-560px) rotateY(-28deg); opacity: 0.55; filter: blur(1.5px) brightness(0.85); }
    .shot-3 { transform: translateX(96%) translateZ(-820px) rotateY(-32deg); opacity: 0; filter: blur(3px) brightness(0.8); }
    .shot-4 { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
    .shot-5 { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
    .shot-6 { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
    .shot-7 { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
    .shot-8 { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
    .shot-9 { transform: translateX(-96%) translateZ(-820px) rotateY(32deg); opacity: 0; filter: blur(3px) brightness(0.8); }
    .shot-10 { transform: translateX(-74%) translateZ(-560px) rotateY(28deg); opacity: 0.55; filter: blur(1.5px) brightness(0.85); }
    .shot-11 { transform: translateX(-44%) translateZ(-280px) rotateY(20deg); opacity: 0.9; filter: blur(0.4px) brightness(0.92); }

    @media (prefers-reduced-motion: no-preference) {
        .shot {
            animation: coverflow 48s cubic-bezier(0.65, 0, 0.35, 1) infinite both;
        }

        .carousel:hover .shot {
            animation-play-state: paused;
        }

        .shot-0 { animation-delay: -24s; }
        .shot-1 { animation-delay: -20s; }
        .shot-2 { animation-delay: -16s; }
        .shot-3 { animation-delay: -12s; }
        .shot-4 { animation-delay: -8s; }
        .shot-5 { animation-delay: -4s; }
        .shot-6 { animation-delay: 0s; }
        .shot-7 { animation-delay: -44s; }
        .shot-8 { animation-delay: -40s; }
        .shot-9 { animation-delay: -36s; }
        .shot-10 { animation-delay: -32s; }
        .shot-11 { animation-delay: -28s; }
    }

    .studio-actions {
        margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    }

    @media (max-width: 40rem) {
        .shot {
            width: 84%;
        }
    }

    @keyframes coverflow {
        0.000%, 6.000% { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
        8.333%, 14.333% { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
        16.667%, 22.667% { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
        25.000%, 31.000% { transform: translateX(96%) translateZ(-820px) rotateY(-32deg); opacity: 0; filter: blur(3px) brightness(0.8); }
        33.333%, 39.333% { transform: translateX(74%) translateZ(-560px) rotateY(-28deg); opacity: 0.55; filter: blur(1.5px) brightness(0.85); }
        41.667%, 47.667% { transform: translateX(44%) translateZ(-280px) rotateY(-20deg); opacity: 0.9; filter: blur(0.4px) brightness(0.92); }
        50.000%, 56.000% { transform: translateX(0%) translateZ(0px) rotateY(0deg); opacity: 1; filter: blur(0px) brightness(1); }
        58.333%, 64.333% { transform: translateX(-44%) translateZ(-280px) rotateY(20deg); opacity: 0.9; filter: blur(0.4px) brightness(0.92); }
        66.667%, 72.667% { transform: translateX(-74%) translateZ(-560px) rotateY(28deg); opacity: 0.55; filter: blur(1.5px) brightness(0.85); }
        75.000%, 81.000% { transform: translateX(-96%) translateZ(-820px) rotateY(32deg); opacity: 0; filter: blur(3px) brightness(0.8); }
        83.333%, 89.333% { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
        91.667%, 97.667% { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
        100% { transform: translateX(0%) translateZ(-1100px) rotateY(0deg); opacity: 0; filter: blur(4px) brightness(0.8); }
    }
</style>
