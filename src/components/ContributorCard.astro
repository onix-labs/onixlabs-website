---
import type { CollectionEntry } from 'astro:content';

import Icon from './Icon.astro';

interface Props {
    readonly contributor: CollectionEntry<'contributors'>;
}

const { contributor }: Props = Astro.props;
const { name, jobTitle, teaser, photo, path, gitHubUrl, linkedInUrl }: CollectionEntry<'contributors'>['data'] = contributor.data;
---
<article class="tile contributor reveal-scale">
    <div class="contributor-photo">
        <img src={photo} alt={`Portrait of ${name}`} width={640} height={640} loading="lazy" decoding="async" />
    </div>
    <div class="contributor-body">
        <h3><a class="contributor-link" href={path}>{name}</a></h3>
        <p class="contributor-role">{jobTitle}</p>
        <p class="contributor-teaser">{teaser}</p>
        <ul class="contributor-social" role="list">
            <li>
                <a href={gitHubUrl} target="_blank" rel="noopener noreferrer">
                    <Icon name="github-logo" />
                    <span class="visually-hidden">{name} on GitHub (opens in a new tab)</span>
                </a>
            </li>
            <li>
                <a href={linkedInUrl} target="_blank" rel="noopener noreferrer">
                    <Icon name="linkedin-logo" />
                    <span class="visually-hidden">{name} on LinkedIn (opens in a new tab)</span>
                </a>
            </li>
        </ul>
    </div>
</article>

<style>
    .contributor {
        display: flex;
        flex-direction: column;
        height: 100%;
        transition: transform 500ms var(--ease-out);
    }

    .contributor:hover {
        transform: scale(1.012);
    }

    .contributor-photo {
        aspect-ratio: 1;
        overflow: hidden;
    }

    .contributor-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 900ms var(--ease-out);
    }

    .contributor:hover .contributor-photo img {
        transform: scale(1.04);
    }

    .contributor-body {
        display: grid;
        gap: 0.3rem;
        padding: 1.5rem 1.5rem 1.6rem;
    }

    .contributor-body h3 {
        font-size: var(--text-xl);
    }

    .contributor-link {
        color: var(--heading);
    }

    .contributor-link:hover {
        text-decoration: none;
    }

    /* The whole tile is the link target; the social links sit above it. */
    .contributor-link::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .contributor:has(.contributor-link:focus-visible) {
        outline: 2px solid var(--focus);
        outline-offset: 3px;
    }

    .contributor-link:focus-visible {
        outline: none;
    }

    .contributor-role {
        color: var(--text-muted);
        font-size: var(--text-sm);
        font-weight: 600;
    }

    .contributor-teaser {
        margin-top: 0.5rem;
        color: var(--text-muted);
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    .contributor-social {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 0.25rem;
        margin-top: 0.75rem;
        margin-left: -0.5rem;
    }

    .contributor-social a {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        color: var(--text-muted);
        transition: color var(--duration), background-color var(--duration);
    }

    .contributor-social a:hover {
        background: color-mix(in srgb, var(--heading) 8%, transparent);
        color: var(--heading);
    }
</style>
