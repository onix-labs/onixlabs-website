---
import type { CollectionEntry } from 'astro:content';

import Icon from './Icon.astro';

interface Props {
    readonly contributor: CollectionEntry<'contributors'>;
}

const { contributor }: Props = Astro.props;
const { name, jobTitle, teaser, photo, path, gitHubUrl, linkedInUrl }: CollectionEntry<'contributors'>['data'] = contributor.data;
---
<article class="card contributor reveal">
    <div class="contributor-photo">
        <img src={photo} alt={`Portrait of ${name}`} width={640} height={640} loading="lazy" decoding="async" />
    </div>
    <div class="contributor-body">
        <h3><a class="contributor-link" href={path}>{name}</a></h3>
        <p class="contributor-role">{jobTitle}</p>
        <p class="contributor-teaser">{teaser}</p>
        <ul class="contributor-social" role="list">
            <li>
                <a href={gitHubUrl} target="_blank" rel="noopener noreferrer">
                    <Icon name="github" />
                    <span class="visually-hidden">{name} on GitHub (opens in a new tab)</span>
                </a>
            </li>
            <li>
                <a href={linkedInUrl} target="_blank" rel="noopener noreferrer">
                    <Icon name="linkedin" />
                    <span class="visually-hidden">{name} on LinkedIn (opens in a new tab)</span>
                </a>
            </li>
        </ul>
    </div>
</article>

<style>
    .contributor {
        display: flex;
        flex-direction: column;
    }

    .contributor-photo {
        position: relative;
        aspect-ratio: 1;
        overflow: hidden;
    }

    .contributor-photo::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--surface) 0%, transparent 45%);
    }

    .contributor-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.05);
        transform: scale(1.02);
        transition: filter 600ms var(--ease-out), transform 800ms var(--ease-out);
    }

    .contributor:hover .contributor-photo img,
    .contributor:focus-within .contributor-photo img {
        filter: grayscale(0);
        transform: scale(1.06);
    }

    .contributor-body {
        display: grid;
        gap: 0.35rem;
        padding: 0 1.5rem 1.5rem;
        margin-top: -1rem;
        position: relative;
    }

    .contributor-link {
        color: var(--heading);
        text-decoration: none;
    }

    /* The whole card is the link target; the social links sit above it. */
    .contributor-link::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .contributor:has(.contributor-link:focus-visible) {
        outline: 2px solid var(--focus);
        outline-offset: 3px;
    }

    .contributor-link:focus-visible {
        outline: none;
    }

    .contributor-role {
        background: var(--brand-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        justify-self: start;
    }

    .contributor-teaser {
        margin-top: 0.4rem;
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    .contributor-social {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }

    .contributor-social a {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text-muted);
        transition: color var(--duration), border-color var(--duration);
    }

    .contributor-social a:hover {
        border-color: var(--border-strong);
        color: var(--heading);
    }
</style>
