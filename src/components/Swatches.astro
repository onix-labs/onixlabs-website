---
// The eight brand swatches: the logo gradient broken into its stops. Decorative.
interface Props {
    readonly class?: string;
}

const { class: className = '' }: Props = Astro.props;
const stops: ReadonlyArray<number> = [1, 2, 3, 4, 5, 6, 7, 8];
---
<div class:list={['swatches', className]} aria-hidden="true">
    {stops.map(() => <span></span>)}
</div>
