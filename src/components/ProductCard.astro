---
import type { CollectionEntry } from 'astro:content';

import Icon from './Icon.astro';

// A product tile that links to its page, led by the product's emblem.
interface Props {
    readonly product: CollectionEntry<'products'>;
    readonly showOverview?: boolean;
}

const { product, showOverview = false }: Props = Astro.props;
---
<a class={`tile product-card family-${product.data.family.id} reveal-scale`} href={product.data.path}>
    <span class="emblem product-emblem" aria-hidden="true">
        <img src={product.data.icon} alt="" width={96} height={96} loading="lazy" decoding="async" />
    </span>
    <h3>{product.data.shortTitle}<span class="visually-hidden"> ({product.data.title})</span></h3>
    <p class="product-hook">{product.data.hook}</p>
    {showOverview && <p class="product-overview">{product.data.overview ?? product.data.summary}</p>}
    <span class="link-cta product-link">Learn more <Icon name="caret-right" /></span>
</a>

<style>
    .product-card {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        height: 100%;
        padding: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    }

    .product-emblem {
        --emblem-size: 4.5rem;
        --emblem-stroke: 0.6px;
        margin-bottom: 1rem;
        transition: transform 600ms var(--ease-out);
    }

    .product-card:hover .product-emblem {
        transform: scale(1.06);
    }

    .product-card h3 {
        font-size: var(--text-2xl);
        letter-spacing: -0.022em;
    }

    .product-hook {
        color: var(--text);
        font-size: var(--text-base);
    }

    .product-overview {
        color: var(--text-muted);
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    .product-link {
        margin-top: auto;
        padding-top: 0.75rem;
        font-size: var(--text-base);
    }
</style>
