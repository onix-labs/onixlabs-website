---
import Icon from './Icon.astro';

// A call to action (Stride): the monochrome primary, a raised surface button (secondary), danger, a button wearing
// the turning ONIXLabs brand gradient (spectral), bare content with no surface (ghost), or a "Learn more ›" text link
// (link). Buttons carry no leading icon; `trailingIcon` follows the text, for the arrow on a ghost button.
interface Props {
    readonly href: string;
    readonly variant?: 'primary' | 'secondary' | 'danger' | 'spectral' | 'ghost' | 'link';
    readonly size?: 'small' | 'default' | 'large';
    readonly trailingIcon?: string;
    readonly external?: boolean;
    readonly class?: string;
}

const { href, variant = 'secondary', size = 'default', trailingIcon, external = false, class: className = '' }: Props = Astro.props;
const isLink: boolean = variant === 'link';
---
<a
    class:list={[
        isLink ? 'link-cta' : 'button',
        { 'button-primary': variant === 'primary', 'button-danger': variant === 'danger', 'button-spectral': variant === 'spectral', 'button-ghost': variant === 'ghost', 'button-large': size === 'large' && !isLink, 'button-small': size === 'small' && !isLink },
        className,
    ]}
    href={href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
>
    <span><slot /></span>
    {trailingIcon !== undefined && <Icon name={trailingIcon} class="button-trailing-icon" />}
    {isLink &&<Icon name={external ? 'arrow-square-out' : 'caret-right'} />}
    {external && <span class="visually-hidden"> (opens in a new tab)</span>}
</a>
