---
import { isCurrentPath } from '../config/is-current-path';
import { navigation } from '../config/navigation';
import type { NavigationItem } from '../config/navigation-item';
import { toCanonicalPath } from '../config/to-canonical-path';
import Icon from './Icon.astro';

const currentPath: string = Astro.url.pathname;
---
<header class="site-header">
    <div class="header-inner">
        <a class="brand" href="/">
            <img class="brand-logo brand-logo-light" src="/onixlabs/images/logo/logo-full-light.webp" alt="ONIXLabs home" width={153} height={29} />
            <img class="brand-logo brand-logo-dark" src="/onixlabs/images/logo/logo-full-dark.webp" alt="ONIXLabs home" width={153} height={29} />
        </a>

        <nav class="primary-nav" aria-label="Main">
            <ul role="list">
                {navigation.map((item: NavigationItem) => (
                    <li>
                        <a class="nav-link" href={toCanonicalPath(item.path)} aria-current={isCurrentPath(item, currentPath) ? 'page' : undefined}>{item.label}</a>
                    </li>
                ))}
            </ul>
        </nav>

        <div class="header-actions">
            <button id="theme-toggle" class="header-icon theme-toggle" type="button" role="switch" aria-checked="true" aria-label="Dark mode">
                <Icon name="sun" class="theme-icon-sun" />
                <Icon name="moon" class="theme-icon-moon" />
            </button>
            <button class="header-icon menu-button" type="button" popovertarget="mobile-menu" aria-label="Toggle navigation">
                <Icon name="list" />
            </button>
        </div>
    </div>

    <div class="header-progress scroll-progress" aria-hidden="true"></div>

    <div id="mobile-menu" class="mobile-menu" popover>
        <nav aria-label="Mobile">
            <ul role="list">
                {navigation.map((item: NavigationItem) => (
                    <li>
                        <a href={toCanonicalPath(item.path)} aria-current={isCurrentPath(item, currentPath) ? 'page' : undefined}>{item.label}</a>
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</header>

<style>
    /*
     * The brand spectrum along the bottom of the header. It's painted at full width and uncovered from left to
     * right as the page scrolls, so each colour stays put and more of the spectrum appears. It stays hidden where
     * it can't be scroll-driven (where effects.css drives it), so it never sits under the header as a fixed rule.
     */
    .header-progress {
        position: absolute;
        inset: auto 0 0;
        height: 2px;
        background: var(--brand-gradient);
        visibility: hidden;
    }

    @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
            .header-progress {
                visibility: visible;
            }
        }
    }

    /* A thin, translucent bar that stays at the top while the page scrolls beneath it. */
    .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--header-bg);
        color: var(--header-text);
    }

    /* Pages with a local navigation bar let the global bar scroll away, as the local one takes over. */
    :global(html:has(.local-nav)) .site-header {
        position: relative;
    }

    .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        width: min(100% - 2 * var(--gutter), 64rem);
        height: var(--header-height);
        padding-block: var(--space-2);
        margin-inline: auto;
    }

    .brand {
        display: flex;
        flex: none;
        border-radius: 4px;
        opacity: 0.92;
        transition: opacity var(--duration);
    }

    .brand:hover {
        opacity: 1;
    }

    .brand-logo {
        width: auto;
        height: 1.5rem;
    }

    :global([data-theme='light']) .brand-logo-dark,
    :global([data-theme='dark']) .brand-logo-light {
        display: none;
    }

    .primary-nav {
        margin-left: auto;
    }

    .primary-nav ul {
        display: flex;
        justify-content: flex-end;
        gap: 0.25rem;
    }

    .nav-link {
        display: block;
        padding: 0.35rem 0.75rem;
        color: var(--header-text);
        font-size: 0.8rem;
        letter-spacing: -0.005em;
        opacity: 0.8;
        transition: opacity var(--duration);
    }

    .nav-link:hover,
    .nav-link[aria-current='page'] {
        opacity: 1;
        text-decoration: none;
    }

    .nav-link[aria-current='page'] {
        font-weight: 600;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .header-icon {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: var(--header-text);
        font-size: 0.875rem;
        opacity: 0.8;
        transition: opacity var(--duration), background-color var(--duration);
    }

    .header-icon:hover {
        opacity: 1;
        background: color-mix(in srgb, var(--header-text) 8%, transparent);
    }

    .theme-toggle :global(.icon) {
        grid-area: 1 / 1;
        transition: opacity 300ms, transform 500ms var(--ease-out);
    }

    .theme-toggle[aria-checked='true'] :global(.theme-icon-sun),
    .theme-toggle[aria-checked='false'] :global(.theme-icon-moon) {
        opacity: 0;
        transform: rotate(-90deg) scale(0.5);
    }

    .menu-button {
        display: none;
    }

    .mobile-menu {
        inset: var(--header-height) 0 auto;
        width: 100%;
        max-width: none;
        min-height: calc(100dvh - var(--header-height));
        margin: 0;
        padding: 1.5rem var(--gutter) 3rem;
        border: 0;
        background: var(--bg);
        color: var(--text);
    }

    .mobile-menu::backdrop {
        background: transparent;
    }

    .mobile-menu ul {
        display: grid;
        gap: 0.25rem;
    }

    .mobile-menu a {
        display: block;
        padding: 0.4rem 0.5rem;
        color: var(--heading);
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -0.025em;
    }

    .mobile-menu a:hover {
        text-decoration: none;
        color: var(--text-muted);
    }

    .mobile-menu a[aria-current='page'] {
        color: var(--text-muted);
    }

    @media (prefers-reduced-motion: no-preference) {
        .mobile-menu:popover-open li {
            animation: rise 500ms var(--ease-out) both;
        }

        .mobile-menu:popover-open li:nth-child(2) { animation-delay: 30ms; }
        .mobile-menu:popover-open li:nth-child(3) { animation-delay: 60ms; }
        .mobile-menu:popover-open li:nth-child(4) { animation-delay: 90ms; }
        .mobile-menu:popover-open li:nth-child(5) { animation-delay: 120ms; }
    }

    @media (max-width: 48rem) {
        .primary-nav {
            display: none;
        }

        .menu-button {
            display: grid;
        }
    }
</style>
