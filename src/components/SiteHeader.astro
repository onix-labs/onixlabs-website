---
import { isCurrentPath } from '../config/is-current-path';
import { navigation } from '../config/navigation';
import type { NavigationItem } from '../config/navigation-item';
import Icon from './Icon.astro';
import ThemeImage from './ThemeImage.astro';

const currentPath: string = Astro.url.pathname;
---
<header>
    <nav class="navbar navbar-expand-lg fixed-top py-2 py-md-3" id="navbar" aria-label="Main">
        <div class="container">
            <a class="navbar-brand" href="/">
                <ThemeImage
                    light="/onixlabs/images/logo/logo-full-light.svg"
                    dark="/onixlabs/images/logo/logo-full-dark.svg"
                    alt="ONIXLabs home"
                    height={32}
                    width={170}
                    loading="eager"
                />
            </a>
            <button
                class="navbar-toggler border-0"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbar-menu"
                aria-controls="navbar-menu"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <Icon name="bars" />
            </button>
            <div class="collapse navbar-collapse" id="navbar-menu">
                <ul class="navbar-nav ms-auto gap-2">
                    {navigation.map((item: NavigationItem) => {
                        const isCurrent: boolean = isCurrentPath(item, currentPath);
                        return (
                            <li class="nav-item">
                                <a class:list={['nav-link', { active: isCurrent }]} href={item.path} aria-current={isCurrent ? 'page' : undefined}>
                                    {item.label}
                                </a>
                            </li>
                        );
                    })}
                </ul>
                <button
                    id="theme-toggle"
                    class="theme-toggle d-flex flex-row align-items-center shadow-sm ms-lg-4 my-2 my-lg-0"
                    type="button"
                    role="switch"
                    aria-checked="false"
                    aria-label="Dark mode"
                >
                    <span class="theme-toggle-button"></span>
                </button>
            </div>
        </div>
    </nav>
</header>

<style>
    .navbar {
        transition: background-color 0.3s ease, box-shadow 0.3s ease, border-bottom 0.3s ease;
        background-color: var(--site-body-bg);
        border-bottom: 1px solid transparent;
    }

    .navbar:global(.scrolled) {
        background-color: var(--site-navbar-bg);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border-bottom-color: var(--site-navbar-border);
    }

    .theme-toggle {
        background: var(--site-card-bg);
        border: none;
        border-top: 0.1rem solid var(--site-card-border-top);
        border-bottom: 0.1rem solid var(--site-card-border-bottom);
        border-radius: 50rem;
        padding: 0.1rem 0.2rem 0.2rem;
        width: 3rem;
        cursor: pointer;
    }

    .theme-toggle[aria-checked='true'] {
        flex-direction: row-reverse !important;
    }

    .theme-toggle-button {
        background: rgba(var(--bs-secondary-rgb), 1);
        border-radius: 100%;
        width: 1.25rem;
        height: 1.25rem;
    }
</style>
