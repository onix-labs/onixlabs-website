---
import Button from './Button.astro';
import GlassBand from './GlassBand.astro';

// One package on a family's root page, in a GlassBand of its own: its name as the eyebrow, a two-part headline, a
// standfirst and the points that explain it, then links to its product page when there is one, its reference and its
// registry.
interface Props {
    readonly name: string;
    readonly glass: string;
    readonly title: string;
    readonly highlight: string;
    readonly summary: string;
    readonly points: ReadonlyArray<{ readonly title: string; readonly body: string }>;
    readonly pagePath?: string | undefined;
    readonly docsUrl: string;
    readonly registryUrl: string;
    readonly registry: string;
    readonly alternate?: boolean;
    readonly reversed?: boolean;
}

const { name, glass, title, highlight, summary, points, pagePath, docsUrl, registryUrl, registry, alternate = false, reversed = false }: Props =
    Astro.props;
const id: string = name.toLowerCase().replaceAll('.', '-');
---
<GlassBand id={id} eyebrow={name} glass={glass} title={title} highlight={highlight} summary={summary} points={points} alternate={alternate} reversed={reversed}>
    {pagePath !== undefined && <Button href={pagePath} variant="ghost" trailingIcon="arrow-right-bold">Find out more</Button>}
    <Button href={docsUrl} variant="link" external>API reference</Button>
    <Button href={registryUrl} variant="link" external>{registry}</Button>
</GlassBand>
