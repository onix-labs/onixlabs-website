---
// The top of every inner page: an eyebrow, the page's <h1> (with an optional second phrase in grey or the gradient, on
// its own line when it's the gradient), a lead, actions, and optional media shown large beneath the copy, the way a
// product is the hero of the page.
interface Props {
    readonly eyebrow?: string;
    readonly title: string;
    readonly highlight?: string;
    readonly highlightStyle?: 'muted' | 'gradient';
    readonly tone?: 'default' | 'alt' | 'dark';
    readonly align?: 'center' | 'start';
    readonly class?: string;
}

const { eyebrow, title, highlight, highlightStyle = 'muted', tone = 'default', align = 'center', class: className = '' }: Props = Astro.props;
---
<section class:list={['page-hero', `align-${align}`, { 'tone-alt': tone === 'alt', 'tone-dark': tone === 'dark', 'has-media': Astro.slots.has('media') }, className]}>
    <div class="container page-hero-copy">
        {Astro.slots.has('before') && <div class="rise"><slot name="before" /></div>}
        {eyebrow !== undefined && <p class="eyebrow rise">{eyebrow}</p>}
        <h1 class="rise">{title}{highlight !== undefined && <Fragment> <span class={highlightStyle === 'gradient' ? 'gradient-text' : 'headline-muted'}>{highlight}</span></Fragment>}</h1>
        {Astro.slots.has('default') && <div class="lead page-hero-lead rise rise-2"><slot /></div>}
        {Astro.slots.has('actions') && <div class="cluster page-hero-actions rise rise-3"><slot name="actions" /></div>}
    </div>
    {Astro.slots.has('media') && <div class="page-hero-media"><slot name="media" /></div>}
</section>

<style>
    .page-hero {
        position: relative;
        padding-block: clamp(4rem, 2.5rem + 6vw, 8rem) clamp(4rem, 3rem + 4vw, 7rem);
        background: var(--bg);
        overflow: clip;
    }

    .page-hero.tone-alt {
        background: var(--bg-alt);
    }

    /* Above the media, so anything spilling from it passes behind the actions. */
    .page-hero-copy {
        position: relative;
        z-index: 1;
        display: grid;
        gap: 1.25rem;
    }

    .align-center .page-hero-copy {
        justify-items: center;
        text-align: center;
    }

    .page-hero h1 {
        max-width: 18ch;
        font-size: var(--text-hero);
        letter-spacing: -0.035em;
        line-height: 1.02;
    }

    .page-hero h1 :global(.gradient-text) {
        display: block;
    }

    .page-hero h1:has(:global(.gradient-text)) {
        max-width: none;
    }

    .page-hero-lead {
        max-width: var(--lead-width);
        margin-top: 0.5rem;
    }

    .page-hero-lead :global(p + p) {
        margin-top: 1rem;
    }

    .page-hero-actions {
        margin-top: 1rem;
    }

    .align-center .page-hero-actions {
        justify-content: center;
    }

    .page-hero-media {
        display: grid;
        place-items: center;
        margin-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    }
</style>
