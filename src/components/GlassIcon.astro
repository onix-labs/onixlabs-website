---
// One of the 3D glass icons in public/onixlabs/images/icons/glass, in the variant that matches the theme, or with
// `aura`, its pre-rendered glow (scripts/generate-auras.ts). Decorative by default: the heading beside it names the idea.
interface Props {
    readonly name: string;
    readonly size?: number;
    readonly alt?: string;
    readonly aura?: boolean;
    readonly class?: string;
}

const { name, size = 96, alt = '', aura = false, class: className = '' }: Props = Astro.props;
const file: string = aura ? `${name}-aura` : name;
---
<span class:list={['glass-icon', className]}>
    <img class="glass-light" src={`/onixlabs/images/icons/glass/${file}.webp`} alt={alt} width={size} height={size} loading="lazy" decoding="async" />
    <img class="glass-dark" src={`/onixlabs/images/icons/glass/${file}-dark.webp`} alt={alt} width={size} height={size} loading="lazy" decoding="async" />
</span>

<style>
    .glass-icon {
        display: inline-grid;
    }

    .glass-icon img {
        grid-area: 1 / 1;
        width: 100%;
        height: auto;
    }

    :global([data-theme='light']) .glass-dark,
    :global([data-theme='dark']) .glass-light,
    :global([data-theme] .tone-dark) .glass-light {
        display: none;
    }

    :global([data-theme] .tone-dark) .glass-dark {
        display: block;
    }
</style>
