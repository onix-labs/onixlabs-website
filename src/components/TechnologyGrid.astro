---
import type { CollectionEntry } from 'astro:content';

// The technologies we work with, as a calm grid of logos with their names.
interface Props {
    readonly technologies: ReadonlyArray<CollectionEntry<'technologies'>>;
}

const { technologies }: Props = Astro.props;
---
<ul class="technologies" role="list" aria-label="Technologies we work with">
    {technologies.map((technology: CollectionEntry<'technologies'>) => (
        <li class="reveal-scale">
            <a class="technology" href={technology.data.url} target="_blank" rel="noopener noreferrer">
                <img src={technology.data.image} alt="" width={40} height={40} loading="lazy" decoding="async" />
                <span>{technology.data.title}</span>
                <span class="visually-hidden"> (opens in a new tab)</span>
            </a>
        </li>
    ))}
</ul>

<style>
    .technologies {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--tile-gap);
    }

    @media (min-width: 40rem) {
        .technologies {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @media (min-width: 64rem) {
        .technologies {
            grid-template-columns: repeat(6, 1fr);
        }
    }

    .technology {
        display: grid;
        justify-items: center;
        gap: 0.85rem;
        padding: clamp(1.25rem, 1rem + 1vw, 1.75rem) 0.5rem;
        border-radius: var(--radius);
        background: var(--surface);
        color: var(--text-muted);
        font-size: var(--text-sm);
        text-align: center;
        transition: color var(--duration), transform 500ms var(--ease-out);
    }

    .technology:hover {
        color: var(--heading);
        text-decoration: none;
        transform: scale(1.04);
    }

    .technology img {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
    }
</style>
