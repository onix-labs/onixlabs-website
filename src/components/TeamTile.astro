---
import Icon from './Icon.astro';

// A person: portrait that turns from greyscale to colour on hover (and is in colour where there's no hover), name, role
// as a label in their accent colour, and links.
interface Props {
    readonly name: string;
    readonly jobTitle: string;
    readonly accent?: 'blue' | 'rose' | 'coral' | 'teal';
    readonly photo: string;
    readonly href: string;
    readonly teaser?: string;
    readonly gitHubUrl?: string;
    readonly linkedInUrl?: string;
}

const { name, jobTitle, accent, photo, href, teaser, gitHubUrl, linkedInUrl }: Props = Astro.props;
---
<article class:list={['tile team-tile reveal-scale', accent !== undefined && `accent-${accent}`]}>
    <div class="team-photo">
        <img src={photo} alt={`Portrait of ${name}`} width={640} height={640} loading="lazy" decoding="async" />
    </div>
    <div class="team-body">
        <h3><a class="team-link" href={href}>{name}</a></h3>
        <p class="team-role">{jobTitle}</p>
        {teaser !== undefined && <p class="team-teaser">{teaser}</p>}
        <ul class="team-social" role="list">
            {gitHubUrl !== undefined && (
                <li><a class="social-github" href={gitHubUrl} target="_blank" rel="noopener noreferrer"><Icon name="github-logo" /><span class="visually-hidden">{name} on GitHub (opens in a new tab)</span></a></li>
            )}
            {linkedInUrl !== undefined && (
                <li><a class="social-linkedin" href={linkedInUrl} target="_blank" rel="noopener noreferrer"><Icon name="linkedin-logo" /><span class="visually-hidden">{name} on LinkedIn (opens in a new tab)</span></a></li>
            )}
        </ul>
    </div>
</article>

<style>
    /* The inks rather than the brand colours themselves: the title is small text, and the inks are deepened to AA on the
       bands. The tile's surface is lighter than the dark band, so there each colour is lifted as far as it must be to
       clear 4.5:1 against it (tokens.css records the surface colours). */
    .accent-blue { --team-accent: var(--ink-blue); }
    .accent-rose { --team-accent: var(--ink-rose); }
    .accent-coral { --team-accent: var(--ink-coral); }
    .accent-teal { --team-accent: var(--ink-teal); }

    :global([data-theme='dark']) .accent-blue { --team-accent: color-mix(in srgb, var(--brand-blue), #fff 36%); }
    :global([data-theme='dark']) .accent-rose { --team-accent: color-mix(in srgb, var(--brand-rose), #fff 30%); }
    :global([data-theme='dark']) .accent-coral { --team-accent: color-mix(in srgb, var(--brand-coral), #fff 14%); }
    :global([data-theme='dark']) .accent-teal { --team-accent: color-mix(in srgb, var(--brand-teal), #fff 6%); }

    .team-tile {
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-tile);
    }

    /* A mask, not an overlay of the tile's colour: an overlay leaves the photo's edge showing on a fractional pixel. */
    .team-photo {
        aspect-ratio: 1;
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to top, transparent 2%, #000 45%);
        mask-image: linear-gradient(to top, transparent 2%, #000 45%);
    }

    .team-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.05);
        transform: scale(1.02);
        transition: filter 600ms var(--ease-out), transform 800ms var(--ease-out);
    }

    /* True grey reads warm beside the masonry's blue-tinted greys, so this gives the portrait the tile's own hue. A layer
       rather than a filter, which would swing the skin tones through blue on the way to colour. */
    .team-photo::after {
        content: '';
        position: absolute;
        inset: 0;
        background: var(--surface);
        mix-blend-mode: color;
        pointer-events: none;
        transition: opacity 600ms var(--ease-out);
    }

    .team-tile:hover .team-photo::after,
    .team-tile:focus-within .team-photo::after {
        opacity: 0;
    }

    .team-tile:hover .team-photo img,
    .team-tile:focus-within .team-photo img {
        filter: grayscale(0);
        transform: scale(1.06);
    }

    @media (hover: none) {
        .team-photo::after {
            display: none;
        }

        .team-photo img {
            filter: none;
        }
    }

    .team-body {
        position: relative;
        display: grid;
        gap: 0.35rem;
        margin-top: -1.25rem;
        padding: 0 1.5rem 1.5rem;
    }

    .team-body h3 {
        font-size: var(--text-xl);
    }

    .team-link {
        color: var(--heading);
        text-decoration: none;
    }

    /* The whole tile is the link to the profile; the social links sit above it. */
    .team-link::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .team-tile:has(.team-link:focus-visible) {
        outline: 2px solid var(--focus);
        outline-offset: 3px;
    }

    .team-link:focus-visible {
        outline: none;
    }

    .team-role {
        justify-self: start;
        color: var(--team-accent, var(--label));
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .team-teaser {
        margin-top: 0.35rem;
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    .team-social {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }

    .team-social a {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 999px;
        text-decoration: none;
        transition: background-color var(--duration);
    }

    .social-github {
        background: var(--bg);
        color: var(--heading);
    }

    .social-github:hover {
        background: color-mix(in srgb, var(--bg) 88%, #000);
    }

    .social-linkedin {
        background: var(--brand-blue);
        color: #fff;
    }

    .social-linkedin:hover {
        background: color-mix(in srgb, var(--brand-blue) 85%, #000);
    }
</style>
