---
import Icon from './Icon.astro';

// A person: portrait that turns from greyscale to colour on hover, name, role as a coral label, and links.
interface Props {
    readonly name: string;
    readonly jobTitle: string;
    readonly photo: string;
    readonly href: string;
    readonly teaser?: string;
    readonly gitHubUrl?: string;
    readonly linkedInUrl?: string;
}

const { name, jobTitle, photo, href, teaser, gitHubUrl, linkedInUrl }: Props = Astro.props;
---
<article class="tile team-tile reveal-scale">
    <div class="team-photo">
        <img src={photo} alt={`Portrait of ${name}`} width={640} height={640} loading="lazy" decoding="async" />
    </div>
    <div class="team-body">
        <h3><a class="team-link" href={href}>{name}</a></h3>
        <p class="team-role">{jobTitle}</p>
        {teaser !== undefined && <p class="team-teaser">{teaser}</p>}
        <ul class="team-social" role="list">
            {gitHubUrl !== undefined && (
                <li><a href={gitHubUrl} target="_blank" rel="noopener noreferrer"><Icon name="github-logo" /><span class="visually-hidden">{name} on GitHub (opens in a new tab)</span></a></li>
            )}
            {linkedInUrl !== undefined && (
                <li><a href={linkedInUrl} target="_blank" rel="noopener noreferrer"><Icon name="linkedin-logo" /><span class="visually-hidden">{name} on LinkedIn (opens in a new tab)</span></a></li>
            )}
        </ul>
    </div>
</article>

<style>
    .team-tile {
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-tile);
    }

    .team-photo {
        position: relative;
        aspect-ratio: 1;
        overflow: hidden;
    }

    .team-photo::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--surface) 0%, transparent 45%);
    }

    .team-photo img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(1) contrast(1.05);
        transform: scale(1.02);
        transition: filter 600ms var(--ease-out), transform 800ms var(--ease-out);
    }

    .team-tile:hover .team-photo img,
    .team-tile:focus-within .team-photo img {
        filter: grayscale(0);
        transform: scale(1.06);
    }

    .team-body {
        position: relative;
        display: grid;
        gap: 0.35rem;
        margin-top: -1.25rem;
        padding: 0 1.5rem 1.5rem;
    }

    .team-body h3 {
        font-size: var(--text-xl);
    }

    .team-link {
        color: var(--heading);
        text-decoration: none;
    }

    /* The whole tile is the link to the profile; the social links sit above it. */
    .team-link::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .team-tile:has(.team-link:focus-visible) {
        outline: 2px solid var(--focus);
        outline-offset: 3px;
    }

    .team-link:focus-visible {
        outline: none;
    }

    .team-role {
        justify-self: start;
        color: var(--label);
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .team-teaser {
        margin-top: 0.35rem;
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    .team-social {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }

    .team-social a {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--text-muted);
        text-decoration: none;
        transition: color var(--duration), border-color var(--duration);
    }

    .team-social a:hover {
        border-color: var(--border-strong);
        color: var(--heading);
    }
</style>
