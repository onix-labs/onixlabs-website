---
import Aurora from './Aurora.astro';
import type { AuroraPalette } from './aurora-palette';

// A capstone product presented on a near-black tile with its aurora, in both themes: label, headline,
// standfirst, actions, and a product shot that settles into frame.
interface Props {
    readonly label: string;
    readonly title: string;
    readonly highlight?: string;
    readonly palette?: AuroraPalette;
    readonly layout?: 'stacked' | 'split';
    readonly headingLevel?: 'h2' | 'h3';
}

const { label, title, highlight, palette = 'brand', layout = 'split', headingLevel = 'h2' }: Props = Astro.props;
const Heading: 'h2' | 'h3' = headingLevel;
---
<article class:list={['tile capstone tone-dark reveal-scale', `capstone-${layout}`]}>
    <Aurora palette={palette} />
    <div class="capstone-copy">
        <p class="label">{label}</p>
        <Heading class="capstone-title">{title}{highlight !== undefined && <Fragment> <span class="gradient-text">{highlight}</span></Fragment>}</Heading>
        {Astro.slots.has('default') && <div class="lead"><slot /></div>}
        {Astro.slots.has('actions') && <div class="cluster"><slot name="actions" /></div>}
    </div>
    {Astro.slots.has('media') && <div class="capstone-media settle"><slot name="media" /></div>}
</article>

<style>
    .capstone {
        display: grid;
        gap: 2.5rem;
        align-items: center;
        padding: clamp(2rem, 1.5rem + 3vw, 4.5rem);
        border-radius: var(--radius-xl);
        isolation: isolate;
    }

    .capstone :global(.aurora) {
        -webkit-mask-image: none;
        mask-image: none;
    }

    @media (min-width: 56rem) {
        .capstone-split {
            grid-template-columns: 1fr 1.15fr;
        }
    }

    .capstone-stacked {
        text-align: center;
        justify-items: center;
    }

    .capstone-stacked .cluster {
        justify-content: center;
    }

    .capstone-copy {
        display: grid;
        gap: 1.25rem;
        justify-items: inherit;
        max-width: 38rem;
    }

    .capstone-title {
        color: var(--heading);
        font-family: var(--font-display);
        font-size: var(--text-4xl);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.04;
    }

    .capstone .lead {
        font-size: var(--text-lg);
    }

    .capstone-media {
        display: grid;
        place-items: center;
    }
</style>
