---
import GlassIcon from './GlassIcon.astro';

// A library or smaller product: its emblem (or its glass icon, when it has one), name, a one-line pitch and a link. The
// whole tile is the link.
interface Props {
    readonly href: string;
    readonly name: string;
    readonly pitch: string;
    readonly icon: string;
    readonly glass?: string | undefined;
    readonly family: string;
    readonly label?: string;
}

const { href, name, pitch, icon, glass, family, label }: Props = Astro.props;
---
<a class:list={['tile product-tile reveal-scale', `family-${family}`]} href={href}>
    {glass === undefined
        ? <span class="emblem"><img src={icon} alt="" width={64} height={64} loading="lazy" decoding="async" /></span>
        : <GlassIcon name={glass} size={64} class="product-glass" />}
    <span class="product-text">
        {label !== undefined && <span class="label label-muted">{label}</span>}
        <span class="product-name">{name}</span>
        <span class="product-pitch">{pitch}</span>
    </span>
</a>

<style>
    .product-tile {
        --emblem-size: 3.5rem;
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
        padding: 1.5rem;
        box-shadow: var(--shadow-tile);
        color: var(--text);
    }

    .product-tile:hover {
        box-shadow: var(--shadow-tile-hover);
    }

    .product-tile :global(.product-glass) {
        flex: none;
        width: 4rem;
        margin: -0.25rem 0 -0.25rem -0.25rem;
    }

    .product-text {
        display: grid;
        gap: 0.3rem;
    }

    .product-name {
        color: var(--heading);
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: 600;
        letter-spacing: -0.025em;
    }

    .product-pitch {
        color: var(--text-muted);
        font-size: var(--text-sm);
        line-height: 1.5;
    }
</style>
