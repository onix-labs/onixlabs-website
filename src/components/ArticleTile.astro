---
import Icon from './Icon.astro';

// A documentation page or blog post: category, title, summary and reading time. The whole tile is the link.
interface Props {
    readonly href: string;
    readonly category: string;
    readonly title: string;
    readonly summary: string;
    readonly minutes?: number;
}

const { href, category, title, summary, minutes }: Props = Astro.props;
---
<a class="tile article-tile reveal-scale" href={href}>
    <span class="label">{category}</span>
    <span class="article-title">{title}</span>
    <span class="article-summary">{summary}</span>
    {minutes !== undefined && <span class="article-meta"><Icon name="clock" /> {minutes} min read</span>}
</a>

<style>
    .article-tile {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding: 1.75rem;
        box-shadow: var(--shadow-tile);
        color: var(--text);
    }

    .article-tile:hover {
        box-shadow: var(--shadow-tile-hover);
    }

    .article-title {
        color: var(--heading);
        font-family: var(--font-display);
        font-size: var(--text-2xl);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.15;
    }

    .article-summary {
        color: var(--text-muted);
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    .article-meta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: auto;
        padding-top: 0.5rem;
        color: var(--text-muted);
        font-size: var(--text-xs);
    }
</style>
