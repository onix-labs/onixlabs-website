---
interface Props {
    readonly class?: string;
    readonly centered?: boolean;
    readonly labelledBy?: string;
}

const { class: className = '', centered = false, labelledBy }: Props = Astro.props;
---
<section class:list={['py-5', className]} aria-labelledby={labelledBy}>
    <div class:list={['container', { 'text-center': centered }]}>
        <slot />
    </div>
</section>
