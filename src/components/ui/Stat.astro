---
// A single metric (Stride's Stat): a label, a prominent value and an optional caption for context or trend. The
// `value` slot overrides the `value` prop when the figure needs markup (a unit, a badge).
interface Props {
    readonly label: string;
    readonly value?: string;
    readonly caption?: string;
    readonly class?: string;
}

const { label, value = '', caption, class: className = '' }: Props = Astro.props;
---
<div class:list={['stat', className]}>
    <div class="stat-label">{label}</div>
    <div class="stat-value">{Astro.slots.has('value') ? <slot name="value" /> : value}</div>
    {caption !== undefined && <div class="stat-caption">{caption}</div>}
</div>

<style>
    .stat {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .stat-label {
        color: var(--text-muted);
        font-size: var(--text-sm);
    }

    .stat-value {
        color: var(--text);
        font-size: var(--text-2xl);
        font-weight: var(--weight-bold);
        line-height: var(--leading-tight);
        font-variant-numeric: tabular-nums;
    }

    .stat-caption {
        color: var(--text-muted);
        font-size: var(--text-xs);
    }
</style>
