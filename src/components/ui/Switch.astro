---
// A labelled on/off switch (Stride's Switch): a real <input type="checkbox" role="switch">, visually hidden, followed
// by a pill track whose thumb slides across when it is on. Screen readers announce it as a switch that is on or off.
// Help text or an error (which replaces the help) sits below the label and is wired with aria-describedby.
interface Props {
    readonly id: string;
    readonly name: string;
    readonly label: string;
    readonly value?: string;
    readonly checked?: boolean;
    readonly required?: boolean;
    readonly disabled?: boolean;
    readonly help?: string;
    readonly error?: string;
    readonly class?: string;
}

const { id, name, label, value, checked = false, required = false, disabled = false, help, error, class: className = '' }: Props = Astro.props;
const description: string | undefined = error !== undefined ? `${id}-error` : help !== undefined ? `${id}-help` : undefined;
---
<div class:list={['choice', className]}>
    <label class:list={['switch', { 'is-disabled': disabled }]}>
        <input
            class="switch-input"
            type="checkbox"
            role="switch"
            id={id}
            name={name}
            value={value}
            checked={checked}
            required={required}
            disabled={disabled}
            aria-describedby={description}
            aria-invalid={error !== undefined ? 'true' : undefined}
        />
        <span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span>
        <span class="switch-label">{label}{required && <span class="required" aria-hidden="true"> *</span>}</span>
    </label>
    {error !== undefined && <p class="field-error choice-description" id={`${id}-error`}>{error}</p>}
    {error === undefined && help !== undefined && <p class="field-hint choice-description" id={`${id}-help`}>{help}</p>}
</div>

<style>
    .choice {
        display: grid;
        gap: var(--space-1);
        justify-items: start;
    }

    .switch {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        cursor: pointer;
    }

    .switch-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 1px;
        height: 1px;
        margin: 0;
        opacity: 0;
    }

    /* Off is the secondary intent and on the primary, as in Stride; both clear 3:1 against the page. */
    .switch-track {
        display: inline-flex;
        align-items: center;
        flex: none;
        width: 2.25rem;
        height: 1.25rem;
        padding: 2px;
        border-radius: var(--radius-pill);
        corner-shape: round;
        background-color: var(--secondary);
        transition: background-color var(--transition);
    }

    .switch-thumb {
        width: 1rem;
        height: 1rem;
        border-radius: var(--radius-pill);
        corner-shape: round;
        background-color: var(--surface);
        box-shadow: var(--shadow-sm);
        transition: transform var(--transition);
    }

    .switch-input:checked + .switch-track {
        background-color: var(--primary);
    }

    .switch-input:checked + .switch-track .switch-thumb {
        transform: translateX(1rem);
    }

    .switch-input[aria-invalid='true'] + .switch-track {
        box-shadow: 0 0 0 2px var(--danger);
    }

    /* The site's 2px focus outline, in place of Stride's translucent focus shadow. */
    .switch-input:focus-visible + .switch-track {
        outline: 2px solid var(--focus);
        outline-offset: 2px;
    }

    .switch-label {
        color: var(--text);
        font-size: var(--text-base);
    }

    .required {
        color: var(--text-muted);
    }

    .is-disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .choice-description {
        padding-inline-start: calc(2.25rem + var(--space-2));
    }
</style>
