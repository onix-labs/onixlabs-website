---
import type { TooltipPlacement } from './tooltip-placement';

// Stride's Tooltip: wraps a target and reveals a short text label on hover or keyboard focus, in pure CSS.
//
// The bubble is the target's description, so give the target aria-describedby={id} when it is interactive (a button
// or link). For a target that isn't focusable by itself (a badge, an icon), set focusable: the target is then wrapped
// in a plain button, described by the bubble, so keyboard users can reach it. Keep tooltips to a few words that are
// never essential.
interface Props {
    readonly id: string;
    readonly text: string;
    readonly placement?: TooltipPlacement;
    readonly focusable?: boolean;
    readonly class?: string;
}

const { id, text, placement = 'top', focusable = false, class: className }: Props = Astro.props;
---
<span class:list={['tooltip', className]}>
    {focusable ? <button type="button" class="tooltip-target" aria-describedby={id}><slot /></button> : <slot />}
    <span class:list={['tooltip-bubble', `tooltip-bubble-${placement}`]} id={id} role="tooltip">{text}</span>
</span>

<style>
    .tooltip {
        position: relative;
        display: inline-flex;
    }

    .tooltip-target {
        display: inline-flex;
        padding: 0;
        border: none;
        background: none;
        cursor: default;
    }

    .tooltip-bubble {
        position: absolute;
        z-index: var(--z-overlay);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-sm);
        corner-shape: var(--corner-shape);
        background-color: var(--text);
        color: var(--surface);
        font-size: var(--text-xs);
        font-weight: var(--weight-normal);
        line-height: var(--leading-normal);
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        transition: opacity var(--transition), visibility var(--transition);
    }

    /* Bridges the gap to the target, so the pointer can move onto the bubble without it closing (WCAG 1.4.13). */
    .tooltip-bubble::before {
        content: '';
        position: absolute;
        inset: calc(var(--space-2) * -1);
    }

    /* Placement: the edge of the target the bubble sits on. */
    .tooltip-bubble-top {
        bottom: calc(100% + var(--space-2));
        left: 50%;
        transform: translateX(-50%);
    }

    .tooltip-bubble-bottom {
        top: calc(100% + var(--space-2));
        left: 50%;
        transform: translateX(-50%);
    }

    .tooltip-bubble-start {
        top: 50%;
        inset-inline-end: calc(100% + var(--space-2));
        transform: translateY(-50%);
    }

    .tooltip-bubble-end {
        top: 50%;
        inset-inline-start: calc(100% + var(--space-2));
        transform: translateY(-50%);
    }

    .tooltip:hover .tooltip-bubble,
    .tooltip:has(:focus-visible) .tooltip-bubble {
        opacity: 1;
        visibility: visible;
    }
</style>
