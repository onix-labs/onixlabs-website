---
// Joins an input and its addons (a prefix or suffix, or a button) into one control (Stride's InputGroup), labelled
// like a FormField. Put the pieces in the slot as direct children: a bare TextInput, NumberInput or Select (no
// `label`, so it renders just the control), <span class="input-group-addon"> for fixed text, and a
// <button class="button"> for an action. Only the outer corners stay rounded. `for` is the id of the input the label
// names; give that input describedBy="<for>-help" (or "<for>-error" and `invalid`) to link the text below, plus the
// addon's id when the addon is part of the value, such as a unit or a URL prefix.
interface Props {
    readonly for: string;
    readonly label: string;
    readonly help?: string | undefined;
    readonly error?: string | undefined;
    readonly required?: boolean;
    readonly class?: string;
}

const { for: controlId, label, help, error, required = false, class: className = '' }: Props = Astro.props;
---
<div class:list={['field', className]}>
    <label for={controlId}>{label}{required && <span class="required" aria-hidden="true"> *</span>}</label>
    <div class="input-group">
        <slot />
    </div>
    {error !== undefined && <p class="field-error" id={`${controlId}-error`}>{error}</p>}
    {error === undefined && help !== undefined && <p class="field-hint" id={`${controlId}-help`}>{help}</p>}
</div>

<style>
    .required {
        color: var(--text-muted);
    }

    .input-group {
        display: flex;
        align-items: stretch;
    }

    .input-group > :global(*) {
        border-radius: 0;
    }

    .input-group > :global(:first-child) {
        border-top-left-radius: var(--radius-sm);
        border-bottom-left-radius: var(--radius-sm);
        corner-top-left-shape: var(--corner-shape);
        corner-bottom-left-shape: var(--corner-shape);
    }

    .input-group > :global(:last-child) {
        border-top-right-radius: var(--radius-sm);
        border-bottom-right-radius: var(--radius-sm);
        corner-top-right-shape: var(--corner-shape);
        corner-bottom-right-shape: var(--corner-shape);
    }

    /* The input takes the remaining width; when focused it sits above its neighbours so its ring isn't covered. */
    .input-group > :global(.input) {
        flex: 1 1 auto;
        width: auto;
        min-width: 0;
    }

    .input-group > :global(.input:focus-visible) {
        position: relative;
        z-index: 1;
    }

    /* Fixed text. Stride sets it in --text-muted, which falls short of 4.5:1 on the addon fill, so it uses --text. */
    .input-group > :global(.input-group-addon) {
        display: inline-flex;
        align-items: center;
        padding: 0 var(--space-3);
        border: var(--border-width) solid var(--field-border);
        background-color: var(--surface-alt);
        color: var(--text);
        font-size: var(--text-base);
        white-space: nowrap;
    }

    /* A button joined into the group drops the standalone lift and its transitions. */
    .input-group > :global(.button) {
        transition: none;
    }

    .input-group > :global(.button:hover),
    .input-group > :global(.button:active) {
        transform: none;
    }

    .input-group > :global(.button:focus-visible) {
        position: relative;
        z-index: 1;
    }
</style>
