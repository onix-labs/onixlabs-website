---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import { loadPolicies } from '../collections/load-policies';
import { loadProductFamilies } from '../collections/load-product-families';
import { policyGroups } from '../config/policy-groups';
import type { PolicyGroup } from '../config/policy-group';
import { site } from '../config/site';
import type { SocialLink } from '../config/social-link';
import Icon from './Icon.astro';

const currentYear: number = new Date().getFullYear();
const families: ReadonlyArray<CollectionEntry<'productFamilies'>> = await loadProductFamilies();
const libraryPages: ReadonlyArray<CollectionEntry<'libraryPages'>> = await getCollection('libraryPages');
const policies: ReadonlyArray<CollectionEntry<'policies'>> = await loadPolicies();
const footerLinks: ReadonlyArray<SocialLink> = site.socialLinks.filter((link: SocialLink): boolean => link.isInFooter);

function policiesIn(group: PolicyGroup): ReadonlyArray<CollectionEntry<'policies'>> {
    return policies.filter((policy: CollectionEntry<'policies'>): boolean => policy.data.group === group.id);
}

// A family's root page, or its tile on /Products until it has one.
function familyHref(family: CollectionEntry<'productFamilies'>): string {
    return libraryPages.find((page: CollectionEntry<'libraryPages'>): boolean => page.id === family.id)?.data.path ?? `/Products/#${family.id}`;
}
---
<footer class="site-footer">
    <div class="container-wide">
        <div class="footer-grid">
            <div class="footer-brand">
                <img class="footer-logo footer-logo-light" src="/onixlabs/images/logo/logo-full-light.webp" alt="ONIXLabs" width={153} height={29} loading="lazy" />
                <img class="footer-logo footer-logo-dark" src="/onixlabs/images/logo/logo-full-dark.webp" alt="ONIXLabs" width={153} height={29} loading="lazy" />
                <p class="footer-tagline">Think beyond code. Build beyond limits.</p>
                <ul class="social" role="list">
                    {footerLinks.map((link: SocialLink) => (
                        <li>
                            <a href={link.url} target="_blank" rel="noopener noreferrer">
                                <Icon name={link.icon} />
                                <span class="visually-hidden">{site.name} on {link.name} (opens in a new tab)</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <nav class="footer-column" aria-labelledby="footer-products">
                <h2 id="footer-products">Products</h2>
                <ul role="list">
                    <li><a href="/Products/Studio">ONIXLabs Studio</a></li>
                    <li><a href="/Products/Aero">Aero</a></li>
                    {families.map((family: CollectionEntry<'productFamilies'>) => (
                        <li><a href={familyHref(family)}>{family.data.name} libraries</a></li>
                    ))}
                </ul>
            </nav>

            <nav class="footer-column" aria-labelledby="footer-company">
                <h2 id="footer-company">Company</h2>
                <ul role="list">
                    <li><a href="/Consulting">Consulting</a></li>
                    <li><a href="/Engineering-With-AI">Engineering with AI</a></li>
                    <li><a href="/Documentation/">Documentation</a></li>
                    <li><a href="/About">About</a></li>
                    <li><a href="/Contact">Contact</a></li>
                    <li><a href="/Legal/Company-Information">Company Information</a></li>
                </ul>
            </nav>

            {policyGroups.map((group: PolicyGroup) => (
                <nav class="footer-column" aria-labelledby={`footer-${group.id}`}>
                    <h2 id={`footer-${group.id}`}>{group.name}</h2>
                    <ul role="list">
                        {policiesIn(group).map((policy: CollectionEntry<'policies'>) => (
                            <li><a href={policy.data.path}>{policy.data.shortTitle ?? policy.data.title}</a></li>
                        ))}
                    </ul>
                </nav>
            ))}
        </div>

        <p class="footer-copyright">&copy; {site.foundingYear}&ndash;{currentYear} {site.name}. All rights reserved.</p>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: auto;
        --text-muted: var(--footer-text-muted);

        padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem) 2rem;
        background: var(--footer-bg);
        color: var(--text-muted);
        font-size: var(--text-xs);
        line-height: 1.5;
    }

    .footer-grid {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    }

    .footer-brand {
        display: grid;
        gap: 1rem;
        align-content: start;
        grid-column: 1 / -1;
        max-width: 22rem;
    }

    @media (min-width: 56rem) {
        .footer-grid {
            grid-template-columns: 1.6fr repeat(5, 1fr);
        }

        .footer-brand {
            grid-column: auto;
        }
    }

    .footer-logo {
        width: auto;
        height: 1.1rem;
    }

    /* The company tagline, tucked under the logo. */
    .footer-tagline {
        margin-top: -0.4rem;
        color: var(--heading);
        font-weight: 600;
    }

    :global([data-theme='light']) .footer-logo-dark,
    :global([data-theme='dark']) .footer-logo-light {
        display: none;
    }

    .social {
        display: flex;
        gap: 0.25rem;
        margin-left: -0.5rem;
    }

    .social a {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        color: var(--text-muted);
        font-size: 0.95rem;
        transition: color var(--duration), background-color var(--duration);
    }

    .social a:hover {
        background: color-mix(in srgb, var(--heading) 8%, transparent);
        color: var(--heading);
    }

    .footer-column h2 {
        margin-bottom: 0.75rem;
        color: var(--heading);
        font-family: var(--font-body);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0;
    }

    .footer-column ul {
        display: grid;
        gap: 0.6rem;
    }

    .footer-column a {
        color: var(--text-muted);
    }

    .footer-column a:hover {
        color: var(--heading);
    }

    .footer-copyright {
        margin-top: 2.5rem;
    }
</style>
