---
import type { CollectionEntry } from 'astro:content';

import { loadContributors } from '../collections/load-contributors';
import { loadProductFamilies } from '../collections/load-product-families';
import { site } from '../config/site';
import type { SocialLink } from '../config/social-link';
import Icon from './Icon.astro';

const currentYear: number = new Date().getFullYear();
const families: ReadonlyArray<CollectionEntry<'productFamilies'>> = await loadProductFamilies();
const contributors: ReadonlyArray<CollectionEntry<'contributors'>> = await loadContributors();
---
<footer class="site-footer tone-alt">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <img class="footer-logo footer-logo-light" src="/onixlabs/images/logo/logo-full-light.webp" alt="ONIXLabs" width={153} height={29} loading="lazy" />
                <img class="footer-logo footer-logo-dark" src="/onixlabs/images/logo/logo-full-dark.webp" alt="ONIXLabs" width={153} height={29} loading="lazy" />
                <p>Enterprise software engineering for .NET, Kotlin, the JVM and Corda: platforms, libraries and consulting built to last.</p>
                <ul class="social" role="list">
                    {site.socialLinks.map((link: SocialLink) => (
                        <li>
                            <a href={link.url} target="_blank" rel="noopener noreferrer">
                                <Icon name={link.icon} />
                                <span class="visually-hidden">{site.name} on {link.name} (opens in a new tab)</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>

            <nav class="footer-column" aria-labelledby="footer-products">
                <h2 id="footer-products">Products</h2>
                <ul role="list">
                    <li><a href="/Products/Aero">Aero</a></li>
                    {families.map((family: CollectionEntry<'productFamilies'>) => (
                        <li><a href={`/Products/#${family.id}`}>{family.data.name} libraries</a></li>
                    ))}
                </ul>
            </nav>

            <nav class="footer-column" aria-labelledby="footer-company">
                <h2 id="footer-company">Company</h2>
                <ul role="list">
                    <li><a href="/Consulting">Consulting</a></li>
                    <li><a href="/Documentation/">Documentation</a></li>
                    <li><a href="/Contact">Contact</a></li>
                </ul>
            </nav>

            <nav class="footer-column" aria-labelledby="footer-people">
                <h2 id="footer-people">People</h2>
                <ul role="list">
                    {contributors.map((contributor: CollectionEntry<'contributors'>) => (
                        <li><a href={contributor.data.path}>{contributor.data.name}</a></li>
                    ))}
                </ul>
            </nav>
        </div>

        <div class="footer-bottom">
            <p>&copy; {site.foundingYear}&ndash;{currentYear} {site.name}. All rights reserved.</p>
            <p class="footer-mark" aria-hidden="true"><span class="brand-rule"></span>Code that connects. Software that scales.</p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: auto;
        padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem) 2rem;
        border-top: 1px solid var(--border);
        background: var(--bg-alt);
        color: var(--text-muted);
        font-size: var(--text-xs);
        line-height: 1.5;
    }

    .site-footer .container {
        width: min(100% - 2 * var(--gutter), 64rem);
    }

    .footer-grid {
        display: grid;
        gap: 2rem;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    }

    .footer-brand {
        display: grid;
        gap: 1rem;
        align-content: start;
        grid-column: 1 / -1;
        max-width: 22rem;
    }

    @media (min-width: 56rem) {
        .footer-grid {
            grid-template-columns: 2fr repeat(3, 1fr);
        }

        .footer-brand {
            grid-column: auto;
        }
    }

    .footer-logo {
        width: auto;
        height: 1.1rem;
    }

    :global([data-theme='light']) .footer-logo-dark,
    :global([data-theme='dark']) .footer-logo-light {
        display: none;
    }

    .social {
        display: flex;
        gap: 0.25rem;
        margin-left: -0.5rem;
    }

    .social a {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        color: var(--text-muted);
        font-size: 0.95rem;
        transition: color var(--duration), background-color var(--duration);
    }

    .social a:hover {
        background: color-mix(in srgb, var(--heading) 8%, transparent);
        color: var(--heading);
    }

    .footer-column h2 {
        margin-bottom: 0.75rem;
        color: var(--heading);
        font-family: var(--font-body);
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0;
    }

    .footer-column ul {
        display: grid;
        gap: 0.6rem;
    }

    .footer-column a {
        color: var(--text-muted);
    }

    .footer-column a:hover {
        color: var(--heading);
    }

    .footer-bottom {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
    }

    .footer-mark {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
    }

    .footer-mark .brand-rule {
        width: 1.5rem;
        height: 2px;
    }
</style>
