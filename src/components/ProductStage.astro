---
import Icon from './Icon.astro';
import type { StageStatement } from './stage-statement';

// A capstone product's moment: the product shot pins in place and zooms to full size as the page scrolls, then
// short statements brighten one after another. Without scroll-driven animation support it's a static block.
interface Props {
    readonly statements?: ReadonlyArray<StageStatement>;
}

const { statements = [] }: Props = Astro.props;
---
<div class="product-stage">
    <div class="zoom-stage">
        <div class="zoom-sticky">
            <div class="stage-shot settle">
                <div class="zoom-target"><slot /></div>
            </div>
        </div>
    </div>
    {statements.length > 0 && (
        <ul class="stage-statements" role="list">
            {statements.map((statement: StageStatement) => (
                <li class="highlight"><Icon name={statement.icon} /> {statement.text}</li>
            ))}
        </ul>
    )}
</div>

<style>
    .stage-shot {
        width: min(100% - 2 * var(--gutter), 68rem);
        margin-inline: auto;
    }

    .stage-statements {
        display: grid;
        gap: 0.5rem;
        width: min(100% - 2 * var(--gutter), var(--container));
        margin: clamp(3rem, 2rem + 4vw, 6rem) auto 0;
        text-align: center;
    }

    .stage-statements li {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem 0.9rem;
        color: var(--heading);
        font-family: var(--font-display);
        font-size: var(--text-5xl);
        font-weight: 600;
        letter-spacing: -0.04em;
        line-height: 1.15;
    }

    @media (min-width: 48rem) {
        .stage-statements li {
            flex-direction: row;
        }
    }

    .stage-statements :global(.icon) {
        width: 0.6em;
        height: 0.6em;
        color: var(--brand-rose);
    }

    .stage-statements li:nth-child(2) :global(.icon) {
        color: var(--brand-violet);
    }

    .stage-statements li:nth-child(3) :global(.icon) {
        color: var(--brand-cyan);
    }
</style>
