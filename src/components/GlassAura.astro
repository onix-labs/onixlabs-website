---
import GlassIcon from './GlassIcon.astro';

// A glass icon spilling its own colour across whatever it sits on: its pre-rendered glow behind it (the icon blurred and
// saturated on a canvas 2.2 times its size, by scripts/generate-auras.ts), scaled up. Rendered ahead of time rather
// than with filter: blur(), which iOS Safari clips to the parent's box while an ancestor animates, and which costs the
// GPU every frame. The grain over the glow gives it texture and breaks up its bands, as on .window-light. The stacking
// context it sits in must clip it (a .tile does); size it with width on the class, and spread the glow with --aura-scale.
interface Props {
    readonly name: string;
    readonly size?: number;
    readonly class?: string;
}

const { name, size = 320, class: className = '' }: Props = Astro.props;
---
<span class:list={['glass-aura', className]}>
    <GlassIcon name={name} size={size} aura class="aura-glow" />
    <GlassIcon name={name} size={size} />
</span>

<style>
    .glass-aura {
        position: relative;
        display: grid;
    }

    /* Fades out with the glow, so it doesn't show on the plain page around it. The glow's canvas is 2.2 times the icon. */
    .glass-aura::after {
        content: '';
        position: absolute;
        inset: calc((2.2 * var(--aura-scale, 2.1) - 1) * -50%);
        z-index: -1;
        background: url('/onixlabs/images/noise-aura.png');
        -webkit-mask-image: radial-gradient(closest-side, #000 45%, transparent);
        mask-image: radial-gradient(closest-side, #000 45%, transparent);
        pointer-events: none;
    }

    .glass-aura :global(.glass-icon) {
        grid-area: 1 / 1;
        width: 100%;
    }

    /* The glow's canvas is 2.2 times the icon, so spread 60% past the icon on every side its icon lines up with the one
       in front; absolute, so it takes no room in the layout. */
    .glass-aura :global(.aura-glow) {
        position: absolute;
        inset: -60%;
        z-index: -1;
        width: auto;
        opacity: 0.95;
        transform: scale(var(--aura-scale, 2.1));
        pointer-events: none;
    }
</style>
