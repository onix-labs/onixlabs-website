---
// Runs before first paint so the page never flashes the wrong theme. It's inline (and therefore hashed into
// the CSP by Astro) because a bundled module script would run after the first render. Keep the storage key
// in sync with src/scripts/theme-storage-key.ts.
---
<script is:inline>
    (function () {
        var stored = null;
        try { stored = sessionStorage.getItem('theme-preference'); } catch (error) { stored = null; }
        var isDark = stored === 'dark' || (stored !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
    })();
</script>
