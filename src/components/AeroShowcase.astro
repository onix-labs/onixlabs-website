---
// The Aero product shot. On a near-black band (tone="dark") only the dark rendering is used; otherwise the image
// follows the site theme. It glows in its own colours, like the glass icons, so the band it sits in must clip it.
interface Props {
    readonly eager?: boolean;
    readonly tone?: 'auto' | 'dark';
    readonly class?: string;
}

const { eager = false, tone = 'auto', class: className = '' }: Props = Astro.props;
const alt: string =
    'The Aero logo on a central block, surrounded by six module blocks: Logging, Configuration, Data Access, Security & Cryptography, Digital Identity, and Distributed Mesh Networks';
---
<div class:list={['showcase', className]}>
    <span class="showcase-aura" aria-hidden="true">
        {tone === 'auto' && <img class="showcase-light" src="/onixlabs/images/marketing/aero-aura.webp" alt="" width={384} height={384} loading="lazy" decoding="async" />}
        <img
            class:list={{ 'showcase-dark': tone === 'auto' }}
            src="/onixlabs/images/marketing/aero-aura-dark.webp"
            alt=""
            width={384}
            height={384}
            loading="lazy"
            decoding="async"
        />
    </span>
    {tone === 'auto' && (
        <img
            class="showcase-image showcase-light"
            src="/onixlabs/images/marketing/aero.webp"
            alt={alt}
            width={1280}
            height={1280}
            loading={eager ? 'eager' : 'lazy'}
            fetchpriority={eager ? 'high' : 'auto'}
            decoding="async"
        />
    )}
    <img
        class:list={['showcase-image', { 'showcase-dark': tone === 'auto' }]}
        src="/onixlabs/images/marketing/aero-dark.webp"
        alt={alt}
        width={1280}
        height={1280}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        decoding="async"
    />
</div>

<style>
    .showcase {
        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        isolation: isolate;
    }

    /* The glass icons' aura (see GlassAura): the image's pre-rendered glow behind it, on a canvas 2.2 times the image, so
       it spills its own colours, each module's behind it. The grain over it breaks up its bands. */
    .showcase-image {
        grid-area: 1 / 1;
        width: 100%;
    }

    .showcase-aura {
        position: absolute;
        inset: -60%;
        z-index: -1;
        display: grid;
        width: auto;
        opacity: 0.95;
        transform: scale(1.15);
        pointer-events: none;
    }

    .showcase-aura img {
        grid-area: 1 / 1;
        align-self: center;
        width: 100%;
        height: auto;
    }

    .showcase::after {
        content: '';
        position: absolute;
        inset: -75%;
        z-index: -1;
        background: url('/onixlabs/images/noise-aura.png');
        -webkit-mask-image: radial-gradient(closest-side, #000 45%, transparent);
        mask-image: radial-gradient(closest-side, #000 45%, transparent);
        pointer-events: none;
    }

    .showcase-image {
        position: relative;
    }

    :global([data-theme='light']) .showcase-dark,
    :global([data-theme='dark']) .showcase-light {
        display: none;
    }
</style>
